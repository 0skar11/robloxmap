  <Item class="StarterPlayer" referent="35">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">0</token>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="36">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="38">
          <Properties>
            <string name="Name">Camera</string>
            <string name="Source"><![CDATA[-- Camera for every situation:
--   Lobby      third person, normal mouse
--   In game    first person, no cursor in the middle of the screen
--   Dead       third person, watching your living teammates until the whole group is dead
--              (then everyone respawns at level 1). Arrows or Q / E switch who you watch.
-- A screen that needs clicks (the tutorial) sets the local "UiOpen" attribute to show the cursor.
-- PC: Ctrl frees the mouse in first person (to click buttons), and locks it again.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "Spectate"
gui.ResetOnSpawn = false
gui.Enabled = false

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 70)
panel.Size = UDim2.fromOffset(460, 76)
panel.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
panel.BackgroundTransparency = 0.2
panel.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = panel

local function label(position: UDim2, size: UDim2, color: Color3): TextLabel
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Position = position
	text.Size = size
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.TextColor3 = color
	text.Parent = panel
	return text
end
local watching = label(UDim2.fromScale(0.14, 0.08), UDim2.fromScale(0.72, 0.5), Color3.fromRGB(230, 85, 75))
local hint = label(UDim2.fromScale(0.14, 0.6), UDim2.fromScale(0.72, 0.32), Color3.fromRGB(200, 200, 205))

local function arrow(text: string, x: number): TextButton
	local button = Instance.new("TextButton")
	button.Text = text
	button.Position = UDim2.fromScale(x, 0.15)
	button.Size = UDim2.fromScale(0.1, 0.7)
	button.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Font = Enum.Font.GothamBold
	button.TextScaled = true
	button.Parent = panel
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0, 8)
	round.Parent = button
	return button
end
local previous = arrow("<", 0.02)
local nextButton = arrow(">", 0.88)

gui.Parent = player:WaitForChild("PlayerGui")

local index = 1

local function teammates(): { Player }
	local key = player:GetAttribute("SessionKey")
	local list = {}
	for _, other in Players:GetPlayers() do
		local humanoid = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
		if other ~= player and other:GetAttribute("SessionKey") == key and humanoid and humanoid.Health > 0 then
			table.insert(list, other)
		end
	end
	return list
end

local THIRD_PERSON_ZOOM = 12

local thirdPerson = nil

local function setThirdPerson(enabled: boolean)
	if thirdPerson == enabled then
		return
	end
	thirdPerson = enabled
	if enabled then
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = 25
		-- Coming out of first person the camera sits inside the head; push it back out.
		player.CameraMinZoomDistance = THIRD_PERSON_ZOOM
		task.delay(0.1, function()
			if thirdPerson then
				player.CameraMinZoomDistance = 2
			end
		end)
	else
		player.CameraMinZoomDistance = 0.5
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end
end

-- Ctrl toggle. A visible Modal button is what Roblox uses to let the mouse out of first person,
-- so the toggle shows an invisible one.
local mouseFree = false
local freeGui = Instance.new("ScreenGui")
freeGui.Name = "MouseToggle"
freeGui.ResetOnSpawn = false
local freeButton = Instance.new("TextButton")
freeButton.Size = UDim2.fromOffset(1, 1)
freeButton.BackgroundTransparency = 1
freeButton.Text = ""
freeButton.Modal = true
freeButton.Visible = false
freeButton.Parent = freeGui
local freeHint = Instance.new("TextLabel")
freeHint.AnchorPoint = Vector2.new(0.5, 1)
freeHint.Position = UDim2.new(0.5, 0, 1, -110)
freeHint.Size = UDim2.fromOffset(260, 24)
freeHint.BackgroundTransparency = 1
freeHint.Font = Enum.Font.GothamBold
freeHint.TextScaled = true
freeHint.TextColor3 = Color3.fromRGB(230, 230, 230)
freeHint.TextStrokeTransparency = 0.5
freeHint.Text = "Mouse free  ·  Ctrl to lock"
freeHint.Visible = false
freeHint.Parent = freeGui
freeGui.Parent = player:WaitForChild("PlayerGui")

local function updateCursor()
	local freeInFirstPerson = mouseFree and not thirdPerson
	freeButton.Visible = freeInFirstPerson
	freeHint.Visible = freeInFirstPerson
	-- In first person the mouse is locked; hide its icon unless it is freed or a screen needs it.
	UserInputService.MouseIconEnabled = thirdPerson == true or freeInFirstPerson or player:GetAttribute("UiOpen") == true
end

UserInputService.InputBegan:Connect(function(input)
	if UserInputService:GetFocusedTextBox() then
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
		mouseFree = not mouseFree
		updateCursor()
	end
end)

local function refresh()
	local camera = Workspace.CurrentCamera
	local inLobby = player:GetAttribute("Phase") == "Lobby" or player:GetAttribute("Phase") == nil
	local dead = player:GetAttribute("Dead") == true and not inLobby
	gui.Enabled = dead

	if not dead then
		setThirdPerson(inLobby)
		updateCursor()
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
		return
	end

	setThirdPerson(true)
	updateCursor()
	local language = player:GetAttribute("Language")
	hint.Text = Strings.get(language, "SpectateHint")

	local list = teammates()
	if #list == 0 then
		watching.Text = Strings.get(language, "Spectating", "...")
		return
	end
	index = (index - 1) % #list + 1
	local target = list[index]
	watching.Text = Strings.get(language, "Spectating", target.DisplayName)
	local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

previous.Activated:Connect(function()
	index -= 1
	refresh()
end)
nextButton.Activated:Connect(function()
	index += 1
	refresh()
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not gui.Enabled then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q then
		index -= 1
		refresh()
	elseif input.KeyCode == Enum.KeyCode.E then
		index += 1
		refresh()
	end
end)

player:GetAttributeChangedSignal("Dead"):Connect(refresh)
player:GetAttributeChangedSignal("UiOpen"):Connect(updateCursor)
player:GetAttributeChangedSignal("Phase"):Connect(refresh)
player.CharacterAdded:Connect(function()
	task.wait()
	refresh()
end)

refresh()

-- Re-check now and then: the teammate you watch may die too, or the stations may change.
while true do
	task.wait(1)
	if gui.Enabled then
		refresh()
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="39">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- Player HUD.
--   Lobby (always English): a clear screen; on a gate, its status, and for the host: group size
--   1-10, language AR/EN, "Start now".
--   In game (the group's language): level and station counter, the rule, the live door vote,
--   "Back to lobby", the tutorial (level 1, and again when the dark half begins), messages, and
--   the black screen between stations.
-- All state comes from attributes on the local Player (see Shared/Net).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer
local event = Net.event()
local lobbyAction = Net.lobbyAction()

local YELLOW = Color3.fromRGB(240, 192, 24)
local GREEN = Color3.fromRGB(70, 200, 120)
local RED = Color3.fromRGB(230, 85, 75)
local PANEL = Color3.fromRGB(16, 16, 20)
local BUTTON = Color3.fromRGB(45, 45, 52)

local gui = Instance.new("ScreenGui")
gui.Name = "EndlessSubwayHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local function create(className: string, parent: Instance, props: { [string]: any }): any
	local instance = Instance.new(className)
	for key, value in props do
		(instance :: any)[key] = value
	end
	instance.Parent = parent
	return instance
end

local function rounded(instance: GuiObject, radius: number)
	create("UICorner", instance, { CornerRadius = UDim.new(0, radius) })
end

local function text(parent: Instance, name: string, props: { [string]: any }): TextLabel
	local label = create("TextLabel", parent, {
		Name = name,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
	})
	for key, value in props do
		(label :: any)[key] = value
	end
	return label
end

local function button(parent: Instance, name: string, props: { [string]: any }): TextButton
	local b = create("TextButton", parent, {
		Name = name,
		BackgroundColor3 = BUTTON,
		AutoButtonColor = true,
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
	})
	for key, value in props do
		(b :: any)[key] = value
	end
	rounded(b, 8)
	create("UIPadding", b, { PaddingTop = UDim.new(0.18, 0), PaddingBottom = UDim.new(0.18, 0) })
	return b
end

-- ===== In-game HUD =====

local gameHud = create("Frame", gui, { Name = "Game", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false })

local levelLabel = text(gameHud, "Level", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -20, 0, 70),
	Size = UDim2.fromOffset(340, 28),
	TextXAlignment = Enum.TextXAlignment.Right,
	TextColor3 = YELLOW,
})
local stationLabel = text(gameHud, "Station", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -20, 0, 100),
	Size = UDim2.fromOffset(340, 40),
	TextXAlignment = Enum.TextXAlignment.Right,
})
local checkpointLabel = text(gameHud, "Checkpoint", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -20, 0, 144),
	Size = UDim2.fromOffset(340, 22),
	TextXAlignment = Enum.TextXAlignment.Right,
	TextColor3 = GREEN,
})
local ruleLabel = text(gameHud, "Rule", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -20, 0, 170),
	Size = UDim2.fromOffset(460, 22),
	TextXAlignment = Enum.TextXAlignment.Right,
	TextColor3 = Color3.fromRGB(190, 190, 195),
})
local leaveButton = button(gameHud, "Leave", {
	Position = UDim2.fromOffset(20, 70),
	Size = UDim2.fromOffset(170, 38),
	BackgroundColor3 = Color3.fromRGB(60, 25, 25),
})

local votePanel = create("Frame", gameHud, {
	Name = "Vote",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(440, 70),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.25,
})
rounded(votePanel, 10)
local continueLabel = text(votePanel, "Continue", { Position = UDim2.fromScale(0.52, 0.1), Size = UDim2.fromScale(0.44, 0.45), TextColor3 = GREEN })
local backLabel = text(votePanel, "Back", { Position = UDim2.fromScale(0.04, 0.1), Size = UDim2.fromScale(0.44, 0.45), TextColor3 = RED })
local voteStatus = text(votePanel, "Status", { Position = UDim2.fromScale(0.04, 0.58), Size = UDim2.fromScale(0.92, 0.34), TextColor3 = Color3.fromRGB(210, 210, 215) })

-- ===== Lobby HUD (English) =====

local lobbyHud = create("Frame", gui, { Name = "Lobby", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })

-- Only shown when you step on a gate that is already full; otherwise the screen stays clear.
local lobbyHint = text(lobbyHud, "Hint", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -30),
	Size = UDim2.fromOffset(560, 30),
	TextColor3 = Color3.fromRGB(220, 220, 220),
	TextStrokeTransparency = 0.5,
	Text = "This gate is full. Try another one.",
	Visible = false,
})

local gatePanel = create("Frame", lobbyHud, {
	Name = "Gate",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(380, 230),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.15,
	Visible = false,
})
rounded(gatePanel, 12)
local gateTitle = text(gatePanel, "Title", { Position = UDim2.new(0, 16, 0, 12), Size = UDim2.new(1, -32, 0, 30), TextColor3 = YELLOW })
local gateStatus = text(gatePanel, "Status", { Position = UDim2.new(0, 16, 0, 46), Size = UDim2.new(1, -32, 0, 22), TextColor3 = Color3.fromRGB(200, 200, 205) })

local hostControls = create("Frame", gatePanel, { Name = "Host", Position = UDim2.new(0, 16, 0, 78), Size = UDim2.new(1, -32, 0, 140), BackgroundTransparency = 1 })
text(hostControls, "SizeLabel", { Size = UDim2.new(0.42, 0, 0, 34), Text = "Group size", TextXAlignment = Enum.TextXAlignment.Left })
local minus = button(hostControls, "Minus", { Position = UDim2.new(0.46, 0, 0, 0), Size = UDim2.new(0.16, 0, 0, 34), Text = "-" })
local sizeValue = text(hostControls, "Size", { Position = UDim2.new(0.64, 0, 0, 0), Size = UDim2.new(0.16, 0, 0, 34), Text = "4" })
local plus = button(hostControls, "Plus", { Position = UDim2.new(0.82, 0, 0, 0), Size = UDim2.new(0.18, 0, 0, 34), Text = "+" })

text(hostControls, "LanguageLabel", { Position = UDim2.new(0, 0, 0, 48), Size = UDim2.new(0.42, 0, 0, 34), Text = "Language", TextXAlignment = Enum.TextXAlignment.Left })
local arabic = button(hostControls, "Arabic", { Position = UDim2.new(0.46, 0, 0, 48), Size = UDim2.new(0.26, 0, 0, 34), Text = "العربية" })
local english = button(hostControls, "English", { Position = UDim2.new(0.74, 0, 0, 48), Size = UDim2.new(0.26, 0, 0, 34), Text = "English" })

local startButton = button(hostControls, "Start", {
	Position = UDim2.new(0, 0, 0, 96),
	Size = UDim2.new(1, 0, 0, 40),
	BackgroundColor3 = Color3.fromRGB(35, 120, 70),
	Text = "Start now",
})

-- ===== Messages and blackout =====

local messageLabel = text(gui, "Message", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.42),
	Size = UDim2.fromScale(0.7, 0.08),
	TextTransparency = 1,
	TextStrokeTransparency = 1,
	ZIndex = 3,
})

local blackout = create("Frame", gui, {
	Name = "Blackout",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BorderSizePixel = 0,
	BackgroundTransparency = if player:GetAttribute("Phase") == "Riding" then 0 else 1,
	ZIndex = 2,
})

-- ===== Tutorial =====

local tutorial = create("Frame", gui, {
	Name = "Tutorial",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(560, 330),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.08,
	Visible = false,
	ZIndex = 4,
})
rounded(tutorial, 14)
create("UIStroke", tutorial, { Color = YELLOW, Thickness = 2, Transparency = 0.3 })
local tutorialTitle = text(tutorial, "Title", { Position = UDim2.new(0, 24, 0, 18), Size = UDim2.new(1, -48, 0, 36), TextColor3 = YELLOW, ZIndex = 4 })
local tutorialBody = text(tutorial, "Body", {
	Position = UDim2.new(0, 24, 0, 66),
	Size = UDim2.new(1, -48, 0, 190),
	TextScaled = false,
	TextSize = 20,
	TextWrapped = true,
	TextYAlignment = Enum.TextYAlignment.Top,
	LineHeight = 1.15,
	Font = Enum.Font.Gotham,
	ZIndex = 4,
})
local tutorialOk = button(tutorial, "Ok", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -18),
	Size = UDim2.fromOffset(200, 44),
	BackgroundColor3 = Color3.fromRGB(35, 120, 70),
	ZIndex = 4,
	-- In first person the mouse is locked; a visible Modal button frees it so it can be clicked.
	Modal = true,
})

gui.Parent = player:WaitForChild("PlayerGui")

-- ===== Refresh =====

local function attr(name: string, default: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local tutorialsSeen: { [string]: boolean } = {}

local function closeTutorial()
	tutorial.Visible = false
	player:SetAttribute("UiOpen", false)
end

local function refresh()
	local phase = attr("Phase", "Lobby")
	local inGame = phase ~= "Lobby"
	gameHud.Visible = inGame
	lobbyHud.Visible = not inGame

	if inGame then
		local language = attr("Language", "en")
		local function t(key: string, ...: any): string
			return Strings.get(language, key, ...)
		end

		levelLabel.Text = t(if attr("Mood", "Calm") == "Horror" then "PhaseHorror" else "PhaseCalm")
		stationLabel.Text = t("HudLevel", attr("Level", 1), attr("TotalLevels", Config.TotalLevels))
		local checkpoint = attr("Checkpoint", 0)
		checkpointLabel.Visible = checkpoint > 0
		checkpointLabel.Text = t("HudCheckpoint", checkpoint)
		local backDoor = attr("BackDoor", true)
		ruleLabel.Text = t(if backDoor then "Rule" else "RuleFirst")
		leaveButton.Text = if UserInputService.TouchEnabled then t("LeaveRun") else t("LeaveRun") .. "  [L]"

		-- Dead players spectate instead of voting.
		votePanel.Visible = phase == "Station" and not attr("Dead", false)
		local continueVotes, backVotes = attr("VotesContinue", 0), attr("VotesBack", 0)
		local voters, countdown = attr("Voters", 0), attr("VoteCountdown", -1)
		continueLabel.Text = t("VoteContinue", continueVotes)
		backLabel.Text = t("VoteBack", backVotes)
		backLabel.Visible = backDoor
		continueLabel.Position = if backDoor then UDim2.fromScale(0.52, 0.1) else UDim2.fromScale(0.28, 0.1)
		if attr("VoteTie", false) then
			voteStatus.Text = t("VoteTie")
		elseif countdown >= 0 then
			voteStatus.Text = t("VoteCountdown", countdown)
		elseif continueVotes + backVotes == 0 then
			voteStatus.Text = t("VoteStandAtDoor")
		else
			voteStatus.Text = t("VoteWaiting", continueVotes + backVotes, voters)
		end

		-- Each tutorial shows once per game: on level 1, and when the dark half begins.
		if phase == "Station" and not attr("Dead", false) then
			local level = attr("Level", 1)
			local which = if level == 1 then "Calm" elseif level == Config.HorrorStartsAtLevel then "Horror" else nil
			local key = which and (tostring(attr("SessionKey", "")) .. which)
			if key and not tutorialsSeen[key] then
				tutorialsSeen[key] = true
				tutorialTitle.Text = t(if which == "Calm" then "TutorialTitle" else "TutorialHorrorTitle")
				tutorialBody.Text = t(if which == "Calm" then "TutorialBody" else "TutorialHorrorBody")
				tutorialOk.Text = t("TutorialOk")
				local alignment = if language == "ar" then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
				tutorialTitle.TextXAlignment = alignment
				tutorialBody.TextXAlignment = alignment
				tutorial.Visible = true
				player:SetAttribute("UiOpen", true)
			end
		elseif phase ~= "Station" and tutorial.Visible then
			closeTutorial()
		end
		return
	end
	if tutorial.Visible then
		closeTutorial()
	end

	local pad = attr("Pad", 0)
	local onGate = pad > 0
	gatePanel.Visible = onGate
	lobbyHint.Visible = attr("PadFull", false) and not onGate
	if not onGate then
		return
	end

	local count, size = attr("PadCount", 0), attr("PadMax", Config.DefaultPartySize)
	local language = attr("PadLanguage", "en")
	local countdown = attr("PadCountdown", -1)
	local isHost = attr("PadHost", false)

	gateTitle.Text = string.format("GATE %d  ·  %d / %d players", pad, count, size)
	if countdown >= 0 then
		gateStatus.Text = string.format("The train leaves in %d...", countdown)
	elseif isHost then
		gateStatus.Text = "You are the host. Pick the size and language."
	else
		gateStatus.Text = string.format("Waiting for the host  ·  %s", if language == "ar" then "Arabic" else "English")
	end

	hostControls.Visible = isHost
	gatePanel.Size = UDim2.fromOffset(380, if isHost then 230 else 84)
	sizeValue.Text = tostring(size)
	arabic.BackgroundColor3 = if language == "ar" then YELLOW else BUTTON
	arabic.TextColor3 = if language == "ar" then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
	english.BackgroundColor3 = if language == "en" then YELLOW else BUTTON
	english.TextColor3 = if language == "en" then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
end

player.AttributeChanged:Connect(refresh)
refresh()

minus.Activated:Connect(function()
	lobbyAction:FireServer("SetPartySize", attr("PadMax", Config.DefaultPartySize) - 1)
end)
plus.Activated:Connect(function()
	lobbyAction:FireServer("SetPartySize", attr("PadMax", Config.DefaultPartySize) + 1)
end)
arabic.Activated:Connect(function()
	lobbyAction:FireServer("SetLanguage", "ar")
end)
english.Activated:Connect(function()
	lobbyAction:FireServer("SetLanguage", "en")
end)
startButton.Activated:Connect(function()
	lobbyAction:FireServer("StartNow")
end)
tutorialOk.Activated:Connect(closeTutorial)
leaveButton.Activated:Connect(function()
	lobbyAction:FireServer("LeaveRun")
end)



-- ===== Server moments =====

local messageToken = 0
local function showMessage(body: string, duration: number)
	messageToken += 1
	local token = messageToken
	messageLabel.Text = body
	TweenService:Create(messageLabel, TweenInfo.new(0.3), { TextTransparency = 0, TextStrokeTransparency = 0.5 }):Play()
	task.delay(duration, function()
		if token == messageToken then
			TweenService:Create(messageLabel, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

event.OnClientEvent:Connect(function(payload)
	if payload.Kind == "Fade" then
		local goal = if payload.Visible then 0 else 1
		TweenService:Create(blackout, TweenInfo.new(payload.Duration or 1), { BackgroundTransparency = goal }):Play()
	elseif payload.Kind == "Message" then
		showMessage(payload.Text, payload.Duration or 3)
	end
end)

-- First person locks the mouse on PC, so leaving also works from the keyboard: press L twice.
local leaveArmedUntil = 0
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.KeyCode ~= Enum.KeyCode.L or attr("Phase", "Lobby") == "Lobby" then
		return
	end
	if os.clock() < leaveArmedUntil then
		leaveArmedUntil = 0
		lobbyAction:FireServer("LeaveRun")
	else
		leaveArmedUntil = os.clock() + 2
		showMessage(Strings.get(attr("Language", "en"), "LeaveConfirm"), 2)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="40">
          <Properties>
            <string name="Name">Mood</string>
            <string name="Source"><![CDATA[-- Local look of the world, from the player's "Mood" attribute:
--   Lobby   bright, warm hall
--   Calm    levels 1-5: a normal, bright, slightly cheerful station
--   Horror  level 6 on: dark, foggy and gloomy (colors drained to grey-green), with a dim
--           personal light so you can still see
-- Lighting changes made here only affect this player, so groups never fight over the look.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local TWEEN = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

local LOOKS = {
	Lobby = {
		Lighting = { Ambient = Color3.fromRGB(88, 86, 83), OutdoorAmbient = Color3.fromRGB(64, 64, 64), ExposureCompensation = 0.1 },
		SubwayAir = { Density = 0.08, Haze = 0, Color = Color3.fromRGB(200, 195, 185), Decay = Color3.fromRGB(150, 145, 135) },
		SubwayGrade = { Brightness = 0.02, Contrast = 0.05, Saturation = 0.1, TintColor = Color3.fromRGB(255, 250, 242) },
		SubwayBloom = { Intensity = 0.4, Size = 24, Threshold = 1.6 },
		PersonalLight = false,
	},
	Calm = {
		Lighting = { Ambient = Color3.fromRGB(95, 93, 88), OutdoorAmbient = Color3.fromRGB(64, 64, 64), ExposureCompensation = 0.15 },
		SubwayAir = { Density = 0.1, Haze = 0, Color = Color3.fromRGB(205, 200, 190), Decay = Color3.fromRGB(160, 155, 145) },
		SubwayGrade = { Brightness = 0.03, Contrast = 0.06, Saturation = 0.2, TintColor = Color3.fromRGB(255, 248, 236) },
		SubwayBloom = { Intensity = 0.5, Size = 24, Threshold = 1.5 },
		PersonalLight = false,
	},
	Horror = {
		Lighting = { Ambient = Color3.fromRGB(34, 34, 41), OutdoorAmbient = Color3.fromRGB(8, 8, 10), ExposureCompensation = -0.05 },
		SubwayAir = { Density = 0.32, Haze = 1.6, Color = Color3.fromRGB(22, 22, 28), Decay = Color3.fromRGB(12, 12, 15) },
		-- Gloomy: colors drained almost to grey, with a cold, sickly green-grey cast.
		SubwayGrade = { Brightness = -0.04, Contrast = 0.22, Saturation = -0.7, TintColor = Color3.fromRGB(205, 215, 205) },
		SubwayBloom = { Intensity = 0.8, Size = 30, Threshold = 1.3 },
		PersonalLight = true,
	},
}

local personalLight: PointLight? = nil

local function updatePersonalLight(enabled: boolean)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local light = personalLight
	if not light or light.Parent ~= root then
		light = Instance.new("PointLight")
		light.Name = "PersonalLight"
		light.Color = Color3.fromRGB(200, 210, 230)
		light.Range = 14
		light.Brightness = 0.7
		light.Shadows = false
		light.Parent = root
		personalLight = light
	end
	light.Enabled = enabled
end

local function apply()
	local look = LOOKS[player:GetAttribute("Mood") or "Lobby"] or LOOKS.Lobby
	TweenService:Create(Lighting, TWEEN, look.Lighting):Play()
	for name, goal in look do
		local instance = Lighting:FindFirstChild(name)
		if instance and type(goal) == "table" then
			TweenService:Create(instance, TWEEN, goal):Play()
		end
	end
	updatePersonalLight(look.PersonalLight)
end

player:GetAttributeChangedSignal("Mood"):Connect(apply)
player.CharacterAdded:Connect(function(character)
	character:WaitForChild("HumanoidRootPart", 10)
	apply()
end)
-- The effects are created by the server; wait for them before the first look.
Lighting:WaitForChild("SubwayAir", 10)
Lighting:WaitForChild("SubwayGrade", 10)
Lighting:WaitForChild("SubwayBloom", 10)
apply()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="41">
          <Properties>
            <string name="Name">Sprint</string>
            <string name="Source"><![CDATA[-- Sprinting. PC: hold Shift. Mobile: a button on screen toggles between sprint and walk.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer

local shiftHeld = false
local toggledOn = false

local function language()
	return if player:GetAttribute("Phase") == "Lobby" then "en" else player:GetAttribute("Language")
end

local function apply()
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = if shiftHeld or toggledOn then Config.SprintSpeed else Config.WalkSpeed
	end
end

UserInputService.InputBegan:Connect(function(input)
	-- Shift can arrive marked as "processed" by Roblox's own controls, so only skip typing.
	if UserInputService:GetFocusedTextBox() then
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		shiftHeld = true
		apply()
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		shiftHeld = false
		apply()
	end
end)
player.CharacterAdded:Connect(function(character)
	character:WaitForChild("Humanoid", 10)
	apply()
end)

-- Mobile button, just above the jump button.
if UserInputService.TouchEnabled then
	local gui = Instance.new("ScreenGui")
	gui.Name = "SprintButton"
	gui.ResetOnSpawn = false

	local button = Instance.new("TextButton")
	button.AnchorPoint = Vector2.new(1, 1)
	button.Position = UDim2.new(1, -30, 1, -170)
	button.Size = UDim2.fromOffset(84, 84)
	button.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
	button.BackgroundTransparency = 0.3
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Font = Enum.Font.GothamBold
	button.TextScaled = true
	button.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = button
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.15, 0)
	padding.PaddingRight = UDim.new(0.15, 0)
	padding.Parent = button

	local function refresh()
		-- The button shows what tapping it will do.
		button.Text = Strings.get(language(), if toggledOn then "Walk" else "Sprint")
		button.BackgroundColor3 = if toggledOn then Color3.fromRGB(200, 150, 20) else Color3.fromRGB(30, 30, 36)
	end

	button.Activated:Connect(function()
		toggledOn = not toggledOn
		refresh()
		apply()
	end)
	player:GetAttributeChangedSignal("Language"):Connect(refresh)
	player:GetAttributeChangedSignal("Phase"):Connect(refresh)
	refresh()
	gui.Parent = player:WaitForChild("PlayerGui")
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>