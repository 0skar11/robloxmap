        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">ExtraMissedCall</string>
            <string name="Source"><![CDATA[-- The phone on the floor now shows 13 missed calls instead of 12.
return {
	Name = "ExtraMissedCall",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		ctx:Set(ctx.Refs.PhoneLabel, "Text", ctx:Text("MissedCalls", 13))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">ExtraPassenger</string>
            <string name="Source"><![CDATA[-- Someone new is on the platform: a faceless figure standing with their face to the wall.
local Mannequin = require(script.Parent.Parent.Mannequin)

local SPOTS = {
	{ X = -85, Z = -8.5 },
	{ X = 85, Z = -8.5 },
	{ X = -24, Z = -8.5 },
	{ X = 22, Z = 6 },
	{ X = -56, Z = 6 },
}

return {
	Name = "ExtraPassenger",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		local spot = ctx:Pick(SPOTS)
		-- Facing -Z means facing the back wall.
		local pivot = ctx.Refs.At(spot.X, 3, spot.Z)
		ctx:Add(Mannequin.create("Stranger", "Stand", pivot, Color3.fromRGB(20, 20, 22)))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">FlickeringLight</string>
            <string name="Source"><![CDATA[-- One ceiling light keeps flickering.
return {
	Name = "FlickeringLight",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		-- Only a light that is still working can flicker.
		local working = {}
		for _, candidate in ctx.Refs.Lights do
			local surfaceLight = candidate:FindFirstChildOfClass("SurfaceLight")
			if surfaceLight and surfaceLight.Enabled then
				table.insert(working, candidate)
			end
		end
		local fixture = ctx:Pick(working)
		local light = fixture:FindFirstChildOfClass("SurfaceLight")

		-- Record the originals first so Restore turns the light back on.
		ctx:Set(fixture, "Material", fixture.Material)
		ctx:Set(light, "Enabled", true)

		ctx:Spawn(function()
			while true do
				local on = ctx.Random:NextNumber() > 0.35
				light.Enabled = on
				fixture.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
				task.wait(ctx.Random:NextNumber(0.05, 0.4))
			end
		end)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">MissingPassenger</string>
            <string name="Source"><![CDATA[-- One of the passengers is gone. They are made invisible rather than removed, so a seated
-- avatar keeps its pose when it comes back.
return {
	Name = "MissingPassenger",
	Apply = function(ctx)
		local passenger = ctx:Pick(ctx.Refs.Passengers)
		for _, descendant in passenger:GetDescendants() do
			if descendant:IsA("BasePart") then
				ctx:Set(descendant, "Transparency", 1)
				ctx:Set(descendant, "CanCollide", false)
				ctx:Set(descendant, "CastShadow", false)
			elseif descendant:IsA("Decal") then
				ctx:Set(descendant, "Transparency", 1)
			elseif descendant:IsA("SurfaceGui") then
				ctx:Set(descendant, "Enabled", false)
			end
		end
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MissingPillar</string>
            <string name="Source"><![CDATA[-- One of the pillars is missing. The middle one stays: the flowers lean on it.
return {
	Name = "MissingPillar",
	Apply = function(ctx)
		local candidates = {}
		for _, pillar in ctx.Refs.Pillars do
			if pillar:GetAttribute("X") ~= 0 then
				table.insert(candidates, pillar)
			end
		end
		ctx:Set(ctx:Pick(candidates), "Parent", nil)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">NamedPoster</string>
            <string name="Source"><![CDATA[-- An advertisement now carries one of the players' names.
return {
	Name = "NamedPoster",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		local name = if #ctx.Players > 0 then ctx:Pick(ctx.Players).DisplayName else "???"
		ctx:Set(ctx:Pick(ctx.Refs.Posters), "Text", ctx:Text("NamedPoster", name))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">StaringPassengers</string>
            <string name="Source"><![CDATA[-- Every passenger slowly turns their head to follow the nearest player.
local RunService = game:GetService("RunService")

local TURN_SPEED = 3
local MAX_TURN = math.rad(75)

local function nearestHead(players: { Player }, position: Vector3): Vector3?
	local best, bestDistance = nil, math.huge
	for _, player in players do
		local head = player.Character and player.Character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			local distance = (head.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = head.Position, distance
			end
		end
	end
	return best
end

return {
	Name = "StaringPassengers",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		-- Avatars turn their neck joint; block mannequins turn the head part itself.
		local necks, heads = {}, {}
		for _, passenger in ctx.Refs.Passengers do
			local head = passenger:FindFirstChild("Head", true)
			local neck = head and head:FindFirstChild("Neck")
			if neck and neck:IsA("Motor6D") and neck.Part0 then
				ctx:Set(neck, "C0", neck.C0)
				table.insert(necks, { Joint = neck, Rest = neck.C0, Yaw = 0 })
			elseif head and head:IsA("BasePart") then
				ctx:Set(head, "CFrame", head.CFrame)
				table.insert(heads, head)
			end
		end

		ctx:Connect(RunService.Heartbeat, function(dt: number)
			local blend = math.min(1, dt * TURN_SPEED)
			for _, neck in necks do
				local target = nearestHead(ctx.Players, neck.Joint.Part1.Position)
				if target then
					local relative = neck.Joint.Part0.CFrame:PointToObjectSpace(target)
					local goal = math.clamp(math.atan2(-relative.X, -relative.Z), -MAX_TURN, MAX_TURN)
					neck.Yaw += (goal - neck.Yaw) * blend
					neck.Joint.C0 = neck.Rest * CFrame.Angles(0, neck.Yaw, 0)
				end
			end
			for _, head in heads do
				local target = nearestHead(ctx.Players, head.Position)
				if target then
					head.CFrame = head.CFrame:Lerp(CFrame.lookAt(head.Position, target), blend)
				end
			end
		end)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">StoppedClock</string>
            <string name="Source"><![CDATA[-- The station clock is stuck on the time the train arrives and never ticks.
return {
	Name = "StoppedClock",
	Apply = function(ctx)
		ctx:SetAttribute(ctx.Refs.Clock, "Frozen", true)
		ctx:Set(ctx.Refs.ClockLabel, "Text", "23:57:00")
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">TheFollower</string>
            <string name="Source"><![CDATA[-- A faceless figure steps out at the far end of the platform and slowly walks toward the nearest
-- living player. If it reaches you, you die (and spectate until your group is gone). It is slower
-- than walking, so you can always get away; the safe answer is to GO BACK.
local RunService = game:GetService("RunService")

local Mannequin = require(script.Parent.Parent.Mannequin)

local SPEED = 7
local REACH = 3
local SPOTS = { -88, 88 }

local function nearestRoot(players: { Player }, position: Vector3): BasePart?
	local best, bestDistance = nil, math.huge
	for _, player in players do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
			local distance = (root.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = root, distance
			end
		end
	end
	return best
end

return {
	Name = "TheFollower",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		local x = ctx:Pick(SPOTS)
		local start = ctx.Refs.At(x, 3, 0)
		local follower = Mannequin.create("Follower", "Stand", start, Color3.fromRGB(12, 12, 14)) :: Model
		for _, part in follower:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
		ctx:Add(follower)

		-- Stays on the platform floor (Y fixed, Z clamped to the platform).
		local floorY = start.Position.Y
		local minZ = ctx.Refs.At(0, 0, -8).Position.Z
		local maxZ = ctx.Refs.At(0, 0, 9).Position.Z

		-- Waits a few seconds before it starts walking, so players can see it first.
		local wakeAt = os.clock() + 4
		ctx:Connect(RunService.Heartbeat, function(dt: number)
			if os.clock() < wakeAt then
				return
			end
			local here = follower:GetPivot().Position
			local target = nearestRoot(ctx.Players, here)
			if not target then
				return
			end

			local flat = Vector3.new(target.Position.X, floorY, target.Position.Z)
			local offset = flat - here
			if offset.Magnitude <= REACH then
				local humanoid = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.Health = 0
				end
				return
			end

			local step = offset.Unit * math.min(offset.Magnitude, SPEED * dt)
			local nextPosition = here + step
			nextPosition = Vector3.new(nextPosition.X, floorY, math.clamp(nextPosition.Z, minZ, maxZ))
			follower:PivotTo(CFrame.lookAt(nextPosition, Vector3.new(flat.X, floorY, flat.Z)))
		end)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">TurnedBench</string>
            <string name="Source"><![CDATA[-- The empty bench has been turned to face the wall.
return {
	Name = "TurnedBench",
	Apply = function(ctx)
		local candidates = {}
		for _, bench in ctx.Refs.Benches do
			if bench:GetAttribute("Free") then
				table.insert(candidates, bench)
			end
		end
		local bench = ctx:Pick(candidates)
		ctx:Pivot(bench, bench:GetPivot() * CFrame.Angles(0, math.pi, 0))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">WrongLineNumber</string>
            <string name="Source"><![CDATA[-- The line badge reads 41 instead of 14.
return {
	Name = "WrongLineNumber",
	Apply = function(ctx)
		ctx:Set(ctx.Refs.LineBadge, "Text", "41")
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">AnomalyContext</string>
          <string name="Source"><![CDATA[-- Handed to an anomaly's Apply and Reset. Every change made through it is recorded, so
-- ctx:Restore() puts the station back exactly as it was, whatever the anomaly did.
--
--   ctx.Refs        everything MapBuilder.build() returned (lights, posters, passengers, ...)
--   ctx.Players     the group's players when the station started
--   ctx.Random      a Random object, so a station can be replayed from its seed
--
--   ctx:Set(instance, property, value)       change a property (Parent = nil hides something)
--   ctx:SetAttribute(instance, name, value)  change an attribute
--   ctx:Pivot(model, cframe)                 move a model
--   ctx:Add(instance, parent?)               add something new; destroyed on restore
--   ctx:Connect(signal, callback)            disconnected on restore
--   ctx:Spawn(callback)                      a thread that is cancelled on restore
--   ctx:Pick(list)                           random element of a list
--   ctx:Text(key, ...)                       text in the group's language (see Shared/Strings)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Strings = require(ReplicatedStorage.Shared.Strings)

local AnomalyContext = {}
AnomalyContext.__index = AnomalyContext

export type Context = typeof(setmetatable(
	{} :: {
		Refs: any,
		Players: { Player },
		Random: Random,
		_undo: { () -> () },
	},
	AnomalyContext
))

function AnomalyContext.new(refs: any, players: { Player }, random: Random): Context
	return setmetatable({
		Refs = refs,
		Players = players,
		Random = random,
		_undo = {},
	}, AnomalyContext)
end

function AnomalyContext.Set(self: Context, instance: Instance, property: string, value: any)
	local target = instance :: any
	local original = target[property]
	table.insert(self._undo, function()
		target[property] = original
	end)
	target[property] = value
end

function AnomalyContext.SetAttribute(self: Context, instance: Instance, name: string, value: any)
	local original = instance:GetAttribute(name)
	table.insert(self._undo, function()
		instance:SetAttribute(name, original)
	end)
	instance:SetAttribute(name, value)
end

function AnomalyContext.Pivot(self: Context, model: PVInstance, cframe: CFrame)
	local original = model:GetPivot()
	table.insert(self._undo, function()
		model:PivotTo(original)
	end)
	model:PivotTo(cframe)
end

function AnomalyContext.Add(self: Context, instance: Instance, parent: Instance?): Instance
	table.insert(self._undo, function()
		instance:Destroy()
	end)
	instance.Parent = parent or self.Refs.Station
	return instance
end

function AnomalyContext.Connect(self: Context, signal: RBXScriptSignal, callback: (...any) -> ()): RBXScriptConnection
	local connection = signal:Connect(callback)
	table.insert(self._undo, function()
		connection:Disconnect()
	end)
	return connection
end

function AnomalyContext.Spawn(self: Context, callback: () -> ()): thread
	local thread = task.spawn(callback)
	table.insert(self._undo, function()
		if coroutine.status(thread) ~= "dead" then
			task.cancel(thread)
		end
	end)
	return thread
end

function AnomalyContext.Pick<T>(self: Context, list: { T }): T
	return list[self.Random:NextInteger(1, #list)]
end

function AnomalyContext.Text(self: Context, key: string, ...: any): string
	return Strings.get(self.Refs.Language, key, ...)
end

-- Undoes everything in reverse order, so stacked changes to one property unwind correctly.
function AnomalyContext.Restore(self: Context)
	for i = #self._undo, 1, -1 do
		local ok, err = pcall(self._undo[i])
		if not ok then
			warn("[EndlessSubway] restore step failed:", err)
		end
	end
	table.clear(self._undo)
end

return AnomalyContext
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">AnomalyRegistry</string>
          <string name="Source"><![CDATA[-- Loads every ModuleScript in the Anomalies folder. To add an anomaly, drop a new module there:
--
--   return {
--       Name = "MyAnomaly",
--       Horror = true,  -- optional: only from Config.HorrorStartsAtLevel on
--       Apply = function(ctx) ctx:Set(ctx.Refs.LineBadge, "Text", "41") end,
--       Reset = function(ctx) ctx:Restore() end,
--   }

export type Anomaly = {
	Name: string,
	Horror: boolean?, -- true: only in the dark half of the game
	Apply: (ctx: any) -> (),
	Reset: (ctx: any) -> (),
}

local AnomalyRegistry = {}

function AnomalyRegistry.load(): { Anomaly }
	local anomalies = {}
	for _, module in script.Parent.Anomalies:GetChildren() do
		if not module:IsA("ModuleScript") then
			continue
		end

		local ok, anomaly = pcall(require, module)
		if not ok or type(anomaly) ~= "table" or type(anomaly.Apply) ~= "function" then
			warn("[EndlessSubway] skipping anomaly", module.Name, if ok then "(no Apply function)" else anomaly)
			continue
		end

		anomaly.Name = anomaly.Name or module.Name
		anomaly.Reset = anomaly.Reset or function(ctx)
			ctx:Restore()
		end
		table.insert(anomalies, anomaly)
	end

	table.sort(anomalies, function(a, b)
		return a.Name < b.Name
	end)
	return anomalies
end

return AnomalyRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[-- Small helpers for building maps out of plain anchored parts.

local Build = {}

function Build.block(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

function Build.invisibleWall(parent: Instance, name: string, size: Vector3, cframe: CFrame): Part
	local part = Build.block(parent, name, size, cframe, Color3.new(0, 0, 0))
	part.Transparency = 1
	part.CastShadow = false
	return part
end

export type TextOptions = {
	Background: Color3?,
	TextColor: Color3?,
	Glow: boolean?,
	PixelsPerStud: number?,
}

-- Puts a scaled TextLabel on one face of a part and returns the label.
function Build.surfaceText(target: BasePart, face: Enum.NormalId, text: string, options: TextOptions?): TextLabel
	local opts: TextOptions = options or {}

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Display"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.PixelsPerStud or 40
	gui.LightInfluence = if opts.Glow then 0 else 1
	gui.Parent = target

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = opts.Background or Color3.new(1, 1, 1)
	label.BackgroundTransparency = if opts.Background then 0 else 1
	label.BorderSizePixel = 0
	label.TextColor3 = opts.TextColor or Color3.new(1, 1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = text
	label.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label

	return label
end

-- A ceiling fixture: a thin neon strip with a light shining down.
function Build.ceilingLight(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, brightness: number, range: number): Part
	local fixture = Build.block(parent, name, size, cframe, color, Enum.Material.Neon)
	fixture.CastShadow = false
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = range
	light.Angle = 120
	light.Color = color
	light.Brightness = brightness
	light.Shadows = true
	light.Parent = fixture
	return fixture
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">GameLoop</string>
          <string name="Source"><![CDATA[-- One group's game: the train stops, the players look around, they vote on a door, the screen goes
-- dark, and the same station comes back one level further (or not).
--
-- Rule: a normal station means "Continue"; a station with something wrong means "Back".
--   Right call  -> next level.
--   Wrong call  -> back to the level after the last checkpoint (level 1 before any checkpoint).
--   Everyone dead -> everyone respawns at level 1.
-- Levels 1-5 are the bright, calm station; from Config.HorrorStartsAtLevel the lights die and the
-- hints appear.
--
-- run() returns when the group is gone or has reached the end; SessionManager cleans up.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Strings = require(ReplicatedStorage.Shared.Strings)
local AnomalyContext = require(script.Parent.AnomalyContext)
local AnomalyRegistry = require(script.Parent.AnomalyRegistry)
local VoteManager = require(script.Parent.VoteManager)

local CLOCK_START_SECONDS = 23 * 3600 + 57 * 60
local DOOR_TWEEN = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
local DEAD_LIGHT = Color3.fromRGB(60, 60, 58)

local GameLoop = {}

local function setDoors(refs, open: boolean)
	for _, panel in refs.DoorPanels do
		TweenService:Create(panel.Part, DOOR_TWEEN, { CFrame = if open then panel.Open else panel.Closed }):Play()
	end
end

local function moodOf(level: number): "Calm" | "Horror"
	return if level >= Config.HorrorStartsAtLevel then "Horror" else "Calm"
end

-- Calm: every light on and no hints. Horror: some lights die and the hints appear.
local function applyMood(refs, mood: "Calm" | "Horror")
	local look = Config.Moods[mood]
	for _, fixture in refs.Lights do
		local on = mood == "Calm" or not fixture:GetAttribute("DiesInHorror")
		fixture.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		fixture.Color = if on then look.LightColor else DEAD_LIGHT
		local light = fixture:FindFirstChildOfClass("SurfaceLight")
		if light then
			light.Enabled = on
			light.Color = look.LightColor
			light.Brightness = look.LightBrightness
		end
	end
	for _, hint in refs.Hints do
		hint.Parent = if mood == "Horror" then refs.Station else nil
	end
end

-- Ticks the station clock from 23:57:00 every time the train stops, unless an anomaly froze it.
local function runClock(refs, stationStartedAt: () -> number)
	task.spawn(function()
		while refs.Map.Parent do
			if not refs.Clock:GetAttribute("Frozen") then
				local seconds = CLOCK_START_SECONDS + math.floor(os.clock() - stationStartedAt())
				refs.ClockLabel.Text = string.format("%02d:%02d:%02d", seconds // 3600 % 24, seconds // 60 % 60, seconds % 60)
			end
			task.wait(0.25)
		end
	end)
end

function GameLoop.run(session)
	local refs = session.Refs
	local language = session.Language
	local event = Net.event()
	local anomalies = AnomalyRegistry.load()
	local random = Random.new()

	local level = 1
	local checkpoint = 0
	local mood = moodOf(level)
	local lastAnomaly = nil
	local stationStartedAt = os.clock()

	local function text(key: string, ...: any): string
		return Strings.get(language, key, ...)
	end

	local function members(): { Player }
		return session.GetMembers()
	end

	local function setAll(name: string, value: any)
		for _, player in members() do
			player:SetAttribute(name, value)
		end
	end

	local function publishState(phase: string)
		setAll("Phase", phase)
		setAll("Mood", mood)
		setAll("Level", level)
		setAll("TotalLevels", Config.TotalLevels)
		setAll("Checkpoint", checkpoint)
		refs.CounterLabel.Text = text("Counter", level, Config.TotalLevels)
	end

	local function publishVote(continueVotes: number, backVotes: number, voters: number, countdown: number, tie: boolean)
		setAll("VotesContinue", continueVotes)
		setAll("VotesBack", backVotes)
		setAll("Voters", voters)
		setAll("VoteCountdown", countdown)
		setAll("VoteTie", tie)
	end

	local function fire(payload)
		for _, player in members() do
			event:FireClient(player, payload)
		end
	end

	local function message(body: string, duration: number?)
		fire({ Kind = "Message", Text = body, Duration = duration or 3 })
	end

	local function fade(visible: boolean)
		fire({ Kind = "Fade", Visible = visible, Duration = Config.FadeSeconds })
		task.wait(Config.FadeSeconds)
	end

	local function boardTrain()
		for i, player in session.GetAlive() do
			player.Character:PivotTo(refs.StandPoints[(i - 1) % #refs.StandPoints + 1])
		end
	end

	local function pickAnomaly()
		if table.find(Config.AlwaysNormalLevels, level) or #anomalies == 0 then
			return nil
		end
		if mood == "Calm" and not Config.CalmAnomalies then
			return nil
		end
		if random:NextNumber() >= Config.AnomalyChance then
			return nil
		end
		-- Calm levels only use the mild anomalies. Never the same one twice in a row.
		local pool = {}
		for _, anomaly in anomalies do
			if (mood == "Horror" or not anomaly.Horror) and anomaly ~= lastAnomaly then
				table.insert(pool, anomaly)
			end
		end
		if #pool == 0 then
			return nil
		end
		return pool[random:NextInteger(1, #pool)]
	end

	runClock(refs, function()
		return stationStartedAt
	end)
	applyMood(refs, mood)
	publishState("Riding")
	publishVote(0, 0, 0, -1, false)
	-- The lobby fades to black before the group appears in the train.
	fade(true)
	-- Give random-avatar passengers a moment to load in the dark.
	task.wait(Config.BlackoutSeconds)

	while #members() > 0 do
		-- Set up the next station while the screen is dark.
		local newMood = moodOf(level)
		if newMood ~= mood then
			mood = newMood
			applyMood(refs, mood)
		end

		local anomaly = pickAnomaly()
		local ctx = AnomalyContext.new(refs, members(), random)
		if anomaly then
			local ok, err = pcall(anomaly.Apply, ctx)
			if not ok then
				warn("[EndlessSubway] anomaly", anomaly.Name, "failed to apply:", err)
				ctx:Restore()
				anomaly = nil
			end
		end
		lastAnomaly = anomaly or lastAnomaly
		if Config.Debug then
			print("[EndlessSubway] session", session.Slot, "level", level, "anomaly:", anomaly and anomaly.Name or "none")
		end

		setDoors(refs, false)
		boardTrain()
		stationStartedAt = os.clock()
		publishState("Riding")
		fade(false)

		-- The train has stopped: doors open and the players decide.
		setDoors(refs, true)
		publishState("Station")
		local choice, byCoinFlip, outcome = VoteManager.collect(refs.Doors, members, session.GetAlive, publishVote, random)

		publishState("Riding")
		if byCoinFlip then
			message(text("CoinFlip", text(if choice == "Continue" then "DoorContinue" else "DoorBack")), 2)
		end
		fade(true)

		if anomaly then
			local ok, err = pcall(anomaly.Reset, ctx)
			if not ok then
				warn("[EndlessSubway] anomaly", anomaly.Name, "failed to reset:", err)
			end
		end
		-- Restore is idempotent, so this also covers anomalies whose Reset forgot to call it.
		ctx:Restore()

		if outcome == "Left" then
			return
		end

		if outcome == "Wiped" then
			-- The whole group died: everyone comes back, from the very beginning.
			level, checkpoint = 1, 0
			message(text("Wiped"), 3)
			session.Revive()
		elseif (choice == "Continue") == (anomaly == nil) then
			if table.find(Config.Checkpoints, level) then
				checkpoint = level
				message(text("CheckpointReached", checkpoint + 1), 4)
			end
			level += 1
			if level > Config.TotalLevels then
				message(text("Ending"), 4)
				task.wait(4)
				return
			end
			if level == Config.HorrorStartsAtLevel then
				task.delay(2, message, text("HorrorBegins"), 3)
			end
		else
			level = checkpoint + 1
			message(text("Wrong", level), 3)
		end

		publishState("Riding")
		task.wait(Config.BlackoutSeconds)
	end
end

return GameLoop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Graphics</string>
          <string name="Source"><![CDATA[-- Creates the lighting effects every client uses. Each client then tweens Lighting and these
-- effects to its own group's mood (lobby, bright calm levels, dark horror levels); see the Mood
-- client script. Lighting.Technology = Future is set in the place file (default.project.json),
-- because scripts cannot change it.

local Lighting = game:GetService("Lighting")

local Graphics = {}

local function effect(className: string, name: string)
	local existing = Lighting:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local instance = Instance.new(className)
	instance.Name = name
	instance.Parent = Lighting
end

function Graphics.apply()
	-- Indoors everywhere: no sky light; rooms are lit by their own lights and the ambient.
	Lighting.ClockTime = 0
	Lighting.Brightness = 0
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.3
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.Ambient = Color3.fromRGB(100, 100, 105)
	Lighting.OutdoorAmbient = Color3.fromRGB(70, 70, 75)

	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") or child:IsA("SunRaysEffect") then
			child:Destroy()
		end
	end

	effect("Atmosphere", "SubwayAir")
	effect("ColorCorrectionEffect", "SubwayGrade")
	effect("BloomEffect", "SubwayBloom")
end

return Graphics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[-- The lobby: a bright ticket hall with a row of gates. Groups gather on a gate, and when it leaves
-- they get their own station. The lobby itself is always in English.
--
-- Layout (studs, relative to LOBBY_ORIGIN): floor X -60..60, Z -40..40, gates along Z = -28.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Build = require(script.Parent.Build)

local block = Build.block

local LOBBY_ORIGIN = CFrame.new(0, 10, 0)
local GATE_SPACING = 18

local COLORS = {
	Floor = Color3.fromRGB(150, 146, 138),
	Wall = Color3.fromRGB(225, 220, 205),
	Ceiling = Color3.fromRGB(200, 198, 192),
	Frame = Color3.fromRGB(40, 40, 44),
	Yellow = Color3.fromRGB(230, 185, 25),
	Light = Color3.fromRGB(255, 248, 235),
}

local LobbyBuilder = {}

local function at(x: number, y: number, z: number): CFrame
	return LOBBY_ORIGIN * CFrame.new(x, y, z)
end

function LobbyBuilder.clearDefaultPlace()
	-- A fresh "Baseplate" place ships a baseplate and a spawn; players must spawn in the lobby.
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		baseplate:Destroy()
	end
	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("SpawnLocation") then
			descendant.Enabled = false
		end
	end
end

local function buildHall(lobby: Folder)
	block(lobby, "Floor", Vector3.new(120, 2, 80), at(0, -1, 0), COLORS.Floor, Enum.Material.Concrete)
	block(lobby, "Ceiling", Vector3.new(120, 1, 80), at(0, 20.5, 0), COLORS.Ceiling, Enum.Material.Concrete)
	block(lobby, "WallNorth", Vector3.new(122, 22, 1), at(0, 10, -40.5), COLORS.Wall, Enum.Material.CeramicTiles)
	block(lobby, "WallSouth", Vector3.new(122, 22, 1), at(0, 10, 40.5), COLORS.Wall, Enum.Material.CeramicTiles)
	block(lobby, "WallWest", Vector3.new(1, 22, 80), at(-60.5, 10, 0), COLORS.Wall, Enum.Material.CeramicTiles)
	block(lobby, "WallEast", Vector3.new(1, 22, 80), at(60.5, 10, 0), COLORS.Wall, Enum.Material.CeramicTiles)
	block(lobby, "FloorLine", Vector3.new(120, 0.05, 1), at(0, 0.03, -18), COLORS.Yellow)

	for x = -45, 45, 18 do
		for z = -30, 30, 15 do
			Build.ceilingLight(lobby, "Light", Vector3.new(10, 0.2, 1.2), at(x, 19.9, z), COLORS.Light, 2.2, 28)
		end
	end

	local title = block(lobby, "Title", Vector3.new(40, 6, 0.4), at(0, 15, 39.7), COLORS.Frame)
	Build.surfaceText(title, Enum.NormalId.Front, "ENDLESS SUBWAY", { TextColor = COLORS.Yellow, Glow = true })

	local howTo = block(lobby, "HowTo", Vector3.new(30, 7, 0.4), at(0, 6.5, 39.7), COLORS.Frame)
	Build.surfaceText(howTo, Enum.NormalId.Front, table.concat({
		"Stand on a gate with your friends.",
		"The first one in picks the group size (1-10) and the language.",
		"When the gate is full, the train leaves.",
	}, "\n"), { TextColor = Color3.fromRGB(220, 220, 220), Glow = true })

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(12, 0.2, 12)
	spawn.CFrame = at(0, 0.1, 18)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = COLORS.Yellow
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.6
	spawn.CanCollide = false
	spawn.Parent = lobby
	return spawn
end

local function buildGate(lobby: Folder, index: number, x: number)
	local gate = Instance.new("Model")
	gate.Name = "Gate" .. index
	gate.Parent = lobby

	local zone = block(gate, "Zone", Vector3.new(12, 0.2, 12), at(x, 0.1, -28), Color3.fromRGB(80, 80, 80), Enum.Material.Neon)
	zone.Transparency = 0.55
	zone.CanCollide = false
	zone.CastShadow = false

	block(gate, "PillarWest", Vector3.new(1, 10, 1), at(x - 6.5, 5, -34.5), COLORS.Frame, Enum.Material.Metal)
	block(gate, "PillarEast", Vector3.new(1, 10, 1), at(x + 6.5, 5, -34.5), COLORS.Frame, Enum.Material.Metal)
	block(gate, "Header", Vector3.new(14, 1.5, 1), at(x, 10.5, -34.5), COLORS.Frame, Enum.Material.Metal)
	block(gate, "Tunnel", Vector3.new(12, 10, 0.2), at(x, 5, -39.8), Color3.fromRGB(5, 5, 6))

	local screen = block(gate, "Screen", Vector3.new(12, 4, 0.4), at(x, 13.8, -34.5), Color3.fromRGB(10, 10, 12))
	local label = Build.surfaceText(screen, Enum.NormalId.Back, "", { TextColor = COLORS.Yellow, Glow = true })

	local glow = Instance.new("PointLight")
	glow.Range = 14
	glow.Brightness = 0.8
	glow.Parent = zone

	return { Index = index, Zone = zone, Label = label, Glow = glow }
end

-- Builds the lobby into Workspace.Lobby. Returns the gates and the spawn point.
function LobbyBuilder.build()
	LobbyBuilder.clearDefaultPlace()

	local existing = Workspace:FindFirstChild("Lobby")
	if existing then
		existing:Destroy()
	end

	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"

	local spawn = buildHall(lobby)
	local gates = {}
	local first = -(Config.LobbyPads - 1) * GATE_SPACING / 2
	for i = 1, Config.LobbyPads do
		table.insert(gates, buildGate(lobby, i, first + (i - 1) * GATE_SPACING))
	end

	lobby.Parent = Workspace
	return {
		Folder = lobby,
		Spawn = spawn,
		SpawnCFrame = spawn.CFrame * CFrame.new(0, 3.5, 0),
		Gates = gates,
	}
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">LobbyManager</string>
          <string name="Source"><![CDATA[-- Lobby gates. Standing on a gate joins its group; stepping off leaves it. The first player on a
-- gate is the host and picks the group size (1-10) and the session language (AR / EN). The group
-- leaves when the gate is full, or when the host presses "Start now".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local SessionManager = require(script.Parent.SessionManager)

local POLL_SECONDS = 0.2

local LANGUAGE_NAMES = { ar = "ARABIC", en = "ENGLISH" }

local LobbyManager = {}

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function isInside(zone: BasePart, position: Vector3): boolean
	local relative = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(relative.X) <= half.X and math.abs(relative.Z) <= half.Z and relative.Y > -2 and relative.Y < 10
end

local function newPad(gate)
	return {
		Gate = gate,
		Members = {} :: { Player },
		MaxPlayers = Config.DefaultPartySize,
		Language = "en",
		StartRequested = false,
		CountdownEnd = nil :: number?,
	}
end

local function resetPad(pad)
	table.clear(pad.Members)
	pad.MaxPlayers = Config.DefaultPartySize
	pad.Language = "en"
	pad.StartRequested = false
	pad.CountdownEnd = nil
end

local function hostPad(pads, player: Player)
	for _, pad in pads do
		if pad.Members[1] == player then
			return pad
		end
	end
	return nil
end

local function render(pad, now: number)
	local gate = pad.Gate
	local count = #pad.Members
	if count == 0 then
		gate.Label.Text = string.format("GATE %d\nEMPTY", gate.Index)
		gate.Zone.Color = Color3.fromRGB(80, 80, 80)
	elseif pad.CountdownEnd then
		gate.Label.Text = string.format("GATE %d  %d/%d\nLEAVING IN %d", gate.Index, count, pad.MaxPlayers, math.ceil(pad.CountdownEnd - now))
		gate.Zone.Color = Color3.fromRGB(40, 170, 90)
	else
		gate.Label.Text = string.format("GATE %d  %d/%d\n%s", gate.Index, count, pad.MaxPlayers, LANGUAGE_NAMES[pad.Language])
		gate.Zone.Color = Color3.fromRGB(220, 175, 25)
	end
	gate.Glow.Color = gate.Zone.Color
end

function LobbyManager.start(lobby)
	local pads = {}
	for _, gate in lobby.Gates do
		table.insert(pads, newPad(gate))
	end

	Net.lobbyAction().OnServerEvent:Connect(function(player: Player, action: any, value: any)
		if action == "LeaveRun" then
			SessionManager.leave(player)
			return
		end

		local pad = hostPad(pads, player)
		if not pad then
			return
		end
		if action == "SetPartySize" and type(value) == "number" and value == value then
			local size = math.clamp(math.floor(value), Config.MinPartySize, Config.MaxPartySize)
			pad.MaxPlayers = math.max(size, #pad.Members)
		elseif action == "SetLanguage" and (value == "ar" or value == "en") then
			pad.Language = value
		elseif action == "StartNow" then
			pad.StartRequested = true
		end
	end)

	task.spawn(function()
		while true do
			local now = os.clock()
			local claimed: { [Player]: boolean } = {}
			local standingOnFull: { [Player]: boolean } = {}

			for _, pad in pads do
				local zone = pad.Gate.Zone

				-- Keep members who are still standing here, in their original order.
				local kept = {}
				for _, player in pad.Members do
					local root = player.Parent and not SessionManager.isPlaying(player) and rootOf(player)
					if root and isInside(zone, root.Position) then
						table.insert(kept, player)
						claimed[player] = true
					end
				end
				pad.Members = kept

				-- Let newcomers in while there is room.
				for _, player in Players:GetPlayers() do
					if claimed[player] or SessionManager.isPlaying(player) then
						continue
					end
					local root = rootOf(player)
					if root and isInside(zone, root.Position) then
						if #pad.Members < pad.MaxPlayers then
							table.insert(pad.Members, player)
							claimed[player] = true
						else
							standingOnFull[player] = true
						end
					end
				end

				if #pad.Members == 0 then
					resetPad(pad)
				else
					local ready = #pad.Members >= pad.MaxPlayers or pad.StartRequested
					if ready and not pad.CountdownEnd then
						pad.CountdownEnd = now + Config.LobbyCountdownSeconds
					elseif not ready then
						pad.CountdownEnd = nil
					end

					if pad.CountdownEnd and now >= pad.CountdownEnd then
						SessionManager.launch(table.clone(pad.Members), pad.Language)
						resetPad(pad)
					end
				end

				render(pad, now)
			end

			-- Tell each lobby player's HUD about their gate.
			for _, player in Players:GetPlayers() do
				if SessionManager.isPlaying(player) then
					continue
				end
				local mine = nil
				for _, pad in pads do
					if table.find(pad.Members, player) then
						mine = pad
						break
					end
				end
				player:SetAttribute("Pad", if mine then mine.Gate.Index else 0)
				player:SetAttribute("PadHost", mine ~= nil and mine.Members[1] == player)
				player:SetAttribute("PadCount", if mine then #mine.Members else 0)
				player:SetAttribute("PadMax", if mine then mine.MaxPlayers else 0)
				player:SetAttribute("PadLanguage", if mine then mine.Language else "en")
				player:SetAttribute("PadCountdown", if mine and mine.CountdownEnd then math.max(0, math.ceil(mine.CountdownEnd - now)) else -1)
				player:SetAttribute("PadFull", standingOnFull[player] == true)
			end

			task.wait(POLL_SECONDS)
		end
	end)
end

return LobbyManager
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="27">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Endless Subway. This one place plays two roles:
--   Lobby server: builds the lobby and sends groups off from its gates.
--   Game server: a private server a gate teleported its group to; it runs only their game.
-- Roblox Studio cannot teleport, so there it is always a lobby server that also hosts the games.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Graphics = require(script.Parent.Graphics)
local LobbyBuilder = require(script.Parent.LobbyBuilder)
local LobbyManager = require(script.Parent.LobbyManager)
local SessionManager = require(script.Parent.SessionManager)

local live = Config.UseSeparateServers and not RunService:IsStudio()
local isGameServer = live and game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0

Graphics.apply()
if isGameServer then
	LobbyBuilder.clearDefaultPlace()
	SessionManager.initGameServer()
else
	local lobby = LobbyBuilder.build()
	SessionManager.init(lobby, live)
	LobbyManager.start(lobby)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Mannequin</string>
          <string name="Source"><![CDATA[-- Faceless block passengers built from anchored parts, so the map needs no uploaded assets.
-- The model's pivot is the hip point; it faces the CFrame's LookVector.

local Mannequin = {}

local SKIN = Color3.fromRGB(204, 176, 150)

local function addPart(model: Model, name: string, size: Vector3, offset: CFrame, color: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = offset
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end

local function addEyes(head: Part)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Eyes"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.Parent = head

	for _, x in { 0.28, 0.72 } do
		local eye = Instance.new("Frame")
		eye.AnchorPoint = Vector2.new(0.5, 0.5)
		eye.Position = UDim2.fromScale(x, 0.42)
		eye.Size = UDim2.fromScale(0.12, 0.12)
		eye.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
		eye.BorderSizePixel = 0
		eye.Parent = gui

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = eye
	end
end

-- pose: "Stand" (pivot 2 studs above the floor) or "Sit" (pivot on the seat surface).
function Mannequin.create(name: string, pose: "Stand" | "Sit", pivot: CFrame, clothes: Color3): Model
	local model = Instance.new("Model")
	model.Name = name

	local pants = clothes:Lerp(Color3.new(0, 0, 0), 0.5)

	local torso = addPart(model, "Torso", Vector3.new(2, 2, 1), CFrame.new(0, 1, 0), clothes)
	local leftArm = addPart(model, "LeftArm", Vector3.new(1, 2, 1), CFrame.new(-1.5, 1, 0), clothes)
	local rightArm = addPart(model, "RightArm", Vector3.new(1, 2, 1), CFrame.new(1.5, 1, 0), clothes)
	local head = addPart(model, "Head", Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 2.6, 0), SKIN)
	addEyes(head)

	if pose == "Stand" then
		addPart(model, "LeftLeg", Vector3.new(1, 2, 1), CFrame.new(-0.5, -1, 0), pants)
		addPart(model, "RightLeg", Vector3.new(1, 2, 1), CFrame.new(0.5, -1, 0), pants)
	else
		addPart(model, "LeftThigh", Vector3.new(1, 1, 2), CFrame.new(-0.5, 0.5, -0.5), pants)
		addPart(model, "RightThigh", Vector3.new(1, 1, 2), CFrame.new(0.5, 0.5, -0.5), pants)
		addPart(model, "LeftShin", Vector3.new(1, 2.4, 1), CFrame.new(-0.5, -0.7, -1), pants)
		addPart(model, "RightShin", Vector3.new(1, 2.4, 1), CFrame.new(0.5, -0.7, -1), pants)
		torso.CFrame = CFrame.new(0, 2, 0)
		leftArm.CFrame = CFrame.new(-1.5, 2, 0)
		rightArm.CFrame = CFrame.new(1.5, 2, 0)
		head.CFrame = CFrame.new(0, 3.6, 0)
	end

	model.PrimaryPart = torso
	-- Parts were laid out around the origin, so the origin is the hip pivot.
	model.WorldPivot = CFrame.new()
	model:PivotTo(pivot)
	return model
end

return Mannequin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Builds one station in code: an enterable metro car between two closed ones, a long dark
-- platform, the baseline details that anomalies change, and the hints that point at the twist.
-- Every group from the lobby gets its own copy, built at its own origin and in its own language.
--
-- Layout (studs, relative to the station origin). The platform runs along X, the track is on +Z.
--   Platform floor      X -100..100, Z -10..10, top at Y 1
--   Train car (open)    X -20..20,   Z 10..24 (wide), doors on the platform side (Z 11)
--   Closed cars         X -62..-22 and 22..62
--   CONTINUE door       +X end of the platform
--   GO BACK door        -X end of the platform

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Strings = require(ReplicatedStorage.Shared.Strings)
local Build = require(script.Parent.Build)
local Npc = require(script.Parent.Npc)

local block = Build.block
local surfaceText = Build.surfaceText

local HALF_LENGTH = 100

local COLORS = {
	Floor = Color3.fromRGB(92, 90, 86),
	Wall = Color3.fromRGB(150, 146, 132),
	WallGrime = Color3.fromRGB(70, 68, 62),
	WallStripe = Color3.fromRGB(30, 70, 55),
	Ceiling = Color3.fromRGB(40, 40, 42),
	Pillar = Color3.fromRGB(140, 132, 112),
	Edge = Color3.fromRGB(220, 175, 20),
	CarBody = Color3.fromRGB(150, 155, 162),
	CarStripe = Color3.fromRGB(220, 175, 20),
	CarSeat = Color3.fromRGB(55, 70, 110),
	Dark = Color3.fromRGB(18, 18, 20),
	Bench = Color3.fromRGB(90, 62, 40),
	Continue = Color3.fromRGB(40, 140, 80),
	Back = Color3.fromRGB(170, 50, 45),
	Light = Color3.fromRGB(255, 226, 180),
	Pipe = Color3.fromRGB(60, 62, 60),
}

local POSTER_COLORS = {
	Color3.fromRGB(170, 85, 25),
	Color3.fromRGB(30, 65, 125),
	Color3.fromRGB(30, 105, 65),
	Color3.fromRGB(85, 45, 115),
	Color3.fromRGB(150, 120, 20),
	Color3.fromRGB(25, 100, 110),
	Color3.fromRGB(120, 30, 30),
}

local MapBuilder = {}

-- Origin of the station being built. build() runs without yielding, so one shared value is safe.
local origin = CFrame.new()

local function at(x: number, y: number, z: number): CFrame
	return origin * CFrame.new(x, y, z)
end

local function buildShell(map: Folder)
	local shell = Instance.new("Folder")
	shell.Name = "Shell"
	shell.Parent = map

	local length = HALF_LENGTH * 2
	block(shell, "Platform", Vector3.new(length, 5, 20), at(0, -1.5, 0), COLORS.Floor, Enum.Material.Concrete)
	block(shell, "PlatformEdge", Vector3.new(length, 0.1, 1), at(0, 1.05, 9.5), COLORS.Edge)
	block(shell, "BackWall", Vector3.new(length + 2, 20, 1), at(0, 6, -10.5), COLORS.Wall, Enum.Material.CeramicTiles)
	block(shell, "WallStripe", Vector3.new(length, 1.2, 0.1), at(0, 2.6, -9.95), COLORS.WallStripe, Enum.Material.CeramicTiles)
	block(shell, "WallGrime", Vector3.new(length, 3, 0.1), at(0, 14.5, -9.95), COLORS.WallGrime, Enum.Material.Concrete)
	block(shell, "TunnelWall", Vector3.new(length + 2, 20, 1), at(0, 6, 27.5), COLORS.Dark, Enum.Material.Concrete)
	block(shell, "Ceiling", Vector3.new(length + 2, 1, 39), at(0, 16.5, 8.5), COLORS.Ceiling, Enum.Material.Concrete)
	block(shell, "TrackBed", Vector3.new(length, 1, 17), at(0, -3.5, 18.5), COLORS.Dark, Enum.Material.Slate)
	block(shell, "RailNear", Vector3.new(length, 0.4, 0.4), at(0, -2.8, 15.5), Color3.fromRGB(90, 90, 95), Enum.Material.Metal)
	block(shell, "RailFar", Vector3.new(length, 0.4, 0.4), at(0, -2.8, 20.5), Color3.fromRGB(90, 90, 95), Enum.Material.Metal)

	-- Pipes along the ceiling.
	for _, z in { -8.2, -7.2 } do
		local pipe = block(shell, "Pipe", Vector3.new(length, 0.6, 0.6), at(0, 15.3, z), COLORS.Pipe, Enum.Material.Metal)
		pipe.Shape = Enum.PartType.Cylinder
	end

	-- Keep players on the platform and in the open car.
	local barrierLength = HALF_LENGTH - 20
	local barrierCenter = 20 + barrierLength / 2
	Build.invisibleWall(shell, "EdgeBarrierWest", Vector3.new(barrierLength, 15, 0.5), at(-barrierCenter, 8.5, 10.25))
	Build.invisibleWall(shell, "EdgeBarrierEast", Vector3.new(barrierLength, 15, 0.5), at(barrierCenter, 8.5, 10.25))
end

local function buildExitDoor(map: Folder, kind: "Continue" | "Back", language: string)
	local sign = if kind == "Continue" then 1 else -1
	local color = if kind == "Continue" then COLORS.Continue else COLORS.Back
	local face = if kind == "Continue" then Enum.NormalId.Left else Enum.NormalId.Right
	local wallX = sign * (HALF_LENGTH + 0.5)
	local doorX = sign * (HALF_LENGTH - 0.2)

	local model = Instance.new("Model")
	model.Name = kind .. "Door"
	model.Parent = map

	block(model, "EndWall", Vector3.new(1, 20, 39), at(wallX, 6, 8.5), COLORS.Wall, Enum.Material.CeramicTiles)
	local door = block(model, "Door", Vector3.new(0.4, 8, 5), at(doorX, 5, 0), COLORS.Dark, Enum.Material.Metal)
	block(model, "Frame", Vector3.new(0.3, 9, 6), at(sign * (HALF_LENGTH - 0.05), 5.5, 0), color)

	local title = Strings.get(language, if kind == "Continue" then "DoorContinue" else "DoorBack")
	local signPart = block(model, "Sign", Vector3.new(0.4, 2, 8), at(doorX, 11, 0), color, Enum.Material.Neon)
	surfaceText(signPart, face, title, { TextColor = Color3.new(1, 1, 1), Glow = true })
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = 14
	glow.Brightness = 0.8
	glow.Parent = signPart

	-- Players vote by standing on this zone in front of the door.
	local zone = block(model, "VoteZone", Vector3.new(10, 0.1, 14), at(sign * (HALF_LENGTH - 7), 1.06, 0), color, Enum.Material.Neon)
	zone.Transparency = 0.8
	zone.CanCollide = false
	zone.CanQuery = false
	zone.CastShadow = false

	return { Model = model, Door = door, Zone = zone }
end

local function buildClosedCar(map: Folder, centerX: number)
	local car = Instance.new("Model")
	car.Name = "ClosedCar"
	car.Parent = map

	block(car, "Body", Vector3.new(40, 11, 14), at(centerX, 6.5, 18), COLORS.CarBody, Enum.Material.Metal)
	block(car, "Underbody", Vector3.new(40, 4, 13), at(centerX, -1.5, 18), COLORS.Dark, Enum.Material.Metal)
	block(car, "Stripe", Vector3.new(40, 0.6, 0.1), at(centerX, 3.2, 10.95), COLORS.CarStripe)
	-- Dark windows: nobody seems to be inside. Mostly.
	for offset = -15, 15, 10 do
		block(car, "Window", Vector3.new(6, 3, 0.1), at(centerX + offset, 7, 10.95), Color3.fromRGB(8, 10, 14), Enum.Material.Glass)
	end
	for _, offset in { -10, 10 } do
		block(car, "DoorOutline", Vector3.new(7, 8, 0.1), at(centerX + offset, 5, 10.94), Color3.fromRGB(110, 115, 122), Enum.Material.Metal)
	end
end

-- The open car is wide and clear: wide doors, seats only along the far wall, and grab bars up at
-- the roof instead of poles in the way.
local function buildCar(map: Folder)
	local car = Instance.new("Model")
	car.Name = "TrainCar"
	car.Parent = map

	block(car, "Floor", Vector3.new(40, 4, 14), at(0, -1, 17), Color3.fromRGB(70, 70, 76), Enum.Material.DiamondPlate)
	block(car, "Roof", Vector3.new(40, 1, 14), at(0, 12.5, 17), COLORS.CarBody, Enum.Material.Metal)
	block(car, "FarWall", Vector3.new(40, 11, 0.5), at(0, 6.5, 24.25), COLORS.CarBody, Enum.Material.Metal)
	block(car, "Window", Vector3.new(36, 3, 0.1), at(0, 7.5, 23.95), Color3.fromRGB(6, 8, 12), Enum.Material.Glass)
	block(car, "Stripe", Vector3.new(40, 0.6, 0.1), at(0, 10, 23.95), COLORS.CarStripe)
	block(car, "EndWallWest", Vector3.new(0.5, 11, 14), at(-19.75, 6.5, 17), COLORS.CarBody, Enum.Material.Metal)
	block(car, "EndWallEast", Vector3.new(0.5, 11, 14), at(19.75, 6.5, 17), COLORS.CarBody, Enum.Material.Metal)

	-- Platform side: three wall segments with two wide door openings (X -13.5..-6.5 and 6.5..13.5).
	block(car, "SideWallWest", Vector3.new(6.5, 11, 0.5), at(-16.75, 6.5, 11.25), COLORS.CarBody, Enum.Material.Metal)
	block(car, "SideWallMiddle", Vector3.new(13, 11, 0.5), at(0, 6.5, 11.25), COLORS.CarBody, Enum.Material.Metal)
	block(car, "SideWallEast", Vector3.new(6.5, 11, 0.5), at(16.75, 6.5, 11.25), COLORS.CarBody, Enum.Material.Metal)

	local doorPanels = {}
	for _, centerX in { -10, 10 } do
		block(car, "DoorHeader", Vector3.new(7, 3, 0.5), at(centerX, 10.5, 11.25), COLORS.CarBody, Enum.Material.Metal)
		for _, side in { -1, 1 } do
			local closed = at(centerX + side * 1.75, 5, 11.75)
			local open = at(centerX + side * 5.3, 5, 11.75)
			local panel = block(car, "DoorPanel", Vector3.new(3.5, 8, 0.3), closed, Color3.fromRGB(130, 135, 142), Enum.Material.Metal)
			table.insert(doorPanels, { Part = panel, Closed = closed, Open = open })
		end
	end

	for _, centerX in { -10, 10 } do
		block(car, "Seat", Vector3.new(14, 0.6, 1.8), at(centerX, 2.6, 22.9), COLORS.CarSeat, Enum.Material.Fabric)
		block(car, "SeatBack", Vector3.new(14, 2.5, 0.4), at(centerX, 4, 23.8), COLORS.CarSeat, Enum.Material.Fabric)
	end
	for _, z in { 14.5, 19.5 } do
		local bar = block(car, "GrabBar", Vector3.new(36, 0.25, 0.25), at(0, 11.4, z), Color3.fromRGB(170, 170, 175), Enum.Material.Metal)
		bar.Shape = Enum.PartType.Cylinder
		bar.CanCollide = false
	end
	for _, z in { 14.5, 19.5 } do
		Build.ceilingLight(car, "LightStrip", Vector3.new(36, 0.2, 0.8), at(0, 11.9, z), Color3.fromRGB(235, 240, 255), 1.4, 14)
	end

	-- Where the group stands when the train stops: two rows, enough for 10 players.
	local standPoints = {}
	for _, z in { 15, 18.5 } do
		for x = -16, 16, 4 do
			table.insert(standPoints, at(x, 4, z))
		end
	end

	return car, doorPanels, standPoints
end

local function buildStation(map: Folder, refs, language: string)
	local station = Instance.new("Folder")
	station.Name = "Station"
	station.Parent = map

	-- Pillars down the middle of the platform.
	refs.Pillars = {}
	for x = -80, 80, 20 do
		local pillar = block(station, "Pillar", Vector3.new(2, 15, 2), at(x, 8.5, 1), COLORS.Pillar, Enum.Material.Marble)
		pillar:SetAttribute("X", x)
		table.insert(refs.Pillars, pillar)
	end

	-- Ceiling lights, plus a second row over the platform edge. In the dark half of the game some of
	-- them die ("DiesInHorror"), which leaves pools of darkness along the platform.
	local diesInHorror = { [-70] = true, [-30] = true, [50] = true, [90] = true }
	refs.Lights = {}
	for x = -90, 90, 20 do
		local fixture = Build.ceilingLight(station, "Light", Vector3.new(8, 0.2, 1), at(x, 15.9, 0), COLORS.Light, 1.8, 20)
		fixture:SetAttribute("DiesInHorror", diesInHorror[x] == true)
		table.insert(refs.Lights, fixture)
	end
	for x = -80, 80, 40 do
		local fixture = Build.ceilingLight(station, "Light", Vector3.new(8, 0.2, 1), at(x, 15.9, 7), COLORS.Light, 1.8, 20)
		fixture:SetAttribute("DiesInHorror", true)
		table.insert(refs.Lights, fixture)
	end

	-- Benches against the back wall, facing the track.
	local busyBenches = { [-70] = true, [-30] = true, [-10] = true, [30] = true }
	refs.Benches = {}
	for x = -70, 70, 20 do
		local bench = Instance.new("Model")
		bench.Name = "Bench"
		local seat = block(bench, "Seat", Vector3.new(6, 0.5, 1.8), at(x, 2.75, -8.3), COLORS.Bench, Enum.Material.WoodPlanks)
		block(bench, "Backrest", Vector3.new(6, 1.8, 0.4), at(x, 4, -9.2), COLORS.Bench, Enum.Material.WoodPlanks)
		block(bench, "LegWest", Vector3.new(0.4, 1.5, 1.4), at(x - 2.6, 1.75, -8.3), COLORS.Dark, Enum.Material.Metal)
		block(bench, "LegEast", Vector3.new(0.4, 1.5, 1.4), at(x + 2.6, 1.75, -8.3), COLORS.Dark, Enum.Material.Metal)
		bench.PrimaryPart = seat
		bench:SetAttribute("Free", not busyBenches[x])
		bench.Parent = station
		table.insert(refs.Benches, bench)
	end

	-- Station name and line badge.
	local nameSign = block(station, "StationSign", Vector3.new(16, 3, 0.3), at(0, 11, -9.85), Color3.fromRGB(16, 30, 60))
	refs.StationName = surfaceText(nameSign, Enum.NormalId.Back, Strings.get(language, "StationName"), { TextColor = Color3.fromRGB(230, 230, 230) })
	local badge = block(station, "LineBadge", Vector3.new(3, 3, 0.3), at(10, 11, -9.85), COLORS.Edge)
	refs.LineBadge = surfaceText(badge, Enum.NormalId.Back, "14", { TextColor = COLORS.Dark })

	-- Digital clock. The game loop ticks it unless its "Frozen" attribute is set.
	refs.Clock = block(station, "Clock", Vector3.new(3.4, 1.4, 0.3), at(-10, 11, -9.85), COLORS.Dark)
	refs.ClockLabel = surfaceText(refs.Clock, Enum.NormalId.Back, "23:57:00", {
		TextColor = Color3.fromRGB(255, 50, 40),
		Glow = true,
	})

	-- Hanging counter sign, readable when stepping out of the car.
	local counter = block(station, "CounterSign", Vector3.new(7, 2.6, 0.3), at(0, 13.5, 7), COLORS.Dark)
	block(station, "CounterHanger", Vector3.new(0.2, 1.7, 0.2), at(0, 15.15, 7), COLORS.Dark, Enum.Material.Metal)
	refs.CounterLabel = surfaceText(counter, Enum.NormalId.Back, "", { TextColor = COLORS.Edge, Glow = true })

	-- Advertisements on the back wall.
	refs.Posters = {}
	local texts = Strings.get(language, "Posters")
	for i, x in { -80, -40, -20, 20, 40, 60, 80 } do
		local color = POSTER_COLORS[i]
		local poster = block(station, "Poster", Vector3.new(5, 7, 0.2), at(x, 7.5, -9.9), color)
		table.insert(refs.Posters, surfaceText(poster, Enum.NormalId.Back, texts[i], { Background = color }))
	end

	-- A vending machine humming in the dark.
	local vending = block(station, "VendingMachine", Vector3.new(4, 7, 2.5), at(-60, 4.5, -8.6), Color3.fromRGB(110, 20, 25), Enum.Material.Metal)
	local panel = block(station, "VendingPanel", Vector3.new(3, 4, 0.1), at(-60, 5.2, -7.3), Color3.fromRGB(200, 220, 255), Enum.Material.Neon)
	surfaceText(panel, Enum.NormalId.Back, Strings.get(language, "Vending"), {
		Background = Color3.fromRGB(190, 210, 245),
		TextColor = Color3.fromRGB(110, 20, 25),
		Glow = true,
	})
	local vendingLight = Instance.new("PointLight")
	vendingLight.Color = Color3.fromRGB(190, 210, 255)
	vendingLight.Range = 10
	vendingLight.Brightness = 0.7
	vendingLight.Parent = vending

	-- Trash bins: upright cylinders (a cylinder's axis is its X, so turn it to stand up).
	for _, x in { -44, 44 } do
		local bin = block(station, "TrashBin", Vector3.new(2.4, 1.6, 1.6), at(x, 2.2, -9) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(45, 55, 45), Enum.Material.Metal)
		bin.Shape = Enum.PartType.Cylinder
	end

	-- Passengers. The game never says who they are.
	local flip = CFrame.Angles(0, math.pi, 0)
	refs.Passengers = {
		Npc.create("Passenger", "Sit", at(-30, 3, -8.1) * flip, Color3.fromRGB(40, 55, 90)),
		Npc.create("Passenger", "Sit", at(30, 3, -8.1) * flip, Color3.fromRGB(110, 75, 50)),
		Npc.create("Passenger", "Sit", at(-70, 3, -8.1) * flip, Color3.fromRGB(60, 60, 60)),
		Npc.create("Passenger", "Stand", at(-5, 3, -3) * flip, Color3.fromRGB(95, 95, 100)),
		Npc.create("Passenger", "Stand", at(62, 3, 6) * flip, Color3.fromRGB(70, 40, 60)),
		Npc.create("Passenger", "Sit", at(-10, 2.9, 22.7), Color3.fromRGB(120, 40, 45)),
	}
	for _, passenger in refs.Passengers do
		passenger.Parent = station
	end

	-- Hints at the twist. They only show up once the dark half begins (see GameLoop), and nobody
	-- gets them the first time.
	local newspaper = block(station, "Newspaper", Vector3.new(2, 0.05, 1.4), at(-10.8, 3.03, -8.2), Color3.fromRGB(225, 222, 210))
	refs.NewspaperLabel = surfaceText(newspaper, Enum.NormalId.Top, Strings.get(language, "Newspaper", Strings.tomorrow(language)), {
		Background = Color3.fromRGB(225, 222, 210),
		TextColor = COLORS.Dark,
		PixelsPerStud = 80,
	})

	local flowers = Instance.new("Model")
	flowers.Name = "Flowers"
	for i, color in { Color3.fromRGB(180, 25, 35), Color3.fromRGB(235, 235, 230), Color3.fromRGB(180, 25, 35) } do
		local offset = (i - 2) * 0.35
		local base = at(1.8 + offset, 1.1, 2.6) * CFrame.Angles(0, math.rad(20 * (i - 2)), 0)
		block(flowers, "Stem", Vector3.new(0.12, 0.12, 1.6), base, Color3.fromRGB(45, 95, 45))
		local bloom = block(flowers, "Bloom", Vector3.new(0.45, 0.45, 0.45), base * CFrame.new(0, 0.1, -0.85), color)
		bloom.Shape = Enum.PartType.Ball
	end
	flowers.Parent = station

	local phone = block(station, "Phone", Vector3.new(0.7, 0.06, 1.2), at(34, 1.03, 4) * CFrame.Angles(0, math.rad(25), 0), COLORS.Dark)
	refs.PhoneLabel = surfaceText(phone, Enum.NormalId.Top, Strings.get(language, "MissedCalls", 12), {
		Background = Color3.fromRGB(10, 10, 14),
		TextColor = Color3.fromRGB(230, 230, 235),
		Glow = true,
		PixelsPerStud = 90,
	})
	local glow = Instance.new("PointLight")
	glow.Range = 5
	glow.Brightness = 0.8
	glow.Color = Color3.fromRGB(200, 220, 255)
	glow.Parent = phone

	refs.Hints = { newspaper, flowers, phone }
	refs.Station = station
end

-- Builds one station at stationOrigin into Workspace and returns the references the game loop and
-- anomalies use. refs.At(x, y, z) converts layout coordinates of this station to world space.
-- withSpawn adds a spawn point in the train, for game servers that have no lobby.
function MapBuilder.build(stationOrigin: CFrame, name: string, language: string, withSpawn: boolean?)
	origin = stationOrigin

	local existing = Workspace:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end

	local map = Instance.new("Folder")
	map.Name = name

	local refs: any = {
		Map = map,
		Origin = stationOrigin,
		Language = language,
		At = function(x: number, y: number, z: number): CFrame
			return stationOrigin * CFrame.new(x, y, z)
		end,
	}

	buildShell(map)
	refs.Doors = {
		Continue = buildExitDoor(map, "Continue", language),
		Back = buildExitDoor(map, "Back", language),
	}
	buildClosedCar(map, -42)
	buildClosedCar(map, 42)
	refs.Car, refs.DoorPanels, refs.StandPoints = buildCar(map)
	buildStation(map, refs, language)

	if withSpawn then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "TrainSpawn"
		spawn.Size = Vector3.new(16, 0.1, 6)
		spawn.CFrame = at(0, 1.05, 17)
		spawn.Anchored = true
		spawn.CanCollide = false
		spawn.Transparency = 1
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Parent = refs.Car
	end

	map.Parent = Workspace
	return refs
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Npc</string>
          <string name="Source"><![CDATA[-- Passengers. Each one appears straight away as a block mannequin, then (if
-- Config.RandomAvatarNpcs is on) swaps to the avatar of a random real Roblox user once it loads.
-- If no avatar loads, the mannequin stays.
--
-- The returned Model is the passenger for good: anomalies can hide it or look inside it for
-- "Head", whichever body it ends up with.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Mannequin = require(script.Parent.Mannequin)

-- Roblox's default R15 sit animation.
local SIT_ANIMATION = "rbxassetid://2506281703"
local MAX_USER_ID = 3_000_000_000
local ATTEMPTS = 8

local random = Random.new()

local Npc = {}

local function randomDescription(): HumanoidDescription?
	for _ = 1, ATTEMPTS do
		local ok, description = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(random:NextInteger(1, MAX_USER_ID))
		end)
		if ok and description then
			return description
		end
	end
	return nil
end

local function waitUntilInWorld(model: Model): boolean
	local deadline = os.clock() + 30
	while not model:IsDescendantOf(Workspace) do
		if os.clock() > deadline then
			return false
		end
		task.wait(0.5)
	end
	return true
end

local function loadAvatar(container: Model, pose: "Stand" | "Sit", pivot: CFrame)
	local description = randomDescription()
	if not description then
		return
	end

	local ok, avatar = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not avatar or not waitUntilInWorld(container) then
		return
	end

	local humanoid = avatar:FindFirstChildOfClass("Humanoid")
	local root = avatar:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		avatar:Destroy()
		return
	end

	avatar.Name = "Avatar"
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	for _, descendant in avatar:GetDescendants() do
		if descendant:IsA("BaseScript") then
			descendant:Destroy()
		end
	end

	container:ClearAllChildren()

	if pose == "Stand" then
		-- The mannequin pivot sits 2 studs above the floor.
		local floor = pivot * CFrame.new(0, -2, 0)
		root.Anchored = true
		avatar:PivotTo(floor * CFrame.new(0, humanoid.HipHeight + root.Size.Y / 2, 0))
		avatar.Parent = container
		return
	end

	-- Sitting: let a hidden Seat place the body, then play the sit pose.
	local seat = Instance.new("Seat")
	seat.Name = "NpcSeat"
	seat.Size = Vector3.new(2, 0.2, 2)
	seat.CFrame = pivot * CFrame.new(0, -0.1, 0)
	seat.Anchored = true
	seat.CanCollide = false
	seat.Transparency = 1
	seat.Parent = container

	avatar:PivotTo(pivot * CFrame.new(0, 3, 0))
	avatar.Parent = container
	seat:Sit(humanoid)

	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = humanoid
	local animation = Instance.new("Animation")
	animation.AnimationId = SIT_ANIMATION
	local played = pcall(function()
		local track = animator:LoadAnimation(animation)
		track.Looped = true
		track:Play(0)
	end)
	if not played then
		warn("[EndlessSubway] could not play the sit animation for a passenger")
	end
end

-- pose: "Stand" (pivot 2 studs above the floor) or "Sit" (pivot on the seat surface),
-- facing the pivot's LookVector.
function Npc.create(name: string, pose: "Stand" | "Sit", pivot: CFrame, clothes: Color3): Model
	local container = Mannequin.create(name, pose, pivot, clothes)
	if Config.RandomAvatarNpcs then
		task.spawn(loadAvatar, container, pose, pivot)
	end
	return container
end

return Npc
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">SessionManager</string>
          <string name="Source"><![CDATA[-- Runs one game per group, and owns spawning and death.
--
-- Where a group plays:
--   Live game (Config.UseSeparateServers, outside Studio): the lobby server teleports the group to a
--   private server of this same place. That server is the group's own world: it builds one station
--   and runs one game, then sends everyone back to a lobby server.
--   Studio (or teleport failure): the group plays in the lobby server, on its own station copy
--   built far from the lobby.
--
-- Death: players never respawn on their own during a game. A dead player spectates (see the
-- Spectate client script) until the whole group is dead; then the game loop calls Revive and the
-- group starts again from level 1.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Strings = require(ReplicatedStorage.Shared.Strings)
local GameLoop = require(script.Parent.GameLoop)
local MapBuilder = require(script.Parent.MapBuilder)

local LOBBY_RESPAWN_SECONDS = 3

local GAME_ATTRIBUTES = {
	"Level",
	"TotalLevels",
	"Checkpoint",
	"VotesContinue",
	"VotesBack",
	"Voters",
	"VoteCountdown",
	"VoteTie",
	"SessionKey",
}

local SessionManager = {}

local lobby = nil -- lobby refs; nil on a game server
local live = false -- true when groups are teleported to their own servers
local sessionOf: { [Player]: any } = {}
local teleporting: { [Player]: boolean } = {}
local freeSlots: { number } = {}
local nextSlot = 1

local function aliveCharacter(player: Player): Model?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if character and humanoid and humanoid.Health > 0 and character:FindFirstChild("HumanoidRootPart") then
		return character
	end
	return nil
end

local function moveTo(player: Player, cframe: CFrame)
	local character = aliveCharacter(player)
	if character then
		character:PivotTo(cframe)
	end
end

local function sendToLobbyServer(players: { Player })
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, players)
	end)
	if not ok then
		warn("[EndlessSubway] teleport to lobby failed:", err)
		for _, player in players do
			player:Kick("Thanks for playing Endless Subway! Rejoin to go back to the lobby.")
		end
	end
end

local function resetToLobby(player: Player)
	for _, name in GAME_ATTRIBUTES do
		player:SetAttribute(name, nil)
	end
	player:SetAttribute("Phase", "Lobby")
	player:SetAttribute("Mood", "Lobby")
	player:SetAttribute("Language", "en")
	player:SetAttribute("Dead", false)
	if not player.Parent then
		return
	end
	Net.event():FireClient(player, { Kind = "Fade", Visible = false, Duration = 0.5 })
	if aliveCharacter(player) then
		moveTo(player, lobby.SpawnCFrame)
	else
		player:LoadCharacter()
	end
end

-- True while a player is in a game, or on their way to one.
function SessionManager.isPlaying(player: Player): boolean
	return sessionOf[player] ~= nil or teleporting[player] == true
end

local function removeMember(player: Player)
	local session = sessionOf[player]
	sessionOf[player] = nil
	local index = session and table.find(session.Members, player)
	if index then
		table.remove(session.Members, index)
	end
	return session
end

-- Takes a player out of their game and back to the lobby.
function SessionManager.leave(player: Player)
	if not removeMember(player) then
		return
	end
	if lobby then
		resetToLobby(player)
	else
		sendToLobbyServer({ player })
	end
end

local function addMember(session, player: Player)
	if not player.Parent or sessionOf[player] then
		return
	end
	sessionOf[player] = session
	table.insert(session.Members, player)
	player:SetAttribute("Language", session.Language)
	player:SetAttribute("SessionKey", session.Key)
	player:SetAttribute("Dead", false)
end

local function newSession(slot: number, language: string, withSpawn: boolean)
	local session = {
		Slot = slot,
		Key = tostring(slot) .. "-" .. tostring(os.clock()),
		Language = Strings.normalize(language),
		Members = {} :: { Player },
		Refs = nil :: any,
	}
	local stationOrigin = CFrame.new(slot * Config.StationSpacing, 50, 0)
	session.Refs = MapBuilder.build(stationOrigin, "Station" .. slot, session.Language, withSpawn)

	-- Players still in the server, in join order.
	function session.GetMembers(): { Player }
		local present = {}
		for _, player in session.Members do
			if player.Parent then
				table.insert(present, player)
			end
		end
		return present
	end

	-- Members whose character is alive.
	function session.GetAlive(): { Player }
		local alive = {}
		for _, player in session.GetMembers() do
			if aliveCharacter(player) then
				table.insert(alive, player)
			end
		end
		return alive
	end

	-- Brings every dead member back (used after the whole group died).
	function session.Revive()
		for _, player in session.GetMembers() do
			player:SetAttribute("Dead", false)
			if not aliveCharacter(player) then
				player:LoadCharacter()
			end
		end
	end

	return session
end

local function runLocal(members: { Player }, language: string)
	local slot = table.remove(freeSlots) or nextSlot
	if slot == nextSlot then
		nextSlot += 1
	end

	local session = newSession(slot, language, false)
	for _, player in members do
		addMember(session, player)
	end

	task.spawn(function()
		local ok, err = pcall(GameLoop.run, session)
		if not ok then
			warn("[EndlessSubway] session", slot, "crashed:", err)
		end
		for _, player in table.clone(session.Members) do
			SessionManager.leave(player)
		end
		session.Refs.Map:Destroy()
		table.insert(freeSlots, slot)
	end)
end

-- Called by the lobby when a gate leaves.
function SessionManager.launch(members: { Player }, language: string)
	if live then
		local options = Instance.new("TeleportOptions")
		options.ShouldReserveServer = true
		options:SetTeleportData({ Language = Strings.normalize(language), Expected = #members })
		for _, player in members do
			teleporting[player] = true
			Net.event():FireClient(player, { Kind = "Fade", Visible = true, Duration = 0.5 })
		end
		local ok, err = pcall(function()
			TeleportService:TeleportAsync(game.PlaceId, members, options)
		end)
		if ok then
			return
		end
		warn("[EndlessSubway] could not teleport the group, playing in this server instead:", err)
	end
	for _, player in members do
		teleporting[player] = nil
	end
	runLocal(members, language)
end

-- canSpawn says whether a player may get a character yet (a game server waits for its station).
local function setUpSpawning(onDied: (Player) -> (), canSpawn: () -> boolean)
	Players.CharacterAutoLoads = false

	local function onPlayer(player: Player)
		player:SetAttribute("Dead", false)
		player.CharacterAdded:Connect(function(character)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					onDied(player)
				end)
			end
			-- Spawning mid-game puts you in your group's train.
			local session = sessionOf[player]
			if session then
				character:WaitForChild("HumanoidRootPart", 5)
				task.wait()
				moveTo(player, session.Refs.StandPoints[1])
			end
		end)
		if canSpawn() then
			player:LoadCharacter()
		end
	end

	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
end

-- Lobby server (or Studio).
function SessionManager.init(lobbyRefs, isLive: boolean)
	lobby = lobbyRefs
	live = isLive

	setUpSpawning(function(player)
		if sessionOf[player] then
			player:SetAttribute("Dead", true)
		else
			task.delay(LOBBY_RESPAWN_SECONDS, function()
				if player.Parent and not sessionOf[player] and not aliveCharacter(player) then
					player:LoadCharacter()
				end
			end)
		end
	end, function()
		return true
	end)

	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("Phase", "Lobby")
		player:SetAttribute("Mood", "Lobby")
		player:SetAttribute("Language", "en")
	end)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("Phase", "Lobby")
		player:SetAttribute("Mood", "Lobby")
		player:SetAttribute("Language", "en")
	end
	Players.PlayerRemoving:Connect(function(player)
		teleporting[player] = nil
		removeMember(player)
	end)

	-- A teleport that fails after it started: put the player back in the lobby.
	TeleportService.TeleportInitFailed:Connect(function(player, _result, errorMessage)
		if teleporting[player] then
			warn("[EndlessSubway] teleport failed for", player.Name, errorMessage)
			teleporting[player] = nil
			resetToLobby(player)
		end
	end)
end

-- A group's own server: wait for the group, play one game, send everyone back to the lobby.
function SessionManager.initGameServer()
	lobby = nil
	live = true

	local session = nil
	local language = "en"
	local expected = 1

	setUpSpawning(function(player)
		player:SetAttribute("Dead", true)
	end, function()
		return session ~= nil
	end)

	local function join(player: Player)
		local data = player:GetJoinData().TeleportData
		if type(data) == "table" and not session then
			language = Strings.normalize(data.Language)
			expected = tonumber(data.Expected) or expected
		end
		player:SetAttribute("Phase", "Riding")
		player:SetAttribute("Mood", "Calm")
		if session then
			-- A late teammate joins the game that is already running.
			addMember(session, player)
		end
	end
	Players.PlayerAdded:Connect(join)
	for _, player in Players:GetPlayers() do
		join(player)
	end
	Players.PlayerRemoving:Connect(removeMember)

	-- Wait for the group to arrive.
	while #Players:GetPlayers() == 0 do
		Players.PlayerAdded:Wait()
	end
	local deadline = os.clock() + Config.GroupArrivalTimeout
	while #Players:GetPlayers() < expected and os.clock() < deadline do
		task.wait(0.5)
	end

	session = newSession(0, language, true)
	for _, player in Players:GetPlayers() do
		addMember(session, player)
		if not player.Character then
			task.spawn(player.LoadCharacter, player)
		end
	end

	local ok, err = pcall(GameLoop.run, session)
	if not ok then
		warn("[EndlessSubway] game crashed:", err)
	end
	sendToLobbyServer(Players:GetPlayers())
end

return SessionManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">VoteManager</string>
          <string name="Source"><![CDATA[-- Majority vote by standing in front of a door. Each player votes with their body: whoever is
-- inside a door's zone votes for it, and stepping out takes the vote back.
--
-- The vote locks in when every player is at a door, there is a clear majority, and nobody moves
-- for Config.VoteConfirmSeconds. A tie keeps everyone arguing until the timeout, then a coin flip.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local POLL_SECONDS = 0.2

export type Choice = "Continue" | "Back"
export type Outcome = "Decided" | "Left" | "Wiped"
type Publish = (continueVotes: number, backVotes: number, voters: number, countdown: number, tie: boolean) -> ()

local VoteManager = {}

local function isInside(zone: BasePart, position: Vector3): boolean
	local relative = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(relative.X) <= half.X and math.abs(relative.Z) <= half.Z and relative.Y > -2 and relative.Y < 10
end

-- Only living players vote.
local function count(doors, alive: { Player })
	local continueVotes, backVotes = 0, 0
	for _, player in alive do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			if isInside(doors.Continue.Zone, root.Position) then
				continueVotes += 1
			elseif isInside(doors.Back.Zone, root.Position) then
				backVotes += 1
			end
		end
	end
	return continueVotes, backVotes, #alive
end

-- Yields until the group decides. Returns the choice, whether a coin flip settled a tie, and the
-- outcome: "Decided", "Left" (the whole group left the game) or "Wiped" (everyone is dead).
function VoteManager.collect(
	doors,
	getMembers: () -> { Player },
	getAlive: () -> { Player },
	publish: Publish,
	random: Random
): (Choice?, boolean, Outcome)
	local firstVoteAt: number? = nil
	local leader: Choice? = nil
	local leaderSince = 0

	while true do
		if #getMembers() == 0 then
			return nil, false, "Left"
		end
		local alive = getAlive()
		if #alive == 0 then
			return nil, false, "Wiped"
		end

		local now = os.clock()
		local continueVotes, backVotes, voters = count(doors, alive)
		local voted = continueVotes + backVotes
		local everyone = voters > 0 and voted == voters
		local tie = everyone and continueVotes == backVotes

		if voted > 0 then
			firstVoteAt = firstVoteAt or now
		else
			firstVoteAt = nil
		end

		local current: Choice? = nil
		if everyone and not tie then
			current = if continueVotes > backVotes then "Continue" else "Back"
		end
		if current ~= leader then
			leader = current
			leaderSince = now
		end

		local countdown = -1
		if leader then
			countdown = Config.VoteConfirmSeconds - (now - leaderSince)
			if countdown <= 0 then
				publish(continueVotes, backVotes, voters, -1, false)
				return leader, false, "Decided"
			end
		end

		if firstVoteAt and now - firstVoteAt >= Config.VoteTimeoutSeconds then
			publish(continueVotes, backVotes, voters, -1, false)
			if continueVotes == backVotes then
				return if random:NextNumber() < 0.5 then "Continue" else "Back", true, "Decided"
			end
			return if continueVotes > backVotes then "Continue" else "Back", false, "Decided"
		end

		publish(continueVotes, backVotes, voters, if countdown >= 0 then math.ceil(countdown) else -1, tie)
		task.wait(POLL_SECONDS)
	end
end

return VoteManager
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="33">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="34">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="36">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- Player HUD.
--   Lobby (always English): gate status, and for the host: group size 1-10, language AR/EN,
--   "Start now".
--   In game (the group's language): level and station counter, the rule, the live door vote,
--   "Back to lobby", messages, and the black screen between stations.
-- All state comes from attributes on the local Player (see Shared/Net).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer
local event = Net.event()
local lobbyAction = Net.lobbyAction()

local YELLOW = Color3.fromRGB(240, 192, 24)
local GREEN = Color3.fromRGB(70, 200, 120)
local RED = Color3.fromRGB(230, 85, 75)
local PANEL = Color3.fromRGB(16, 16, 20)
local BUTTON = Color3.fromRGB(45, 45, 52)

local gui = Instance.new("ScreenGui")
gui.Name = "EndlessSubwayHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local function create(className: string, parent: Instance, props: { [string]: any }): any
	local instance = Instance.new(className)
	for key, value in props do
		(instance :: any)[key] = value
	end
	instance.Parent = parent
	return instance
end

local function rounded(instance: GuiObject, radius: number)
	create("UICorner", instance, { CornerRadius = UDim.new(0, radius) })
end

local function text(parent: Instance, name: string, props: { [string]: any }): TextLabel
	local label = create("TextLabel", parent, {
		Name = name,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
	})
	for key, value in props do
		(label :: any)[key] = value
	end
	return label
end

local function button(parent: Instance, name: string, props: { [string]: any }): TextButton
	local b = create("TextButton", parent, {
		Name = name,
		BackgroundColor3 = BUTTON,
		AutoButtonColor = true,
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
	})
	for key, value in props do
		(b :: any)[key] = value
	end
	rounded(b, 8)
	create("UIPadding", b, { PaddingTop = UDim.new(0.18, 0), PaddingBottom = UDim.new(0.18, 0) })
	return b
end

-- ===== In-game HUD =====

local gameHud = create("Frame", gui, { Name = "Game", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false })

local levelLabel = text(gameHud, "Level", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -20, 0, 70),
	Size = UDim2.fromOffset(340, 28),
	TextXAlignment = Enum.TextXAlignment.Right,
	TextColor3 = YELLOW,
})
local stationLabel = text(gameHud, "Station", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -20, 0, 100),
	Size = UDim2.fromOffset(340, 40),
	TextXAlignment = Enum.TextXAlignment.Right,
})
local checkpointLabel = text(gameHud, "Checkpoint", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -20, 0, 144),
	Size = UDim2.fromOffset(340, 22),
	TextXAlignment = Enum.TextXAlignment.Right,
	TextColor3 = GREEN,
})
local ruleLabel = text(gameHud, "Rule", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -20, 0, 170),
	Size = UDim2.fromOffset(460, 22),
	TextXAlignment = Enum.TextXAlignment.Right,
	TextColor3 = Color3.fromRGB(190, 190, 195),
})
local leaveButton = button(gameHud, "Leave", {
	Position = UDim2.fromOffset(20, 70),
	Size = UDim2.fromOffset(170, 38),
	BackgroundColor3 = Color3.fromRGB(60, 25, 25),
})

local votePanel = create("Frame", gameHud, {
	Name = "Vote",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(440, 70),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.25,
})
rounded(votePanel, 10)
local continueLabel = text(votePanel, "Continue", { Position = UDim2.fromScale(0.52, 0.1), Size = UDim2.fromScale(0.44, 0.45), TextColor3 = GREEN })
local backLabel = text(votePanel, "Back", { Position = UDim2.fromScale(0.04, 0.1), Size = UDim2.fromScale(0.44, 0.45), TextColor3 = RED })
local voteStatus = text(votePanel, "Status", { Position = UDim2.fromScale(0.04, 0.58), Size = UDim2.fromScale(0.92, 0.34), TextColor3 = Color3.fromRGB(210, 210, 215) })

-- ===== Lobby HUD (English) =====

local lobbyHud = create("Frame", gui, { Name = "Lobby", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })

local lobbyHint = text(lobbyHud, "Hint", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -30),
	Size = UDim2.fromOffset(560, 30),
	TextColor3 = Color3.fromRGB(220, 220, 220),
	TextStrokeTransparency = 0.5,
	Text = string.format("Walk onto a gate to play. Groups of %d-%d players.", Config.MinPartySize, Config.MaxPartySize),
})

local gatePanel = create("Frame", lobbyHud, {
	Name = "Gate",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(380, 230),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.15,
	Visible = false,
})
rounded(gatePanel, 12)
local gateTitle = text(gatePanel, "Title", { Position = UDim2.new(0, 16, 0, 12), Size = UDim2.new(1, -32, 0, 30), TextColor3 = YELLOW })
local gateStatus = text(gatePanel, "Status", { Position = UDim2.new(0, 16, 0, 46), Size = UDim2.new(1, -32, 0, 22), TextColor3 = Color3.fromRGB(200, 200, 205) })

local hostControls = create("Frame", gatePanel, { Name = "Host", Position = UDim2.new(0, 16, 0, 78), Size = UDim2.new(1, -32, 0, 140), BackgroundTransparency = 1 })
text(hostControls, "SizeLabel", { Size = UDim2.new(0.42, 0, 0, 34), Text = "Group size", TextXAlignment = Enum.TextXAlignment.Left })
local minus = button(hostControls, "Minus", { Position = UDim2.new(0.46, 0, 0, 0), Size = UDim2.new(0.16, 0, 0, 34), Text = "-" })
local sizeValue = text(hostControls, "Size", { Position = UDim2.new(0.64, 0, 0, 0), Size = UDim2.new(0.16, 0, 0, 34), Text = "4" })
local plus = button(hostControls, "Plus", { Position = UDim2.new(0.82, 0, 0, 0), Size = UDim2.new(0.18, 0, 0, 34), Text = "+" })

text(hostControls, "LanguageLabel", { Position = UDim2.new(0, 0, 0, 48), Size = UDim2.new(0.42, 0, 0, 34), Text = "Language", TextXAlignment = Enum.TextXAlignment.Left })
local arabic = button(hostControls, "Arabic", { Position = UDim2.new(0.46, 0, 0, 48), Size = UDim2.new(0.26, 0, 0, 34), Text = "العربية" })
local english = button(hostControls, "English", { Position = UDim2.new(0.74, 0, 0, 48), Size = UDim2.new(0.26, 0, 0, 34), Text = "English" })

local startButton = button(hostControls, "Start", {
	Position = UDim2.new(0, 0, 0, 96),
	Size = UDim2.new(1, 0, 0, 40),
	BackgroundColor3 = Color3.fromRGB(35, 120, 70),
	Text = "Start now",
	-- The camera is first person, which locks the mouse; a visible Modal button frees it so the
	-- host can click the controls.
	Modal = true,
})

-- ===== Messages and blackout =====

local messageLabel = text(gui, "Message", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.42),
	Size = UDim2.fromScale(0.7, 0.08),
	TextTransparency = 1,
	TextStrokeTransparency = 1,
	ZIndex = 3,
})

local blackout = create("Frame", gui, {
	Name = "Blackout",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BorderSizePixel = 0,
	BackgroundTransparency = if player:GetAttribute("Phase") == "Riding" then 0 else 1,
	ZIndex = 2,
})

gui.Parent = player:WaitForChild("PlayerGui")

-- ===== Refresh =====

local function attr(name: string, default: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function refresh()
	local phase = attr("Phase", "Lobby")
	local inGame = phase ~= "Lobby"
	gameHud.Visible = inGame
	lobbyHud.Visible = not inGame

	if inGame then
		local language = attr("Language", "en")
		local function t(key: string, ...: any): string
			return Strings.get(language, key, ...)
		end

		levelLabel.Text = t(if attr("Mood", "Calm") == "Horror" then "PhaseHorror" else "PhaseCalm")
		stationLabel.Text = t("HudLevel", attr("Level", 1), attr("TotalLevels", Config.TotalLevels))
		local checkpoint = attr("Checkpoint", 0)
		checkpointLabel.Visible = checkpoint > 0
		checkpointLabel.Text = t("HudCheckpoint", checkpoint)
		ruleLabel.Text = t("Rule")
		leaveButton.Text = if UserInputService.TouchEnabled then t("LeaveRun") else t("LeaveRun") .. "  [L]"

		-- Dead players spectate instead of voting.
		votePanel.Visible = phase == "Station" and not attr("Dead", false)
		local continueVotes, backVotes = attr("VotesContinue", 0), attr("VotesBack", 0)
		local voters, countdown = attr("Voters", 0), attr("VoteCountdown", -1)
		continueLabel.Text = t("VoteContinue", continueVotes)
		backLabel.Text = t("VoteBack", backVotes)
		if attr("VoteTie", false) then
			voteStatus.Text = t("VoteTie")
		elseif countdown >= 0 then
			voteStatus.Text = t("VoteCountdown", countdown)
		elseif continueVotes + backVotes == 0 then
			voteStatus.Text = t("VoteStandAtDoor")
		else
			voteStatus.Text = t("VoteWaiting", continueVotes + backVotes, voters)
		end
		return
	end

	local pad = attr("Pad", 0)
	local onGate = pad > 0
	gatePanel.Visible = onGate
	lobbyHint.Visible = not onGate
	if attr("PadFull", false) and not onGate then
		lobbyHint.Text = "This gate is full. Try another one."
	else
		lobbyHint.Text = string.format("Walk onto a gate to play. Groups of %d-%d players.", Config.MinPartySize, Config.MaxPartySize)
	end
	if not onGate then
		return
	end

	local count, size = attr("PadCount", 0), attr("PadMax", Config.DefaultPartySize)
	local language = attr("PadLanguage", "en")
	local countdown = attr("PadCountdown", -1)
	local isHost = attr("PadHost", false)

	gateTitle.Text = string.format("GATE %d  ·  %d / %d players", pad, count, size)
	if countdown >= 0 then
		gateStatus.Text = string.format("The train leaves in %d...", countdown)
	elseif isHost then
		gateStatus.Text = "You are the host. Pick the size and language."
	else
		gateStatus.Text = string.format("Waiting for the host  ·  %s", if language == "ar" then "Arabic" else "English")
	end

	hostControls.Visible = isHost
	gatePanel.Size = UDim2.fromOffset(380, if isHost then 230 else 84)
	sizeValue.Text = tostring(size)
	arabic.BackgroundColor3 = if language == "ar" then YELLOW else BUTTON
	arabic.TextColor3 = if language == "ar" then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
	english.BackgroundColor3 = if language == "en" then YELLOW else BUTTON
	english.TextColor3 = if language == "en" then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
end

player.AttributeChanged:Connect(refresh)
refresh()

minus.Activated:Connect(function()
	lobbyAction:FireServer("SetPartySize", attr("PadMax", Config.DefaultPartySize) - 1)
end)
plus.Activated:Connect(function()
	lobbyAction:FireServer("SetPartySize", attr("PadMax", Config.DefaultPartySize) + 1)
end)
arabic.Activated:Connect(function()
	lobbyAction:FireServer("SetLanguage", "ar")
end)
english.Activated:Connect(function()
	lobbyAction:FireServer("SetLanguage", "en")
end)
startButton.Activated:Connect(function()
	lobbyAction:FireServer("StartNow")
end)
leaveButton.Activated:Connect(function()
	lobbyAction:FireServer("LeaveRun")
end)



-- ===== Server moments =====

local messageToken = 0
local function showMessage(body: string, duration: number)
	messageToken += 1
	local token = messageToken
	messageLabel.Text = body
	TweenService:Create(messageLabel, TweenInfo.new(0.3), { TextTransparency = 0, TextStrokeTransparency = 0.5 }):Play()
	task.delay(duration, function()
		if token == messageToken then
			TweenService:Create(messageLabel, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

event.OnClientEvent:Connect(function(payload)
	if payload.Kind == "Fade" then
		local goal = if payload.Visible then 0 else 1
		TweenService:Create(blackout, TweenInfo.new(payload.Duration or 1), { BackgroundTransparency = goal }):Play()
	elseif payload.Kind == "Message" then
		showMessage(payload.Text, payload.Duration or 3)
	end
end)

-- First person locks the mouse on PC, so leaving also works from the keyboard: press L twice.
local leaveArmedUntil = 0
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.KeyCode ~= Enum.KeyCode.L or attr("Phase", "Lobby") == "Lobby" then
		return
	end
	if os.clock() < leaveArmedUntil then
		leaveArmedUntil = 0
		lobbyAction:FireServer("LeaveRun")
	else
		leaveArmedUntil = os.clock() + 2
		showMessage(Strings.get(attr("Language", "en"), "LeaveConfirm"), 2)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="37">
          <Properties>
            <string name="Name">Mood</string>
            <string name="Source"><![CDATA[-- Local look of the world, from the player's "Mood" attribute:
--   Lobby   bright, warm hall
--   Calm    levels 1-5: a normal, bright, slightly cheerful station
--   Horror  level 6 on: dark, cold and foggy, with a dim personal light so you can still see
-- Lighting changes made here only affect this player, so groups never fight over the look.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local TWEEN = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

local LOOKS = {
	Lobby = {
		Lighting = { Ambient = Color3.fromRGB(110, 108, 104), OutdoorAmbient = Color3.fromRGB(80, 80, 80), ExposureCompensation = 0.3 },
		SubwayAir = { Density = 0.08, Haze = 0, Color = Color3.fromRGB(200, 195, 185), Decay = Color3.fromRGB(150, 145, 135) },
		SubwayGrade = { Brightness = 0.02, Contrast = 0.05, Saturation = 0.1, TintColor = Color3.fromRGB(255, 250, 242) },
		SubwayBloom = { Intensity = 0.4, Size = 24, Threshold = 1.6 },
		PersonalLight = false,
	},
	Calm = {
		Lighting = { Ambient = Color3.fromRGB(120, 118, 112), OutdoorAmbient = Color3.fromRGB(80, 80, 80), ExposureCompensation = 0.35 },
		SubwayAir = { Density = 0.1, Haze = 0, Color = Color3.fromRGB(205, 200, 190), Decay = Color3.fromRGB(160, 155, 145) },
		SubwayGrade = { Brightness = 0.03, Contrast = 0.06, Saturation = 0.2, TintColor = Color3.fromRGB(255, 248, 236) },
		SubwayBloom = { Intensity = 0.5, Size = 24, Threshold = 1.5 },
		PersonalLight = false,
	},
	Horror = {
		Lighting = { Ambient = Color3.fromRGB(40, 40, 48), OutdoorAmbient = Color3.fromRGB(10, 10, 12), ExposureCompensation = 0 },
		SubwayAir = { Density = 0.32, Haze = 1.6, Color = Color3.fromRGB(22, 22, 28), Decay = Color3.fromRGB(12, 12, 15) },
		SubwayGrade = { Brightness = -0.02, Contrast = 0.18, Saturation = -0.4, TintColor = Color3.fromRGB(222, 230, 242) },
		SubwayBloom = { Intensity = 0.8, Size = 30, Threshold = 1.3 },
		PersonalLight = true,
	},
}

local personalLight: PointLight? = nil

local function updatePersonalLight(enabled: boolean)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local light = personalLight
	if not light or light.Parent ~= root then
		light = Instance.new("PointLight")
		light.Name = "PersonalLight"
		light.Color = Color3.fromRGB(200, 210, 230)
		light.Range = 14
		light.Brightness = 0.7
		light.Shadows = false
		light.Parent = root
		personalLight = light
	end
	light.Enabled = enabled
end

local function apply()
	local look = LOOKS[player:GetAttribute("Mood") or "Lobby"] or LOOKS.Lobby
	TweenService:Create(Lighting, TWEEN, look.Lighting):Play()
	for name, goal in look do
		local instance = Lighting:FindFirstChild(name)
		if instance and type(goal) == "table" then
			TweenService:Create(instance, TWEEN, goal):Play()
		end
	end
	updatePersonalLight(look.PersonalLight)
end

player:GetAttributeChangedSignal("Mood"):Connect(apply)
player.CharacterAdded:Connect(function(character)
	character:WaitForChild("HumanoidRootPart", 10)
	apply()
end)
-- The effects are created by the server; wait for them before the first look.
Lighting:WaitForChild("SubwayAir", 10)
Lighting:WaitForChild("SubwayGrade", 10)
Lighting:WaitForChild("SubwayBloom", 10)
apply()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="38">
          <Properties>
            <string name="Name">Spectate</string>
            <string name="Source"><![CDATA[-- When you die mid-game you stay dead and watch your living teammates, in third person, until
-- the whole group is dead (then everyone respawns at level 1). Tap the arrows or press Q / E to
-- switch who you watch.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "Spectate"
gui.ResetOnSpawn = false
gui.Enabled = false

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 70)
panel.Size = UDim2.fromOffset(460, 76)
panel.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
panel.BackgroundTransparency = 0.2
panel.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = panel

local function label(position: UDim2, size: UDim2, color: Color3): TextLabel
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Position = position
	text.Size = size
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.TextColor3 = color
	text.Parent = panel
	return text
end
local watching = label(UDim2.fromScale(0.14, 0.08), UDim2.fromScale(0.72, 0.5), Color3.fromRGB(230, 85, 75))
local hint = label(UDim2.fromScale(0.14, 0.6), UDim2.fromScale(0.72, 0.32), Color3.fromRGB(200, 200, 205))

local function arrow(text: string, x: number): TextButton
	local button = Instance.new("TextButton")
	button.Text = text
	button.Position = UDim2.fromScale(x, 0.15)
	button.Size = UDim2.fromScale(0.1, 0.7)
	button.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Font = Enum.Font.GothamBold
	button.TextScaled = true
	button.Parent = panel
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0, 8)
	round.Parent = button
	return button
end
local previous = arrow("<", 0.02)
local nextButton = arrow(">", 0.88)

gui.Parent = player:WaitForChild("PlayerGui")

local index = 1

local function teammates(): { Player }
	local key = player:GetAttribute("SessionKey")
	local list = {}
	for _, other in Players:GetPlayers() do
		local humanoid = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
		if other ~= player and other:GetAttribute("SessionKey") == key and humanoid and humanoid.Health > 0 then
			table.insert(list, other)
		end
	end
	return list
end

local function refresh()
	local camera = Workspace.CurrentCamera
	local dead = player:GetAttribute("Dead") == true and player:GetAttribute("Phase") ~= "Lobby"
	gui.Enabled = dead

	if not dead then
		-- Back to normal first person on your own character.
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
		return
	end

	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMaxZoomDistance = 20
	local language = player:GetAttribute("Language")
	hint.Text = Strings.get(language, "SpectateHint")

	local list = teammates()
	if #list == 0 then
		watching.Text = Strings.get(language, "Spectating", "...")
		return
	end
	index = (index - 1) % #list + 1
	local target = list[index]
	watching.Text = Strings.get(language, "Spectating", target.DisplayName)
	local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

previous.Activated:Connect(function()
	index -= 1
	refresh()
end)
nextButton.Activated:Connect(function()
	index += 1
	refresh()
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not gui.Enabled then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q then
		index -= 1
		refresh()
	elseif input.KeyCode == Enum.KeyCode.E then
		index += 1
		refresh()
	end
end)

player:GetAttributeChangedSignal("Dead"):Connect(refresh)
player:GetAttributeChangedSignal("Phase"):Connect(refresh)
player.CharacterAdded:Connect(function()
	task.wait()
	refresh()
end)

-- Re-check now and then: the teammate you watch may die too, or the stations may change.
while true do
	task.wait(1)
	if gui.Enabled then
		refresh()
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="39">
          <Properties>
            <string name="Name">Sprint</string>
            <string name="Source"><![CDATA[-- Sprinting. PC: hold Shift. Mobile: a button on screen toggles between sprint and walk.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer

local shiftHeld = false
local toggledOn = false

local function language()
	return if player:GetAttribute("Phase") == "Lobby" then "en" else player:GetAttribute("Language")
end

local function apply()
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = if shiftHeld or toggledOn then Config.SprintSpeed else Config.WalkSpeed
	end
end

UserInputService.InputBegan:Connect(function(input)
	-- Shift can arrive marked as "processed" by Roblox's own controls, so only skip typing.
	if UserInputService:GetFocusedTextBox() then
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		shiftHeld = true
		apply()
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		shiftHeld = false
		apply()
	end
end)
player.CharacterAdded:Connect(function(character)
	character:WaitForChild("Humanoid", 10)
	apply()
end)

-- Mobile button, just above the jump button.
if UserInputService.TouchEnabled then
	local gui = Instance.new("ScreenGui")
	gui.Name = "SprintButton"
	gui.ResetOnSpawn = false

	local button = Instance.new("TextButton")
	button.AnchorPoint = Vector2.new(1, 1)
	button.Position = UDim2.new(1, -30, 1, -170)
	button.Size = UDim2.fromOffset(84, 84)
	button.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
	button.BackgroundTransparency = 0.3
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Font = Enum.Font.GothamBold
	button.TextScaled = true
	button.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = button
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.15, 0)
	padding.PaddingRight = UDim.new(0.15, 0)
	padding.Parent = button

	local function refresh()
		-- The button shows what tapping it will do.
		button.Text = Strings.get(language(), if toggledOn then "Walk" else "Sprint")
		button.BackgroundColor3 = if toggledOn then Color3.fromRGB(200, 150, 20) else Color3.fromRGB(30, 30, 36)
	end

	button.Activated:Connect(function()
		toggledOn = not toggledOn
		refresh()
		apply()
	end)
	player:GetAttributeChangedSignal("Language"):Connect(refresh)
	player:GetAttributeChangedSignal("Phase"):Connect(refresh)
	refresh()
	gui.Parent = player:WaitForChild("PlayerGui")
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>