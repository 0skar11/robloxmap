        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">ExtraPassenger</string>
            <string name="Source"><![CDATA[-- Someone new is on the platform, standing with their face to the wall.
local Mannequin = require(script.Parent.Parent.Mannequin)
local MapBuilder = require(script.Parent.Parent.MapBuilder)

local SPOTS = {
	{ X = -50, Z = -8.5 },
	{ X = 50, Z = -8.5 },
	{ X = -24, Z = -8.5 },
	{ X = 22, Z = 6 },
}

return {
	Name = "ExtraPassenger",
	Apply = function(ctx)
		local spot = ctx:Pick(SPOTS)
		-- Facing -Z means facing the back wall.
		local pivot = MapBuilder.at(spot.X, 3, spot.Z)
		ctx:Add(Mannequin.create("Stranger", "Stand", pivot, Color3.fromRGB(30, 30, 32)))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">FlickeringLight</string>
            <string name="Source"><![CDATA[-- One ceiling light keeps flickering.
return {
	Name = "FlickeringLight",
	Apply = function(ctx)
		local fixture = ctx:Pick(ctx.Refs.Lights)
		local light = fixture:FindFirstChildOfClass("SurfaceLight")

		-- Record the originals first so Restore turns the light back on.
		ctx:Set(fixture, "Material", fixture.Material)
		ctx:Set(light, "Enabled", true)

		ctx:Spawn(function()
			while true do
				local on = ctx.Random:NextNumber() > 0.35
				light.Enabled = on
				fixture.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
				task.wait(ctx.Random:NextNumber(0.05, 0.4))
			end
		end)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">MissingPassenger</string>
            <string name="Source"><![CDATA[-- One of the passengers is gone.
return {
	Name = "MissingPassenger",
	Apply = function(ctx)
		ctx:Set(ctx:Pick(ctx.Refs.Passengers), "Parent", nil)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">MissingPillar</string>
            <string name="Source"><![CDATA[-- One of the pillars is missing. The middle one stays: the flowers lean on it.
return {
	Name = "MissingPillar",
	Apply = function(ctx)
		local candidates = {}
		for _, pillar in ctx.Refs.Pillars do
			if pillar:GetAttribute("X") ~= 0 then
				table.insert(candidates, pillar)
			end
		end
		ctx:Set(ctx:Pick(candidates), "Parent", nil)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">NamedPoster</string>
            <string name="Source"><![CDATA[-- An advertisement now carries one of the players' names.
return {
	Name = "NamedPoster",
	Apply = function(ctx)
		local name = if #ctx.Players > 0 then ctx:Pick(ctx.Players).DisplayName else "محمد"
		ctx:Set(ctx:Pick(ctx.Refs.Posters), "Text", name .. "\nمتنساش تنزل هنا")
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">StaringPassengers</string>
            <string name="Source"><![CDATA[-- Every passenger's head slowly follows the nearest player.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local TURN_SPEED = 3

local function nearestHead(position: Vector3): Vector3?
	local best, bestDistance = nil, math.huge
	for _, player in Players:GetPlayers() do
		local head = player.Character and player.Character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			local distance = (head.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = head.Position, distance
			end
		end
	end
	return best
end

return {
	Name = "StaringPassengers",
	Apply = function(ctx)
		local heads = {}
		for _, passenger in ctx.Refs.Passengers do
			local head = passenger:FindFirstChild("Head")
			-- Record the resting pose; the loop below moves the head directly.
			ctx:Set(head, "CFrame", head.CFrame)
			table.insert(heads, head)
		end

		ctx:Connect(RunService.Heartbeat, function(dt)
			for _, head in heads do
				local target = nearestHead(head.Position)
				if target then
					local goal = CFrame.lookAt(head.Position, target)
					head.CFrame = head.CFrame:Lerp(goal, math.min(1, dt * TURN_SPEED))
				end
			end
		end)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
