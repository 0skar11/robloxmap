      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Tuning values for Endless Subway. Shared so the HUD can read the same numbers as the server.

local Config = {}

-- Levels. Each level is one stop of the train.
--   Levels 1-5: a normal, bright station with small spot-the-difference changes.
--   Level 5 is a checkpoint: a mistake after it sends the group back to level 6, not level 1.
--   Level 6 on: the lights die, the hints appear, and the strange things start.
Config.TotalLevels = 15
Config.Checkpoints = { 5 }
Config.HorrorStartsAtLevel = 6

-- These levels never have an anomaly, so players can learn what "normal" looks like
-- (once in the bright station, once in the dark one).
Config.AlwaysNormalLevels = { 1, 6 }

-- The GO BACK door only exists from this level on. Level 1 is always safe, so there is
-- nothing to go back from.
Config.BackDoorFromLevel = 2

-- Chance that any other level carries an anomaly.
Config.AnomalyChance = 0.6

-- Bright levels use only the mild anomalies. Set false to make levels 1-5 never change at all.
Config.CalmAnomalies = true

-- Once every player stands at a door and there is a clear majority, this countdown starts.
Config.VoteConfirmSeconds = 3

-- No time limit: everyone thinks as long as they like, and nothing is ever chosen for them.
-- Set a number of seconds to force a decision after the first vote (ties then go to a coin flip).
Config.VoteTimeoutSeconds = nil :: number?

-- Screen fade and the "riding in the dark" pause between stations.
Config.FadeSeconds = 1
Config.BlackoutSeconds = 2

-- Prints the active anomaly to the server output. Handy while testing, spoils the game otherwise.
Config.Debug = false

-- Lobby: groups of 1 to 10 players gather on a gate, then go play together.
Config.MinPartySize = 1
Config.MaxPartySize = 10
Config.DefaultPartySize = 4
Config.LobbyPads = 6
Config.LobbyCountdownSeconds = 5

-- In the live game, the lobby and every group's game run in separate servers: a gate teleports
-- its group to a private server of this same place. Roblox Studio cannot teleport, so there
-- everything runs in one server (each group still gets its own station copy).
Config.UseSeparateServers = true

-- How long a game server waits for the whole group to arrive before starting anyway.
Config.GroupArrivalTimeout = 20

-- Each local group's station is built this far from the previous one along X.
Config.StationSpacing = 1000

-- NPCs wear their fixed avatars (see Server/NpcOutfits). Set false to use plain block mannequins.
Config.AvatarNpcs = true

-- Movement. PC: hold Shift to sprint. Mobile: a button on screen toggles sprint.
Config.WalkSpeed = 16
Config.SprintSpeed = 26

-- Station lights for the two halves of the game.
Config.Moods = {
	Calm = {
		LightColor = Color3.fromRGB(255, 246, 228),
		LightBrightness = 1.45,
	},
	Horror = {
		LightColor = Color3.fromRGB(255, 205, 160),
		LightBrightness = 0.65,
	},
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Shared networking. The server owns the remotes; game state is published as attributes on each
-- Player, so every player's HUD only shows their own group.
--
-- Player attributes:
--   Phase            "Lobby" | "Riding" (screen dark, between stations) | "Station" (doors open)
--   Mood             "Lobby" | "Calm" (levels 1-5, bright) | "Horror" (dark) - drives the local look
--   Language         "ar" | "en" for the player's session ("en" in the lobby)
--   Level, TotalLevels, Checkpoint (0 = none yet)
--   BackDoor         false while the GO BACK door does not exist yet (level 1)
--   Dead             true while spectating after dying mid-game
--   SessionKey       same value for everyone in one group (spectators find teammates by it)
--   VotesContinue, VotesBack, Voters
--   VoteCountdown    seconds before the vote locks in, -1 when no countdown is running
--   VoteTie          true when everyone voted and the doors are tied
--   Pad              lobby gate the player stands on and belongs to (0 = none)
--   PadHost          true for the player who picks the group size and language
--   PadCount, PadMax, PadLanguage   members on the gate, chosen group size and language
--   PadCountdown     seconds before the group leaves, -1 when not counting down
--   PadFull          standing on a gate that is already full
--
-- Remotes:
--   GameEvent    server -> client  { Kind = "Fade", Visible, Duration } | { Kind = "Message", Text, Duration }
--   LobbyAction  client -> server  ("SetPartySize", n) | ("SetLanguage", "ar" | "en") | ("StartNow") | ("LeaveRun")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "EndlessSubwayNet"

local Net = {}

function Net.folder(): Folder
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing then
			return existing :: Folder
		end

		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		for _, name in { "GameEvent", "LobbyAction" } do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		folder.Parent = ReplicatedStorage
		return folder
	end

	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

function Net.event(): RemoteEvent
	return Net.folder():WaitForChild("GameEvent") :: RemoteEvent
end

function Net.lobbyAction(): RemoteEvent
	return Net.folder():WaitForChild("LobbyAction") :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Strings</string>
          <string name="Source"><![CDATA[-- Every piece of in-game text, in Arabic and English. The lobby is always English; each group's
-- host picks the language of their own session (station signs, posters, HUD, messages).
--
-- Strings.get(language, key, ...) formats the text with string.format when arguments are given.

export type Language = "ar" | "en"

local TEXT: { [string]: { [string]: any } } = {
	en = {
		-- Station
		StationName = "Al-Nour Station",
		DoorContinue = "CONTINUE",
		DoorBack = "GO BACK",
		Counter = "LEVEL\n%d / %d",
		Newspaper = "METRO DAILY\n%s",
		MissedCalls = "%d missed calls",
		Vending = "DRINKS",
		NamedPoster = "%s\nDon't miss your stop",
		Posters = {
			"SPEED ENERGY\nFor the last train",
			"AL-NOUR HOMES\nPay over 10 years",
			"MESHWAR APP\nYour ride is on us",
			"METRO MUSEUM\nOpening soon",
			"LINE 14\nWe never stop",
			"NIGHT PHARMACY\nOpen 24 hours",
			"LOST SOMEONE?\nCall 14 14 14",
		},
		Months = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" },

		-- HUD
		Rule = "Normal station -> CONTINUE.  Something wrong -> GO BACK.",
		RuleFirst = "The first station is always safe. Look around, then go to CONTINUE.",
		TutorialTitle = "How to play",
		TutorialBody = table.concat({
			"The train keeps stopping at the same station.",
			"Look at everything: the clock, the signs, the passengers, the benches...",
			"If you find something different (a stopped clock, a missing passenger, a wrong number), there is a problem: go to GO BACK.",
			"If everything is normal: go to CONTINUE.",
			"This first station is always safe. Remember how it looks.",
		}, "\n\n"),
		TutorialHorrorTitle = "Careful...",
		TutorialHorrorBody = table.concat({
			"From here the station gets dark, and stranger things happen.",
			"If a dark figure walks toward you, run (hold Shift, or tap Sprint). If it touches you, you die and watch your friends.",
			"If the whole group dies, everyone goes back to Level 1.",
		}, "\n\n"),
		TutorialOk = "Got it",
		PhaseCalm = "The Last Train",
		PhaseHorror = "Something Is Wrong",
		HudLevel = "Level %d / %d",
		HudCheckpoint = "Checkpoint: Level %d",
		Sprint = "Sprint",
		Walk = "Walk",
		VoteContinue = "Continue: %d",
		VoteBack = "Go back: %d",
		VoteTie = "Tie! You need a majority",
		VoteCountdown = "Deciding in %d...",
		VoteStandAtDoor = "Stand in front of the door you choose",
		VoteWaiting = "Waiting for the others (%d / %d)",
		LeaveRun = "Back to lobby",
		LeaveConfirm = "Press L again to go back to the lobby",

		-- Messages
		CoinFlip = "Tie... a coin flip chose \"%s\"",
		Wrong = "Wrong... back to Level %d",
		CheckpointReached = "CHECKPOINT! Mistakes now send you back to Level %d",
		HorrorBegins = "The lights are going out... something is wrong",
		Wiped = "Everyone is dead... back to Level 1",
		Spectating = "You died. Watching %s",
		SpectateHint = "Waiting until the whole group is gone",
		Ending = "You reached the end... (the final scene is still being built)",
	},

	ar = {
		StationName = "محطة النور",
		DoorContinue = "كمّل",
		DoorBack = "ارجع",
		Counter = "LEVEL\n%d / %d",
		Newspaper = "جريدة المترو\n%s",
		MissedCalls = "%d مكالمة فايتة",
		Vending = "مشروبات",
		NamedPoster = "%s\nمتنساش تنزل هنا",
		Posters = {
			"مشروب سبيد\nطاقة لآخر الليل",
			"شقق النور\nقسّط على 10 سنين",
			"تطبيق مشوار\nمشوارك علينا",
			"متحف المترو\nافتتاح قريبًا",
			"الخط 14\nإحنا مبنقفش",
			"صيدلية الليل\nمفتوحة 24 ساعة",
			"فقدت حد؟\nكلمنا 14 14 14",
		},
		Months = { "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" },

		Rule = "المحطة طبيعية ← كمّل.  فيها حاجة غلط ← ارجع.",
		RuleFirst = "أول محطة دايمًا أمان. بص حواليك، وبعدين روح لباب كمّل.",
		TutorialTitle = "إزاي تلعب",
		TutorialBody = table.concat({
			"القطر بيفضل يقف في نفس المحطة كل مرة.",
			"بص على كل حاجة: الساعة، واللافتات، والركاب، والكراسي...",
			"لو لقيت حاجة مختلفة (ساعة واقفة، راكب ناقص، رقم غلط) يبقى فيه مشكلة: روح لباب ارجع.",
			"لو كل حاجة طبيعية: روح لباب كمّل.",
			"أول محطة دي دايمًا أمان. احفظ شكلها.",
		}, "\n\n"),
		TutorialHorrorTitle = "خلي بالك...",
		TutorialHorrorBody = table.concat({
			"من هنا المحطة بتضلم، وبتحصل حاجات أغرب.",
			"لو شخص أسود مشي ناحيتك، اجري (دوس Shift، أو زرار جري). لو لمسك هتموت وتتفرج على صحابك.",
			"لو المجموعة كلها ماتت، كلكم بترجعوا لـ Level 1.",
		}, "\n\n"),
		TutorialOk = "فهمت",
		PhaseCalm = "آخر قطر",
		PhaseHorror = "فيه حاجة غلط",
		HudLevel = "Level %d / %d",
		HudCheckpoint = "نقطة الحفظ: Level %d",
		Sprint = "جري",
		Walk = "مشي",
		VoteContinue = "كمّل: %d",
		VoteBack = "ارجع: %d",
		VoteTie = "تعادل! لازم أغلبية",
		VoteCountdown = "القرار خلال %d…",
		VoteStandAtDoor = "اقف قدام الباب اللي تختاره",
		VoteWaiting = "مستنيين الباقيين (%d / %d)",
		LeaveRun = "ارجع للوبي",
		LeaveConfirm = "دوس L تاني عشان ترجع للوبي",

		CoinFlip = "تعادل… القرعة اختارت \"%s\"",
		Wrong = "غلط… رجعتوا لـ Level %d",
		CheckpointReached = "Checkpoint! لو غلطتوا من هنا هترجعوا لـ Level %d",
		HorrorBegins = "النور بيطفي… فيه حاجة غلط",
		Wiped = "كلكم متّوا… رجعتوا لـ Level 1",
		Spectating = "انت مت. بتتفرج على %s",
		SpectateHint = "مستني لحد ما المجموعة كلها تموت",
		Ending = "وصلتوا للنهاية… (المشهد الأخير لسه بيتبني)",
	},
}

local Strings = {}

function Strings.normalize(language: any): Language
	return if language == "ar" then "ar" else "en"
end

function Strings.get(language: any, key: string, ...: any): any
	local value = TEXT[Strings.normalize(language)][key]
	if value == nil then
		value = TEXT.en[key]
	end
	if value == nil then
		return key
	end
	if select("#", ...) > 0 then
		return string.format(value, ...)
	end
	return value
end

-- Tomorrow's date, written the way the language writes dates.
function Strings.tomorrow(language: any): string
	local date = os.date("*t", os.time() + 24 * 60 * 60)
	local month = Strings.get(language, "Months")[date.month]
	if Strings.normalize(language) == "ar" then
		return string.format("%d %s %d", date.day, month, date.year)
	end
	return string.format("%s %d, %d", month, date.day, date.year)
end

return Strings
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">Anomalies</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">ExtraMissedCall</string>
            <string name="Source"><![CDATA[-- The phone on the floor now shows 13 missed calls instead of 12.
return {
	Name = "ExtraMissedCall",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		ctx:Set(ctx.Refs.PhoneLabel, "Text", ctx:Text("MissedCalls", 13))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">ExtraPassenger</string>
            <string name="Source"><![CDATA[-- Someone new is on the platform: a faceless figure standing with their face to the wall.
local Mannequin = require(script.Parent.Parent.Mannequin)

local SPOTS = {
	{ X = -85, Z = -8.5 },
	{ X = 85, Z = -8.5 },
	{ X = -24, Z = -8.5 },
	{ X = 22, Z = 6 },
	{ X = -56, Z = 6 },
}

return {
	Name = "ExtraPassenger",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		local spot = ctx:Pick(SPOTS)
		-- Facing -Z means facing the back wall.
		local pivot = ctx.Refs.At(spot.X, 3, spot.Z)
		ctx:Add(Mannequin.create("Stranger", "Stand", pivot, Color3.fromRGB(20, 20, 22)))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">FlickeringLight</string>
            <string name="Source"><![CDATA[-- One ceiling light keeps flickering.
return {
	Name = "FlickeringLight",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		-- Only a light that is still working can flicker.
		local working = {}
		for _, candidate in ctx.Refs.Lights do
			local surfaceLight = candidate:FindFirstChildOfClass("SurfaceLight")
			if surfaceLight and surfaceLight.Enabled then
				table.insert(working, candidate)
			end
		end
		local fixture = ctx:Pick(working)
		local light = fixture:FindFirstChildOfClass("SurfaceLight")

		-- Record the originals first so Restore turns the light back on.
		ctx:Set(fixture, "Material", fixture.Material)
		ctx:Set(light, "Enabled", true)

		ctx:Spawn(function()
			while true do
				local on = ctx.Random:NextNumber() > 0.35
				light.Enabled = on
				fixture.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
				task.wait(ctx.Random:NextNumber(0.05, 0.4))
			end
		end)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">MissingDriver</string>
            <string name="Source"><![CDATA[-- The train is standing at the platform, but nobody is in the driver's seat.
return {
	Name = "MissingDriver",
	Apply = function(ctx)
		ctx:Hide(ctx.Refs.Driver)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MissingPassenger</string>
            <string name="Source"><![CDATA[-- One of the passengers is gone.
return {
	Name = "MissingPassenger",
	Apply = function(ctx)
		ctx:Hide(ctx:Pick(ctx.Refs.Passengers))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">MissingPillar</string>
            <string name="Source"><![CDATA[-- One of the pillars is missing. The middle one stays: the flowers lean on it.
return {
	Name = "MissingPillar",
	Apply = function(ctx)
		local candidates = {}
		for _, pillar in ctx.Refs.Pillars do
			if pillar:GetAttribute("X") ~= 0 then
				table.insert(candidates, pillar)
			end
		end
		ctx:Set(ctx:Pick(candidates), "Parent", nil)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">NamedPoster</string>
            <string name="Source"><![CDATA[-- An advertisement now carries one of the players' names.
return {
	Name = "NamedPoster",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		local name = if #ctx.Players > 0 then ctx:Pick(ctx.Players).DisplayName else "???"
		ctx:Set(ctx:Pick(ctx.Refs.Posters), "Text", ctx:Text("NamedPoster", name))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">StaringPassengers</string>
            <string name="Source"><![CDATA[-- Every passenger slowly turns their head to follow the nearest player.
local RunService = game:GetService("RunService")

local TURN_SPEED = 3
local MAX_TURN = math.rad(75)

local function nearestHead(players: { Player }, position: Vector3): Vector3?
	local best, bestDistance = nil, math.huge
	for _, player in players do
		local head = player.Character and player.Character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			local distance = (head.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = head.Position, distance
			end
		end
	end
	return best
end

return {
	Name = "StaringPassengers",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		-- Avatars turn their neck joint; block mannequins turn the head part itself.
		local necks, heads = {}, {}
		for _, passenger in ctx.Refs.Passengers do
			local head = passenger:FindFirstChild("Head", true)
			local neck = head and head:FindFirstChild("Neck")
			if neck and neck:IsA("Motor6D") and neck.Part0 then
				ctx:Set(neck, "C0", neck.C0)
				table.insert(necks, { Joint = neck, Rest = neck.C0, Yaw = 0 })
			elseif head and head:IsA("BasePart") then
				ctx:Set(head, "CFrame", head.CFrame)
				table.insert(heads, head)
			end
		end

		ctx:Connect(RunService.Heartbeat, function(dt: number)
			local blend = math.min(1, dt * TURN_SPEED)
			for _, neck in necks do
				local target = nearestHead(ctx.Players, neck.Joint.Part1.Position)
				if target then
					local relative = neck.Joint.Part0.CFrame:PointToObjectSpace(target)
					local goal = math.clamp(math.atan2(-relative.X, -relative.Z), -MAX_TURN, MAX_TURN)
					neck.Yaw += (goal - neck.Yaw) * blend
					neck.Joint.C0 = neck.Rest * CFrame.Angles(0, neck.Yaw, 0)
				end
			end
			for _, head in heads do
				local target = nearestHead(ctx.Players, head.Position)
				if target then
					head.CFrame = head.CFrame:Lerp(CFrame.lookAt(head.Position, target), blend)
				end
			end
		end)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">StoppedClock</string>
            <string name="Source"><![CDATA[-- The station clock is stuck on the time the train arrives and never ticks.
return {
	Name = "StoppedClock",
	Apply = function(ctx)
		ctx:SetAttribute(ctx.Refs.Clock, "Frozen", true)
		ctx:Set(ctx.Refs.ClockLabel, "Text", "23:57:00")
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">TheFollower</string>
            <string name="Source"><![CDATA[-- A faceless figure steps out at the far end of the platform and slowly walks toward the nearest
-- living player. If it reaches you, you die (and spectate until your group is gone). It is slower
-- than walking, so you can always get away; the safe answer is to GO BACK.
local RunService = game:GetService("RunService")

local Mannequin = require(script.Parent.Parent.Mannequin)

local SPEED = 7
local REACH = 3
local SPOTS = { -88, 88 }

local function nearestRoot(players: { Player }, position: Vector3): BasePart?
	local best, bestDistance = nil, math.huge
	for _, player in players do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
			local distance = (root.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = root, distance
			end
		end
	end
	return best
end

return {
	Name = "TheFollower",
	-- Scary: only in the dark half of the game.
	Horror = true,
	Apply = function(ctx)
		local x = ctx:Pick(SPOTS)
		local start = ctx.Refs.At(x, 3, 0)
		local follower = Mannequin.create("Follower", "Stand", start, Color3.fromRGB(12, 12, 14)) :: Model
		for _, part in follower:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
		ctx:Add(follower)

		-- Stays on the platform floor (Y fixed, Z clamped to the platform).
		local floorY = start.Position.Y
		local minZ = ctx.Refs.At(0, 0, -8).Position.Z
		local maxZ = ctx.Refs.At(0, 0, 9).Position.Z

		-- Waits a few seconds before it starts walking, so players can see it first.
		local wakeAt = os.clock() + 4
		ctx:Connect(RunService.Heartbeat, function(dt: number)
			if os.clock() < wakeAt then
				return
			end
			local here = follower:GetPivot().Position
			local target = nearestRoot(ctx.Players, here)
			if not target then
				return
			end

			local flat = Vector3.new(target.Position.X, floorY, target.Position.Z)
			local offset = flat - here
			if offset.Magnitude <= REACH then
				local humanoid = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.Health = 0
				end
				return
			end

			local step = offset.Unit * math.min(offset.Magnitude, SPEED * dt)
			local nextPosition = here + step
			nextPosition = Vector3.new(nextPosition.X, floorY, math.clamp(nextPosition.Z, minZ, maxZ))
			follower:PivotTo(CFrame.lookAt(nextPosition, Vector3.new(flat.X, floorY, flat.Z)))
		end)
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">TurnedBench</string>
            <string name="Source"><![CDATA[-- The empty bench has been turned to face the wall.
return {
	Name = "TurnedBench",
	Apply = function(ctx)
		local candidates = {}
		for _, bench in ctx.Refs.Benches do
			if bench:GetAttribute("Free") then
				table.insert(candidates, bench)
			end
		end
		local bench = ctx:Pick(candidates)
		ctx:Pivot(bench, bench:GetPivot() * CFrame.Angles(0, math.pi, 0))
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">WrongLineNumber</string>
            <string name="Source"><![CDATA[-- The line badge reads 41 instead of 14.
return {
	Name = "WrongLineNumber",
	Apply = function(ctx)
		ctx:Set(ctx.Refs.LineBadge, "Text", "41")
	end,
	Reset = function(ctx)
		ctx:Restore()
	end,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">AnomalyContext</string>
          <string name="Source"><![CDATA[-- Handed to an anomaly's Apply and Reset. Every change made through it is recorded, so
-- ctx:Restore() puts the station back exactly as it was, whatever the anomaly did.
--
--   ctx.Refs        everything MapBuilder.build() returned (lights, posters, passengers, ...)
--   ctx.Players     the group's players when the station started
--   ctx.Random      a Random object, so a station can be replayed from its seed
--
--   ctx:Set(instance, property, value)       change a property (Parent = nil hides something)
--   ctx:SetAttribute(instance, name, value)  change an attribute
--   ctx:Pivot(model, cframe)                 move a model
--   ctx:Hide(instance)                       make something invisible and walk-through
--   ctx:Add(instance, parent?)               add something new; destroyed on restore
--   ctx:Connect(signal, callback)            disconnected on restore
--   ctx:Spawn(callback)                      a thread that is cancelled on restore
--   ctx:Pick(list)                           random element of a list
--   ctx:Text(key, ...)                       text in the group's language (see Shared/Strings)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Strings = require(ReplicatedStorage.Shared.Strings)

local AnomalyContext = {}
AnomalyContext.__index = AnomalyContext

export type Context = typeof(setmetatable(
	{} :: {
		Refs: any,
		Players: { Player },
		Random: Random,
		_undo: { () -> () },
	},
	AnomalyContext
))

function AnomalyContext.new(refs: any, players: { Player }, random: Random): Context
	return setmetatable({
		Refs = refs,
		Players = players,
		Random = random,
		_undo = {},
	}, AnomalyContext)
end

function AnomalyContext.Set(self: Context, instance: Instance, property: string, value: any)
	local target = instance :: any
	local original = target[property]
	table.insert(self._undo, function()
		target[property] = original
	end)
	target[property] = value
end

function AnomalyContext.SetAttribute(self: Context, instance: Instance, name: string, value: any)
	local original = instance:GetAttribute(name)
	table.insert(self._undo, function()
		instance:SetAttribute(name, original)
	end)
	instance:SetAttribute(name, value)
end

function AnomalyContext.Pivot(self: Context, model: PVInstance, cframe: CFrame)
	local original = model:GetPivot()
	table.insert(self._undo, function()
		model:PivotTo(original)
	end)
	model:PivotTo(cframe)
end

-- Hides a model without removing it, so a seated avatar keeps its pose when it comes back.
function AnomalyContext.Hide(self: Context, instance: Instance)
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") then
			self:Set(descendant, "Transparency", 1)
			self:Set(descendant, "CanCollide", false)
			self:Set(descendant, "CastShadow", false)
		elseif descendant:IsA("Decal") then
			self:Set(descendant, "Transparency", 1)
		elseif descendant:IsA("SurfaceGui") or descendant:IsA("Light") then
			self:Set(descendant, "Enabled", false)
		end
	end
end

function AnomalyContext.Add(self: Context, instance: Instance, parent: Instance?): Instance
	table.insert(self._undo, function()
		instance:Destroy()
	end)
	instance.Parent = parent or self.Refs.Station
	return instance
end

function AnomalyContext.Connect(self: Context, signal: RBXScriptSignal, callback: (...any) -> ()): RBXScriptConnection
	local connection = signal:Connect(callback)
	table.insert(self._undo, function()
		connection:Disconnect()
	end)
	return connection
end

function AnomalyContext.Spawn(self: Context, callback: () -> ()): thread
	local thread = task.spawn(callback)
	table.insert(self._undo, function()
		if coroutine.status(thread) ~= "dead" then
			task.cancel(thread)
		end
	end)
	return thread
end

function AnomalyContext.Pick<T>(self: Context, list: { T }): T
	return list[self.Random:NextInteger(1, #list)]
end

function AnomalyContext.Text(self: Context, key: string, ...: any): string
	return Strings.get(self.Refs.Language, key, ...)
end

-- Undoes everything in reverse order, so stacked changes to one property unwind correctly.
function AnomalyContext.Restore(self: Context)
	for i = #self._undo, 1, -1 do
		local ok, err = pcall(self._undo[i])
		if not ok then
			warn("[EndlessSubway] restore step failed:", err)
		end
	end
	table.clear(self._undo)
end

return AnomalyContext
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">AnomalyRegistry</string>
          <string name="Source"><![CDATA[-- Loads every ModuleScript in the Anomalies folder. To add an anomaly, drop a new module there:
--
--   return {
--       Name = "MyAnomaly",
--       Horror = true,  -- optional: only from Config.HorrorStartsAtLevel on
--       Apply = function(ctx) ctx:Set(ctx.Refs.LineBadge, "Text", "41") end,
--       Reset = function(ctx) ctx:Restore() end,
--   }

export type Anomaly = {
	Name: string,
	Horror: boolean?, -- true: only in the dark half of the game
	Apply: (ctx: any) -> (),
	Reset: (ctx: any) -> (),
}

local AnomalyRegistry = {}

function AnomalyRegistry.load(): { Anomaly }
	local anomalies = {}
	for _, module in script.Parent.Anomalies:GetChildren() do
		if not module:IsA("ModuleScript") then
			continue
		end

		local ok, anomaly = pcall(require, module)
		if not ok or type(anomaly) ~= "table" or type(anomaly.Apply) ~= "function" then
			warn("[EndlessSubway] skipping anomaly", module.Name, if ok then "(no Apply function)" else anomaly)
			continue
		end

		anomaly.Name = anomaly.Name or module.Name
		anomaly.Reset = anomaly.Reset or function(ctx)
			ctx:Restore()
		end
		table.insert(anomalies, anomaly)
	end

	table.sort(anomalies, function(a, b)
		return a.Name < b.Name
	end)
	return anomalies
end

return AnomalyRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[-- Small helpers for building maps out of plain anchored parts.

local Build = {}

function Build.block(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

function Build.invisibleWall(parent: Instance, name: string, size: Vector3, cframe: CFrame): Part
	local part = Build.block(parent, name, size, cframe, Color3.new(0, 0, 0))
	part.Transparency = 1
	part.CastShadow = false
	return part
end

export type TextOptions = {
	Background: Color3?,
	TextColor: Color3?,
	Glow: boolean?,
	PixelsPerStud: number?,
}

-- Puts a scaled TextLabel on one face of a part and returns the label.
function Build.surfaceText(target: BasePart, face: Enum.NormalId, text: string, options: TextOptions?): TextLabel
	local opts: TextOptions = options or {}

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Display"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.PixelsPerStud or 40
	gui.LightInfluence = if opts.Glow then 0 else 1
	gui.Parent = target

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = opts.Background or Color3.new(1, 1, 1)
	label.BackgroundTransparency = if opts.Background then 0 else 1
	label.BorderSizePixel = 0
	label.TextColor3 = opts.TextColor or Color3.new(1, 1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = text
	label.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label

	return label
end

-- A ceiling fixture: a thin neon strip with a light shining down.
function Build.ceilingLight(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, brightness: number, range: number): Part
	local fixture = Build.block(parent, name, size, cframe, color, Enum.Material.Neon)
	fixture.CastShadow = false
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = range
	light.Angle = 120
	light.Color = color
	light.Brightness = brightness
	light.Shadows = true
	light.Parent = fixture
	return fixture
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">GameLoop</string>
          <string name="Source"><![CDATA[-- One group's game: the train stops, the players look around, they vote on a door, the screen goes
-- dark, and the same station comes back one level further (or not).
--
-- Rule: a normal station means "Continue"; a station with something wrong means "Back".
--   Right call  -> next level.
--   Wrong call  -> back to the level after the last checkpoint (level 1 before any checkpoint).
--   Everyone dead -> everyone respawns at level 1.
-- Levels 1-5 are the bright, calm station; from Config.HorrorStartsAtLevel the lights die and the
-- hints appear.
--
-- run() returns when the group is gone or has reached the end; SessionManager cleans up.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Strings = require(ReplicatedStorage.Shared.Strings)
local AnomalyContext = require(script.Parent.AnomalyContext)
local AnomalyRegistry = require(script.Parent.AnomalyRegistry)
local VoteManager = require(script.Parent.VoteManager)

local CLOCK_START_SECONDS = 23 * 3600 + 57 * 60
local DOOR_TWEEN = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
local DEAD_LIGHT = Color3.fromRGB(60, 60, 58)

local GameLoop = {}

local function setDoors(refs, open: boolean)
	for _, panel in refs.DoorPanels do
		TweenService:Create(panel.Part, DOOR_TWEEN, { CFrame = if open then panel.Open else panel.Closed }):Play()
	end
end

local function moodOf(level: number): "Calm" | "Horror"
	return if level >= Config.HorrorStartsAtLevel then "Horror" else "Calm"
end

-- Calm: every light on, bright colors, no hints. Horror: some lights die, colors turn gloomy, and
-- the hints appear.
local function applyMood(refs, mood: "Calm" | "Horror")
	local look = Config.Moods[mood]
	for _, fixture in refs.Lights do
		local on = mood == "Calm" or not fixture:GetAttribute("DiesInHorror")
		fixture.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		fixture.Color = if on then look.LightColor else DEAD_LIGHT
		local light = fixture:FindFirstChildOfClass("SurfaceLight")
		if light then
			light.Enabled = on
			light.Color = look.LightColor
			light.Brightness = look.LightBrightness
		end
	end
	for _, hint in refs.Hints do
		hint.Parent = if mood == "Horror" then refs.Station else nil
	end
	-- Bright station colors (green pillars, seats, bins) turn dull and grey in the dark half.
	for _, entry in refs.Gloomy do
		entry.Part.Color = if mood == "Horror" then entry.Horror else entry.Calm
	end
end

-- Removes the GO BACK door (sign, frame and vote zone) on levels where it does not exist yet.
local function setBackDoor(refs, available: boolean)
	refs.Doors.Back.Model.Parent = if available then refs.Map else nil
end

-- Ticks the station clock from 23:57:00 every time the train stops, unless an anomaly froze it.
local function runClock(refs, stationStartedAt: () -> number)
	task.spawn(function()
		while refs.Map.Parent do
			if not refs.Clock:GetAttribute("Frozen") then
				local seconds = CLOCK_START_SECONDS + math.floor(os.clock() - stationStartedAt())
				refs.ClockLabel.Text = string.format("%02d:%02d:%02d", seconds // 3600 % 24, seconds // 60 % 60, seconds % 60)
			end
			task.wait(0.25)
		end
	end)
end

function GameLoop.run(session)
	local refs = session.Refs
	local language = session.Language
	local event = Net.event()
	local anomalies = AnomalyRegistry.load()
	local random = Random.new()

	local level = 1
	local checkpoint = 0
	local mood = moodOf(level)
	local lastAnomaly = nil
	local stationStartedAt = os.clock()

	local function text(key: string, ...: any): string
		return Strings.get(language, key, ...)
	end

	local function members(): { Player }
		return session.GetMembers()
	end

	local function setAll(name: string, value: any)
		for _, player in members() do
			player:SetAttribute(name, value)
		end
	end

	local function publishState(phase: string)
		setAll("Phase", phase)
		setAll("Mood", mood)
		setAll("Level", level)
		setAll("TotalLevels", Config.TotalLevels)
		setAll("Checkpoint", checkpoint)
		setAll("BackDoor", level >= Config.BackDoorFromLevel)
		refs.CounterLabel.Text = text("Counter", level, Config.TotalLevels)
	end

	local function publishVote(continueVotes: number, backVotes: number, voters: number, countdown: number, tie: boolean)
		setAll("VotesContinue", continueVotes)
		setAll("VotesBack", backVotes)
		setAll("Voters", voters)
		setAll("VoteCountdown", countdown)
		setAll("VoteTie", tie)
	end

	local function fire(payload)
		for _, player in members() do
			event:FireClient(player, payload)
		end
	end

	local function message(body: string, duration: number?)
		fire({ Kind = "Message", Text = body, Duration = duration or 3 })
	end

	local function fade(visible: boolean)
		fire({ Kind = "Fade", Visible = visible, Duration = Config.FadeSeconds })
		task.wait(Config.FadeSeconds)
	end

	local function boardTrain()
		for i, player in session.GetAlive() do
			player.Character:PivotTo(refs.StandPoints[(i - 1) % #refs.StandPoints + 1])
		end
	end

	local function pickAnomaly()
		if table.find(Config.AlwaysNormalLevels, level) or #anomalies == 0 then
			return nil
		end
		if mood == "Calm" and not Config.CalmAnomalies then
			return nil
		end
		if random:NextNumber() >= Config.AnomalyChance then
			return nil
		end
		-- Calm levels only use the mild anomalies. Never the same one twice in a row.
		local pool = {}
		for _, anomaly in anomalies do
			if (mood == "Horror" or not anomaly.Horror) and anomaly ~= lastAnomaly then
				table.insert(pool, anomaly)
			end
		end
		if #pool == 0 then
			return nil
		end
		return pool[random:NextInteger(1, #pool)]
	end

	runClock(refs, function()
		return stationStartedAt
	end)
	applyMood(refs, mood)
	publishState("Riding")
	publishVote(0, 0, 0, -1, false)
	-- The lobby fades to black before the group appears in the train.
	fade(true)
	-- Give random-avatar passengers a moment to load in the dark.
	task.wait(Config.BlackoutSeconds)

	while #members() > 0 do
		-- Set up the next station while the screen is dark.
		local newMood = moodOf(level)
		if newMood ~= mood then
			mood = newMood
			applyMood(refs, mood)
		end

		local anomaly = pickAnomaly()
		local ctx = AnomalyContext.new(refs, members(), random)
		if anomaly then
			local ok, err = pcall(anomaly.Apply, ctx)
			if not ok then
				warn("[EndlessSubway] anomaly", anomaly.Name, "failed to apply:", err)
				ctx:Restore()
				anomaly = nil
			end
		end
		lastAnomaly = anomaly or lastAnomaly
		if Config.Debug then
			print("[EndlessSubway] session", session.Slot, "level", level, "anomaly:", anomaly and anomaly.Name or "none")
		end

		setBackDoor(refs, level >= Config.BackDoorFromLevel)
		setDoors(refs, false)
		boardTrain()
		stationStartedAt = os.clock()
		publishState("Riding")
		fade(false)

		-- The train has stopped: doors open and the players decide.
		setDoors(refs, true)
		publishState("Station")
		local choice, byCoinFlip, outcome = VoteManager.collect(refs.Doors, members, session.GetAlive, publishVote, random)

		publishState("Riding")
		if byCoinFlip then
			message(text("CoinFlip", text(if choice == "Continue" then "DoorContinue" else "DoorBack")), 2)
		end
		fade(true)

		if anomaly then
			local ok, err = pcall(anomaly.Reset, ctx)
			if not ok then
				warn("[EndlessSubway] anomaly", anomaly.Name, "failed to reset:", err)
			end
		end
		-- Restore is idempotent, so this also covers anomalies whose Reset forgot to call it.
		ctx:Restore()

		if outcome == "Left" then
			return
		end

		if outcome == "Wiped" then
			-- The whole group died: everyone comes back, from the very beginning.
			level, checkpoint = 1, 0
			message(text("Wiped"), 3)
			session.Revive()
		elseif (choice == "Continue") == (anomaly == nil) then
			if table.find(Config.Checkpoints, level) then
				checkpoint = level
				message(text("CheckpointReached", checkpoint + 1), 4)
			end
			level += 1
			if level > Config.TotalLevels then
				message(text("Ending"), 4)
				task.wait(4)
				return
			end
			if level == Config.HorrorStartsAtLevel then
				task.delay(2, message, text("HorrorBegins"), 3)
			end
		else
			level = checkpoint + 1
			message(text("Wrong", level), 3)
		end

		publishState("Riding")
		task.wait(Config.BlackoutSeconds)
	end
end

return GameLoop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Graphics</string>
          <string name="Source"><![CDATA[-- Creates the lighting effects every client uses. Each client then tweens Lighting and these
-- effects to its own group's mood (lobby, bright calm levels, dark horror levels); see the Mood
-- client script. Lighting.Technology = Future is set in the place file (default.project.json),
-- because scripts cannot change it.

local Lighting = game:GetService("Lighting")

local Graphics = {}

local function effect(className: string, name: string)
	local existing = Lighting:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local instance = Instance.new(className)
	instance.Name = name
	instance.Parent = Lighting
end

function Graphics.apply()
	-- Indoors everywhere: no sky light; rooms are lit by their own lights and the ambient.
	Lighting.ClockTime = 0
	Lighting.Brightness = 0
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.3
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.Ambient = Color3.fromRGB(100, 100, 105)
	Lighting.OutdoorAmbient = Color3.fromRGB(70, 70, 75)

	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") or child:IsA("SunRaysEffect") then
			child:Destroy()
		end
	end

	effect("Atmosphere", "SubwayAir")
	effect("ColorCorrectionEffect", "SubwayGrade")
	effect("BloomEffect", "SubwayBloom")
end

return Graphics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[-- The lobby: a bright ticket hall with a row of gates. Groups gather on a gate, and when it leaves
-- they get their own station. The lobby itself is always in English.
--
-- Layout (studs, relative to LOBBY_ORIGIN): floor X -60..60, Z -40..40, gates along Z = -28.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Build = require(script.Parent.Build)
local Npc = require(script.Parent.Npc)
local NpcOutfits = require(script.Parent.NpcOutfits)

local block = Build.block

local LOBBY_ORIGIN = CFrame.new(0, 10, 0)
local GATE_SPACING = 18

local COLORS = {
	Floor = Color3.fromRGB(150, 146, 138),
	Wall = Color3.fromRGB(225, 220, 205),
	Ceiling = Color3.fromRGB(200, 198, 192),
	Frame = Color3.fromRGB(40, 40, 44),
	Yellow = Color3.fromRGB(230, 185, 25),
	Light = Color3.fromRGB(255, 248, 235),
}

local LobbyBuilder = {}

local function at(x: number, y: number, z: number): CFrame
	return LOBBY_ORIGIN * CFrame.new(x, y, z)
end

function LobbyBuilder.clearDefaultPlace()
	-- A fresh "Baseplate" place ships a baseplate and a spawn; players must spawn in the lobby.
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		baseplate:Destroy()
	end
	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("SpawnLocation") then
			descendant.Enabled = false
		end
	end
end

local function buildHall(lobby: Folder)
	block(lobby, "Floor", Vector3.new(120, 2, 80), at(0, -1, 0), COLORS.Floor, Enum.Material.Concrete)
	block(lobby, "Ceiling", Vector3.new(120, 1, 80), at(0, 20.5, 0), COLORS.Ceiling, Enum.Material.Concrete)
	block(lobby, "WallNorth", Vector3.new(122, 22, 1), at(0, 10, -40.5), COLORS.Wall, Enum.Material.CeramicTiles)
	block(lobby, "WallSouth", Vector3.new(122, 22, 1), at(0, 10, 40.5), COLORS.Wall, Enum.Material.CeramicTiles)
	block(lobby, "WallWest", Vector3.new(1, 22, 80), at(-60.5, 10, 0), COLORS.Wall, Enum.Material.CeramicTiles)
	block(lobby, "WallEast", Vector3.new(1, 22, 80), at(60.5, 10, 0), COLORS.Wall, Enum.Material.CeramicTiles)
	block(lobby, "FloorLine", Vector3.new(120, 0.05, 1), at(0, 0.03, -18), COLORS.Yellow)

	for x = -45, 45, 18 do
		for z = -30, 30, 15 do
			Build.ceilingLight(lobby, "Light", Vector3.new(10, 0.2, 1.2), at(x, 19.9, z), COLORS.Light, 1.75, 28)
		end
	end

	local title = block(lobby, "Title", Vector3.new(40, 6, 0.4), at(0, 15, 39.7), COLORS.Frame)
	Build.surfaceText(title, Enum.NormalId.Front, "ENDLESS SUBWAY", { TextColor = COLORS.Yellow, Glow = true })

	local howTo = block(lobby, "HowTo", Vector3.new(30, 7, 0.4), at(0, 6.5, 39.7), COLORS.Frame)
	Build.surfaceText(howTo, Enum.NormalId.Front, table.concat({
		"Stand on a gate with your friends.",
		"The first one in picks the group size (1-10) and the language.",
		"When the gate is full, the train leaves.",
	}, "\n"), { TextColor = Color3.fromRGB(220, 220, 220), Glow = true })

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(12, 0.2, 12)
	spawn.CFrame = at(0, 0.1, 18)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	-- Invisible: nothing on the floor between the player and the gates.
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Parent = lobby
	return spawn
end

local function buildGate(lobby: Folder, index: number, x: number)
	local gate = Instance.new("Model")
	gate.Name = "Gate" .. index
	gate.Parent = lobby

	local zone = block(gate, "Zone", Vector3.new(12, 0.2, 12), at(x, 0.1, -28), Color3.fromRGB(80, 80, 80), Enum.Material.Neon)
	zone.Transparency = 0.55
	zone.CanCollide = false
	zone.CastShadow = false

	block(gate, "PillarWest", Vector3.new(1, 10, 1), at(x - 6.5, 5, -34.5), COLORS.Frame, Enum.Material.Metal)
	block(gate, "PillarEast", Vector3.new(1, 10, 1), at(x + 6.5, 5, -34.5), COLORS.Frame, Enum.Material.Metal)
	block(gate, "Header", Vector3.new(14, 1.5, 1), at(x, 10.5, -34.5), COLORS.Frame, Enum.Material.Metal)
	block(gate, "Tunnel", Vector3.new(12, 10, 0.2), at(x, 5, -39.8), Color3.fromRGB(5, 5, 6))

	local screen = block(gate, "Screen", Vector3.new(12, 4, 0.4), at(x, 13.8, -34.5), Color3.fromRGB(10, 10, 12))
	local label = Build.surfaceText(screen, Enum.NormalId.Back, "", { TextColor = COLORS.Yellow, Glow = true })

	local glow = Instance.new("PointLight")
	glow.Range = 14
	glow.Brightness = 0.8
	glow.Parent = zone

	return { Index = index, Zone = zone, Label = label, Glow = glow }
end

-- The same people as on the train, waiting in the hall: four on seats along the back wall, two
-- near the gates, and the driver by gate 1.
local function buildPeople(lobby: Folder)
	local seatColor = Color3.fromRGB(150, 95, 45)
	local metal = Color3.fromRGB(165, 168, 172)
	for _, x in { -45, -28, 28, 45 } do
		for i = -1, 1 do
			block(lobby, "Seat", Vector3.new(1.8, 0.4, 1.7), at(x + i * 2, 1.8, 37.2), seatColor)
			block(lobby, "SeatBack", Vector3.new(1.8, 1.8, 0.3), at(x + i * 2, 2.95, 38.05), seatColor)
		end
		block(lobby, "SeatFrame", Vector3.new(6.4, 0.3, 0.6), at(x, 1.45, 37.5), metal, Enum.Material.Metal)
		for _, dx in { -3, 3 } do
			block(lobby, "SeatLeg", Vector3.new(0.3, 1.3, 1.2), at(x + dx, 0.65, 37.4), metal, Enum.Material.Metal)
		end
	end

	local outfits = NpcOutfits.Passengers
	local people = {
		-- Seated, facing the gates (-Z).
		Npc.create("Passenger", "Sit", at(-45, 2, 37.1), Color3.fromRGB(40, 55, 90), outfits[1]),
		Npc.create("Passenger", "Sit", at(-28, 2, 37.1), Color3.fromRGB(110, 75, 50), outfits[2]),
		Npc.create("Passenger", "Sit", at(28, 2, 37.1), Color3.fromRGB(60, 60, 60), outfits[3]),
		Npc.create("Passenger", "Sit", at(45, 2, 37.1), Color3.fromRGB(95, 95, 100), outfits[4]),
		-- Standing, looking at the gates.
		Npc.create("Passenger", "Stand", at(-12, 2, -12), Color3.fromRGB(70, 40, 60), outfits[5]),
		Npc.create("Passenger", "Stand", at(16, 2, -14), Color3.fromRGB(120, 40, 45), outfits[6]),
		-- The driver waits by gate 1, facing the hall (+X).
		Npc.create("Driver", "Stand", at(-57, 2, -24) * CFrame.Angles(0, -math.pi / 2, 0), Color3.fromRGB(25, 45, 85), NpcOutfits.Driver),
	}
	for _, person in people do
		person.Parent = lobby
	end
end

-- Builds the lobby into Workspace.Lobby. Returns the gates and the spawn point.
function LobbyBuilder.build()
	LobbyBuilder.clearDefaultPlace()

	local existing = Workspace:FindFirstChild("Lobby")
	if existing then
		existing:Destroy()
	end

	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"

	local spawn = buildHall(lobby)
	buildPeople(lobby)
	local gates = {}
	local first = -(Config.LobbyPads - 1) * GATE_SPACING / 2
	for i = 1, Config.LobbyPads do
		table.insert(gates, buildGate(lobby, i, first + (i - 1) * GATE_SPACING))
	end

	lobby.Parent = Workspace
	return {
		Folder = lobby,
		Spawn = spawn,
		SpawnCFrame = spawn.CFrame * CFrame.new(0, 3.5, 0),
		Gates = gates,
	}
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">LobbyManager</string>
          <string name="Source"><![CDATA[-- Lobby gates. Standing on a gate joins its group; stepping off leaves it. The first player on a
-- gate is the host and picks the group size (1-10) and the session language (AR / EN). The group
-- leaves when the gate is full, or when the host presses "Start now".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local SessionManager = require(script.Parent.SessionManager)

local POLL_SECONDS = 0.2

local LANGUAGE_NAMES = { ar = "ARABIC", en = "ENGLISH" }

local LobbyManager = {}

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function isInside(zone: BasePart, position: Vector3): boolean
	local relative = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(relative.X) <= half.X and math.abs(relative.Z) <= half.Z and relative.Y > -2 and relative.Y < 10
end

local function newPad(gate)
	return {
		Gate = gate,
		Members = {} :: { Player },
		MaxPlayers = Config.DefaultPartySize,
		Language = "en",
		StartRequested = false,
		CountdownEnd = nil :: number?,
	}
end

local function resetPad(pad)
	table.clear(pad.Members)
	pad.MaxPlayers = Config.DefaultPartySize
	pad.Language = "en"
	pad.StartRequested = false
	pad.CountdownEnd = nil
end

local function hostPad(pads, player: Player)
	for _, pad in pads do
		if pad.Members[1] == player then
			return pad
		end
	end
	return nil
end

local function render(pad, now: number)
	local gate = pad.Gate
	local count = #pad.Members
	if count == 0 then
		gate.Label.Text = string.format("GATE %d\nEMPTY", gate.Index)
		gate.Zone.Color = Color3.fromRGB(80, 80, 80)
	elseif pad.CountdownEnd then
		gate.Label.Text = string.format("GATE %d  %d/%d\nLEAVING IN %d", gate.Index, count, pad.MaxPlayers, math.ceil(pad.CountdownEnd - now))
		gate.Zone.Color = Color3.fromRGB(40, 170, 90)
	else
		gate.Label.Text = string.format("GATE %d  %d/%d\n%s", gate.Index, count, pad.MaxPlayers, LANGUAGE_NAMES[pad.Language])
		gate.Zone.Color = Color3.fromRGB(220, 175, 25)
	end
	gate.Glow.Color = gate.Zone.Color
end

function LobbyManager.start(lobby)
	local pads = {}
	for _, gate in lobby.Gates do
		table.insert(pads, newPad(gate))
	end

	Net.lobbyAction().OnServerEvent:Connect(function(player: Player, action: any, value: any)
		if action == "LeaveRun" then
			SessionManager.leave(player)
			return
		end

		local pad = hostPad(pads, player)
		if not pad then
			return
		end
		if action == "SetPartySize" and type(value) == "number" and value == value then
			local size = math.clamp(math.floor(value), Config.MinPartySize, Config.MaxPartySize)
			pad.MaxPlayers = math.max(size, #pad.Members)
		elseif action == "SetLanguage" and (value == "ar" or value == "en") then
			pad.Language = value
		elseif action == "StartNow" then
			pad.StartRequested = true
		end
	end)

	task.spawn(function()
		while true do
			local now = os.clock()
			local claimed: { [Player]: boolean } = {}
			local standingOnFull: { [Player]: boolean } = {}

			for _, pad in pads do
				local zone = pad.Gate.Zone

				-- Keep members who are still standing here, in their original order.
				local kept = {}
				for _, player in pad.Members do
					local root = player.Parent and not SessionManager.isPlaying(player) and rootOf(player)
					if root and isInside(zone, root.Position) then
						table.insert(kept, player)
						claimed[player] = true
					end
				end
				pad.Members = kept

				-- Let newcomers in while there is room.
				for _, player in Players:GetPlayers() do
					if claimed[player] or SessionManager.isPlaying(player) then
						continue
					end
					local root = rootOf(player)
					if root and isInside(zone, root.Position) then
						if #pad.Members < pad.MaxPlayers then
							table.insert(pad.Members, player)
							claimed[player] = true
						else
							standingOnFull[player] = true
						end
					end
				end

				if #pad.Members == 0 then
					resetPad(pad)
				else
					local ready = #pad.Members >= pad.MaxPlayers or pad.StartRequested
					if ready and not pad.CountdownEnd then
						pad.CountdownEnd = now + Config.LobbyCountdownSeconds
					elseif not ready then
						pad.CountdownEnd = nil
					end

					if pad.CountdownEnd and now >= pad.CountdownEnd then
						SessionManager.launch(table.clone(pad.Members), pad.Language)
						resetPad(pad)
					end
				end

				render(pad, now)
			end

			-- Tell each lobby player's HUD about their gate.
			for _, player in Players:GetPlayers() do
				if SessionManager.isPlaying(player) then
					continue
				end
				local mine = nil
				for _, pad in pads do
					if table.find(pad.Members, player) then
						mine = pad
						break
					end
				end
				player:SetAttribute("Pad", if mine then mine.Gate.Index else 0)
				player:SetAttribute("PadHost", mine ~= nil and mine.Members[1] == player)
				player:SetAttribute("PadCount", if mine then #mine.Members else 0)
				player:SetAttribute("PadMax", if mine then mine.MaxPlayers else 0)
				player:SetAttribute("PadLanguage", if mine then mine.Language else "en")
				player:SetAttribute("PadCountdown", if mine and mine.CountdownEnd then math.max(0, math.ceil(mine.CountdownEnd - now)) else -1)
				player:SetAttribute("PadFull", standingOnFull[player] == true)
			end

			task.wait(POLL_SECONDS)
		end
	end)
end

return LobbyManager
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="28">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Endless Subway. This one place plays two roles:
--   Lobby server: builds the lobby and sends groups off from its gates.
--   Game server: a private server a gate teleported its group to; it runs only their game.
-- Roblox Studio cannot teleport, so there it is always a lobby server that also hosts the games.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Graphics = require(script.Parent.Graphics)
local LobbyBuilder = require(script.Parent.LobbyBuilder)
local LobbyManager = require(script.Parent.LobbyManager)
local SessionManager = require(script.Parent.SessionManager)

local live = Config.UseSeparateServers and not RunService:IsStudio()
local isGameServer = live and game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0

Graphics.apply()
if isGameServer then
	LobbyBuilder.clearDefaultPlace()
	SessionManager.initGameServer()
else
	local lobby = LobbyBuilder.build()
	SessionManager.init(lobby, live)
	LobbyManager.start(lobby)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Mannequin</string>
          <string name="Source"><![CDATA[-- Faceless block passengers built from anchored parts, so the map needs no uploaded assets.
-- The model's pivot is the hip point; it faces the CFrame's LookVector.

local Mannequin = {}

local SKIN = Color3.fromRGB(204, 176, 150)

local function addPart(model: Model, name: string, size: Vector3, offset: CFrame, color: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = offset
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end

local function addEyes(head: Part)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Eyes"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.Parent = head

	for _, x in { 0.28, 0.72 } do
		local eye = Instance.new("Frame")
		eye.AnchorPoint = Vector2.new(0.5, 0.5)
		eye.Position = UDim2.fromScale(x, 0.42)
		eye.Size = UDim2.fromScale(0.12, 0.12)
		eye.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
		eye.BorderSizePixel = 0
		eye.Parent = gui

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = eye
	end
end

-- pose: "Stand" (pivot 2 studs above the floor) or "Sit" (pivot on the seat surface).
function Mannequin.create(name: string, pose: "Stand" | "Sit", pivot: CFrame, clothes: Color3): Model
	local model = Instance.new("Model")
	model.Name = name

	local pants = clothes:Lerp(Color3.new(0, 0, 0), 0.5)

	local torso = addPart(model, "Torso", Vector3.new(2, 2, 1), CFrame.new(0, 1, 0), clothes)
	local leftArm = addPart(model, "LeftArm", Vector3.new(1, 2, 1), CFrame.new(-1.5, 1, 0), clothes)
	local rightArm = addPart(model, "RightArm", Vector3.new(1, 2, 1), CFrame.new(1.5, 1, 0), clothes)
	local head = addPart(model, "Head", Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 2.6, 0), SKIN)
	addEyes(head)

	if pose == "Stand" then
		addPart(model, "LeftLeg", Vector3.new(1, 2, 1), CFrame.new(-0.5, -1, 0), pants)
		addPart(model, "RightLeg", Vector3.new(1, 2, 1), CFrame.new(0.5, -1, 0), pants)
	else
		addPart(model, "LeftThigh", Vector3.new(1, 1, 2), CFrame.new(-0.5, 0.5, -0.5), pants)
		addPart(model, "RightThigh", Vector3.new(1, 1, 2), CFrame.new(0.5, 0.5, -0.5), pants)
		addPart(model, "LeftShin", Vector3.new(1, 2.4, 1), CFrame.new(-0.5, -0.7, -1), pants)
		addPart(model, "RightShin", Vector3.new(1, 2.4, 1), CFrame.new(0.5, -0.7, -1), pants)
		torso.CFrame = CFrame.new(0, 2, 0)
		leftArm.CFrame = CFrame.new(-1.5, 2, 0)
		rightArm.CFrame = CFrame.new(1.5, 2, 0)
		head.CFrame = CFrame.new(0, 3.6, 0)
	end

	model.PrimaryPart = torso
	-- Parts were laid out around the origin, so the origin is the hip pivot.
	model.WorldPivot = CFrame.new()
	model:PivotTo(pivot)
	return model
end

return Mannequin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Builds one station in code, styled after real metro stations: a tiled platform with a tactile
-- edge strip, ceiling beams with wide light panels, two-tone pillars, metal seats, and a silver
-- train (an open car you ride in, two closed cars, and the driver's cab at the front).
-- Every group from the lobby gets its own copy, built at its own origin and in its own language.
--
-- Layout (studs, relative to the station origin). The platform runs along X, the track is on +Z.
--   Platform floor      X -100..100, Z -10..10, top at Y 1
--   Train cars          side walls at Z 11 (platform) and Z 24.5 (tunnel), floor top at Y 1
--     Open car          X -20..20, the one the group rides in
--     Closed cars       X -62..-22 and 22..62
--     Driver's cab      X 64..84, the front of the train (it heads toward +X)
--   CONTINUE door       +X end of the platform
--   GO BACK door        -X end of the platform (missing on level 1)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Strings = require(ReplicatedStorage.Shared.Strings)
local Build = require(script.Parent.Build)
local Npc = require(script.Parent.Npc)
local NpcOutfits = require(script.Parent.NpcOutfits)

local block = Build.block
local surfaceText = Build.surfaceText

local HALF_LENGTH = 100

-- Car cross-section (shared by every car).
local CAR = {
	OuterNear = 11, -- platform-side outer face
	OuterFar = 24.5, -- tunnel-side outer face
	Wall = 0.5,
	FloorTop = 1,
	WindowBottom = 5,
	WindowTop = 9,
	DoorTop = 9,
	RoofBottom = 12,
	DoorHalfWidth = 3.5,
}

local COLORS = {
	Floor = Color3.fromRGB(214, 214, 210),
	Wall = Color3.fromRGB(222, 224, 226),
	WallSeam = Color3.fromRGB(170, 174, 180),
	WallStripe = Color3.fromRGB(60, 110, 170),
	Ceiling = Color3.fromRGB(205, 207, 210),
	Beam = Color3.fromRGB(90, 94, 100),
	Pillar = Color3.fromRGB(225, 226, 228),
	PillarBand = Color3.fromRGB(150, 200, 60),
	Edge = Color3.fromRGB(235, 185, 20),
	EdgeBar = Color3.fromRGB(35, 35, 38),
	CarBody = Color3.fromRGB(176, 181, 188),
	CarGroove = Color3.fromRGB(130, 135, 142),
	CarRoof = Color3.fromRGB(205, 208, 212),
	CarInside = Color3.fromRGB(225, 228, 232),
	CarSeat = Color3.fromRGB(95, 175, 190),
	CarFloor = Color3.fromRGB(120, 140, 155),
	Glass = Color3.fromRGB(150, 180, 200),
	Strap = Color3.fromRGB(215, 200, 140),
	Metal = Color3.fromRGB(165, 168, 172),
	CabBlue = Color3.fromRGB(40, 85, 150),
	Dark = Color3.fromRGB(18, 18, 20),
	SeatShell = Color3.fromRGB(150, 95, 45),
	-- What the bright colors fade to in the dark half.
	GloomPillar = Color3.fromRGB(88, 96, 82),
	GloomSeat = Color3.fromRGB(88, 74, 60),
	Continue = Color3.fromRGB(40, 140, 80),
	Back = Color3.fromRGB(170, 50, 45),
	Light = Color3.fromRGB(255, 246, 228),
	TunnelLamp = Color3.fromRGB(255, 150, 40),
}

local POSTER_COLORS = {
	Color3.fromRGB(170, 85, 25),
	Color3.fromRGB(30, 65, 125),
	Color3.fromRGB(30, 105, 65),
	Color3.fromRGB(85, 45, 115),
	Color3.fromRGB(150, 120, 20),
	Color3.fromRGB(25, 100, 110),
	Color3.fromRGB(120, 30, 30),
}

local MapBuilder = {}

-- Origin of the station being built. build() runs without yielding, so one shared value is safe.
local origin = CFrame.new()

local function at(x: number, y: number, z: number): CFrame
	return origin * CFrame.new(x, y, z)
end

-- Remembers a part's bright color and the gloomy one it turns in the dark half (see GameLoop).
local function gloomy(refs, part: BasePart, horrorColor: Color3): BasePart
	table.insert(refs.Gloomy, { Part = part, Calm = part.Color, Horror = horrorColor })
	return part
end

local function noCollide(part: BasePart): BasePart
	part.CanCollide = false
	part.CastShadow = false
	return part
end

-- A dark "window" painted on both faces of a door panel, so the window moves with the panel.
local function doorWindow(panel: BasePart)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.Parent = panel
		local window = Instance.new("Frame")
		window.AnchorPoint = Vector2.new(0.5, 0)
		window.Position = UDim2.fromScale(0.5, 0.1)
		window.Size = UDim2.fromScale(0.62, 0.36)
		window.BackgroundColor3 = Color3.fromRGB(30, 40, 50)
		window.BorderSizePixel = 0
		window.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.15, 0)
		corner.Parent = window
	end
end

-- ===== Station shell =====

local function buildShell(map: Folder)
	local shell = Instance.new("Folder")
	shell.Name = "Shell"
	shell.Parent = map

	local length = HALF_LENGTH * 2
	block(shell, "Platform", Vector3.new(length, 5, 20), at(0, -1.5, 0), COLORS.Floor, Enum.Material.CeramicTiles)

	-- Tactile strip along the platform edge: yellow with dark bars.
	block(shell, "EdgeStrip", Vector3.new(length, 0.06, 1.6), at(0, 1.03, 9), COLORS.Edge)
	for x = -HALF_LENGTH + 1, HALF_LENGTH - 1, 2.5 do
		block(shell, "EdgeBar", Vector3.new(0.5, 0.08, 1.6), at(x, 1.04, 9), COLORS.EdgeBar)
	end
	block(shell, "EdgeLip", Vector3.new(length, 0.3, 0.4), at(0, 0.85, 9.8), Color3.fromRGB(240, 240, 238))

	-- Back wall: light panels with seams and a blue stripe.
	block(shell, "BackWall", Vector3.new(length + 2, 20, 1), at(0, 6, -10.5), COLORS.Wall, Enum.Material.SmoothPlastic)
	block(shell, "WallStripe", Vector3.new(length, 1.2, 0.1), at(0, 2.4, -9.95), COLORS.WallStripe)
	block(shell, "WallBase", Vector3.new(length, 1.4, 0.15), at(0, 1.7, -9.9), Color3.fromRGB(70, 75, 82))
	for x = -HALF_LENGTH + 10, HALF_LENGTH - 10, 10 do
		block(shell, "WallSeam", Vector3.new(0.15, 13, 0.08), at(x, 9.5, -9.97), COLORS.WallSeam)
	end

	-- Tunnel side, with small orange lamps.
	block(shell, "TunnelWall", Vector3.new(length + 2, 20, 1), at(0, 6, 27.5), Color3.fromRGB(45, 45, 48), Enum.Material.Concrete)
	for x = -HALF_LENGTH + 12, HALF_LENGTH - 12, 25 do
		noCollide(block(shell, "TunnelLamp", Vector3.new(3, 0.4, 0.2), at(x, 9, 26.9), COLORS.TunnelLamp, Enum.Material.Neon))
	end

	-- Ceiling with cross beams between the light panels.
	block(shell, "Ceiling", Vector3.new(length + 2, 1, 39), at(0, 16.5, 8.5), COLORS.Ceiling, Enum.Material.SmoothPlastic)
	for x = -HALF_LENGTH, HALF_LENGTH, 20 do
		block(shell, "Beam", Vector3.new(1.5, 1.2, 20.5), at(x, 15.4, -0.25), COLORS.Beam, Enum.Material.Metal)
	end

	block(shell, "TrackBed", Vector3.new(length, 1, 17), at(0, -3.5, 18.5), COLORS.Dark, Enum.Material.Slate)
	block(shell, "RailNear", Vector3.new(length, 0.4, 0.4), at(0, -2.8, 15.5), Color3.fromRGB(90, 90, 95), Enum.Material.Metal)
	block(shell, "RailFar", Vector3.new(length, 0.4, 0.4), at(0, -2.8, 20.5), Color3.fromRGB(90, 90, 95), Enum.Material.Metal)

	-- Keep players on the platform and in the open car.
	local barrierLength = HALF_LENGTH - 20
	local barrierCenter = 20 + barrierLength / 2
	Build.invisibleWall(shell, "EdgeBarrierWest", Vector3.new(barrierLength, 15, 0.5), at(-barrierCenter, 8.5, 10.25))
	Build.invisibleWall(shell, "EdgeBarrierEast", Vector3.new(barrierLength, 15, 0.5), at(barrierCenter, 8.5, 10.25))
end

local function buildExitDoor(map: Folder, kind: "Continue" | "Back", language: string)
	local sign = if kind == "Continue" then 1 else -1
	local color = if kind == "Continue" then COLORS.Continue else COLORS.Back
	local face = if kind == "Continue" then Enum.NormalId.Left else Enum.NormalId.Right
	local wallX = sign * (HALF_LENGTH + 0.5)
	local doorX = sign * (HALF_LENGTH - 0.2)

	-- The wall belongs to the map; the door model can be removed on its own (see GameLoop).
	block(map, kind .. "EndWall", Vector3.new(1, 20, 39), at(wallX, 6, 8.5), COLORS.Wall)

	local model = Instance.new("Model")
	model.Name = kind .. "Door"
	model.Parent = map

	local door = block(model, "Door", Vector3.new(0.4, 8, 5), at(doorX, 5, 0), COLORS.Dark, Enum.Material.Metal)
	block(model, "Frame", Vector3.new(0.3, 9, 6), at(sign * (HALF_LENGTH - 0.05), 5.5, 0), color)

	local title = Strings.get(language, if kind == "Continue" then "DoorContinue" else "DoorBack")
	local signPart = block(model, "Sign", Vector3.new(0.4, 2, 8), at(doorX, 11, 0), color, Enum.Material.Neon)
	surfaceText(signPart, face, title, { TextColor = Color3.new(1, 1, 1), Glow = true })
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = 14
	glow.Brightness = 0.8
	glow.Parent = signPart

	-- Players vote by standing on this zone in front of the door.
	local zone = block(model, "VoteZone", Vector3.new(10, 0.1, 14), at(sign * (HALF_LENGTH - 7), 1.06, 0), color, Enum.Material.Neon)
	zone.Transparency = 0.8
	zone.CanCollide = false
	zone.CanQuery = false
	zone.CastShadow = false

	return { Model = model, Door = door, Zone = zone }
end

-- ===== Train =====

-- One side wall of a car between x0 and x1, at outer face z (near or far side). Door openings are
-- centred on doorXs; windows fill the wall between them. Returns nothing: doors are added by the
-- caller (sliding on the open car, fixed elsewhere).
local function carSide(car: Model, x0: number, x1: number, doorXs: { number }, outerZ: number, inward: number)
	local wallZ = outerZ + inward * CAR.Wall / 2
	local grooveZ = outerZ - inward * 0.03
	local windowY = (CAR.WindowBottom + CAR.WindowTop) / 2
	local windowHeight = CAR.WindowTop - CAR.WindowBottom

	-- Solid sections between the doors.
	local edges = { x0 }
	for _, doorX in doorXs do
		table.insert(edges, doorX - CAR.DoorHalfWidth)
		table.insert(edges, doorX + CAR.DoorHalfWidth)
	end
	table.insert(edges, x1)

	for i = 1, #edges, 2 do
		local a, b = edges[i], edges[i + 1]
		local len = b - a
		local mid = (a + b) / 2
		block(car, "WallLow", Vector3.new(len, CAR.WindowBottom - CAR.FloorTop, CAR.Wall), at(mid, (CAR.FloorTop + CAR.WindowBottom) / 2, wallZ), COLORS.CarBody, Enum.Material.Metal)
		block(car, "WallHigh", Vector3.new(len, CAR.RoofBottom - CAR.WindowTop, CAR.Wall), at(mid, (CAR.WindowTop + CAR.RoofBottom) / 2, wallZ), COLORS.CarBody, Enum.Material.Metal)
		local glass = block(car, "Window", Vector3.new(len, windowHeight, 0.2), at(mid, windowY, wallZ), COLORS.Glass, Enum.Material.Glass)
		glass.Transparency = 0.55
		-- Window posts: at both ends and about every 6.5 studs.
		local posts = math.max(1, math.floor(len / 6.5))
		for p = 0, posts do
			local x = a + 0.3 + (len - 0.6) * p / posts
			block(car, "WindowPost", Vector3.new(0.6, windowHeight, CAR.Wall + 0.1), at(x, windowY, wallZ), COLORS.CarBody, Enum.Material.Metal)
		end
		-- Ribbed lines along the lower body.
		for _, y in { 2.2, 3.4 } do
			noCollide(block(car, "Groove", Vector3.new(len, 0.15, 0.05), at(mid, y, grooveZ), COLORS.CarGroove, Enum.Material.Metal))
		end
	end

	for _, doorX in doorXs do
		block(car, "DoorHeader", Vector3.new(CAR.DoorHalfWidth * 2, CAR.RoofBottom - CAR.DoorTop, CAR.Wall), at(doorX, (CAR.DoorTop + CAR.RoofBottom) / 2, wallZ), COLORS.CarBody, Enum.Material.Metal)
	end
end

-- Floor, curved-looking roof, end walls with end doors, and both side walls. openFront leaves the
-- +X end open (the cab puts its windshield there).
local function carShell(car: Model, x0: number, x1: number, doorXs: { number }, farDoorXs: { number }, openFront: boolean?)
	local mid = (x0 + x1) / 2
	local len = x1 - x0
	local width = CAR.OuterFar - CAR.OuterNear
	local midZ = (CAR.OuterNear + CAR.OuterFar) / 2

	block(car, "Floor", Vector3.new(len, 4, width + 1), at(mid, CAR.FloorTop - 2, midZ - 0.5), COLORS.CarFloor, Enum.Material.SmoothPlastic)
	for _, z in { 15.5, 20 } do
		noCollide(block(car, "FloorLine", Vector3.new(len - 1, 0.03, 0.3), at(mid, CAR.FloorTop + 0.02, z), Color3.fromRGB(235, 230, 200)))
	end

	-- Roof: a slab, a raised middle and sloped edges, so it reads as rounded from the platform.
	block(car, "Roof", Vector3.new(len, 1, width), at(mid, CAR.RoofBottom + 0.5, midZ), COLORS.CarRoof, Enum.Material.Metal)
	block(car, "RoofTop", Vector3.new(len, 0.8, width - 4), at(mid, CAR.RoofBottom + 1.4, midZ), COLORS.CarRoof, Enum.Material.Metal)
	local nearEdge = Instance.new("WedgePart")
	nearEdge.Name = "RoofEdge"
	nearEdge.Size = Vector3.new(len, 0.8, 2)
	nearEdge.CFrame = at(mid, CAR.RoofBottom + 1.4, CAR.OuterNear + 1)
	nearEdge.Color = COLORS.CarRoof
	nearEdge.Material = Enum.Material.Metal
	nearEdge.Anchored = true
	nearEdge.Parent = car
	local farEdge = nearEdge:Clone()
	farEdge.CFrame = at(mid, CAR.RoofBottom + 1.4, CAR.OuterFar - 1) * CFrame.Angles(0, math.pi, 0)
	farEdge.Parent = car

	-- Inside ceiling panel.
	noCollide(block(car, "CeilingPanel", Vector3.new(len - 1, 0.1, width - 1.2), at(mid, CAR.RoofBottom - 0.05, midZ), COLORS.CarInside))

	-- End walls, each with an end door (and its little window) on the inside.
	for _, side in { -1, 1 } do
		if side > 0 and openFront then
			continue
		end
		local x = if side < 0 then x0 + CAR.Wall / 2 else x1 - CAR.Wall / 2
		block(car, "EndWall", Vector3.new(CAR.Wall, CAR.RoofBottom - CAR.FloorTop, width - 1), at(x, (CAR.FloorTop + CAR.RoofBottom) / 2, midZ), COLORS.CarInside)
		-- Turned a quarter so its Front and Back faces (where the window is painted) face along X.
		local endDoor = noCollide(block(car, "EndDoor", Vector3.new(3, 7.5, 0.1), at(x - side * 0.3, CAR.FloorTop + 3.75, midZ) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(150, 170, 190), Enum.Material.Metal))
		doorWindow(endDoor)
	end

	carSide(car, x0, x1, doorXs, CAR.OuterNear, 1)
	carSide(car, x0, x1, farDoorXs, CAR.OuterFar, -1)
end

-- A fixed (closed) door pair in an opening.
local function fixedDoors(car: Model, doorX: number, outerZ: number, inward: number)
	for _, side in { -1, 1 } do
		local panel = block(car, "Door", Vector3.new(CAR.DoorHalfWidth, CAR.DoorTop - CAR.FloorTop, 0.3), at(doorX + side * CAR.DoorHalfWidth / 2, (CAR.FloorTop + CAR.DoorTop) / 2, outerZ + inward * 0.25), COLORS.CarBody, Enum.Material.Metal)
		doorWindow(panel)
	end
end

-- Bench seats along a wall section, between x0 and x1, facing into the car.
local function benches(car: Model, x0: number, x1: number, wallInnerZ: number, facing: number)
	if x1 - x0 < 3 then
		return
	end
	local mid = (x0 + x1) / 2
	local len = x1 - x0
	local seatZ = wallInnerZ + facing * 1.3
	block(car, "BenchSeat", Vector3.new(len, 0.6, 1.8), at(mid, 2.6, seatZ), COLORS.CarSeat)
	block(car, "BenchBack", Vector3.new(len, 2.6, 0.4), at(mid, 4.2, wallInnerZ + facing * 0.2), COLORS.CarSeat)
	block(car, "BenchBase", Vector3.new(len, 1.3, 1.4), at(mid, 1.65, seatZ - facing * 0.1), Color3.fromRGB(70, 80, 90), Enum.Material.Metal)
	for _, x in { x0 + 0.1, x1 - 0.1 } do
		noCollide(block(car, "Armrest", Vector3.new(0.2, 0.2, 1.7), at(x, 3.8, seatZ), COLORS.Metal, Enum.Material.Metal))
		noCollide(block(car, "ArmrestPost", Vector3.new(0.2, 1, 0.2), at(x, 3.2, seatZ + facing * 0.75), COLORS.Metal, Enum.Material.Metal))
	end
end

-- Benches along both walls, in every section that is not a door.
local function carBenches(car: Model, x0: number, x1: number, doorXs: { number })
	local edges = { x0 + CAR.Wall + 0.3 }
	for _, doorX in doorXs do
		table.insert(edges, doorX - CAR.DoorHalfWidth - 0.4)
		table.insert(edges, doorX + CAR.DoorHalfWidth + 0.4)
	end
	table.insert(edges, x1 - CAR.Wall - 0.3)
	for i = 1, #edges, 2 do
		benches(car, edges[i], edges[i + 1], CAR.OuterNear + CAR.Wall, 1)
		benches(car, edges[i], edges[i + 1], CAR.OuterFar - CAR.Wall, -1)
	end
end

local function buildClosedCar(map: Folder, refs, x0: number, x1: number)
	local car = Instance.new("Model")
	car.Name = "ClosedCar"
	car.Parent = map

	local mid = (x0 + x1) / 2
	local doorXs = { mid - 10, mid + 10 }
	carShell(car, x0, x1, doorXs, doorXs)
	for _, doorX in doorXs do
		fixedDoors(car, doorX, CAR.OuterNear, 1)
		fixedDoors(car, doorX, CAR.OuterFar, -1)
	end
	carBenches(car, x0, x1, doorXs)

	-- Its lights are station lights: on in the bright levels, dead in the dark ones.
	local light = Build.ceilingLight(car, "Light", Vector3.new(x1 - x0 - 4, 0.2, 0.8), at(mid, CAR.RoofBottom - 0.15, 17.75), COLORS.Light, 1, 12)
	light:SetAttribute("DiesInHorror", true)
	table.insert(refs.Lights, light)
end

-- The open car: wide doors that slide, benches along both walls, hand straps over the aisle.
local function buildCar(map: Folder, language: string)
	local car = Instance.new("Model")
	car.Name = "TrainCar"
	car.Parent = map

	local x0, x1 = -20, 20
	local doorXs = { -10, 10 }
	carShell(car, x0, x1, doorXs, doorXs)
	for _, doorX in doorXs do
		fixedDoors(car, doorX, CAR.OuterFar, -1)
	end
	carBenches(car, x0, x1, doorXs)

	local doorPanels = {}
	for _, doorX in doorXs do
		for _, side in { -1, 1 } do
			local half = CAR.DoorHalfWidth / 2
			-- Pocket doors: they slide sideways into the wall itself.
			local wallZ = CAR.OuterNear + CAR.Wall / 2
			local closed = at(doorX + side * half, (CAR.FloorTop + CAR.DoorTop) / 2, wallZ)
			local open = at(doorX + side * (CAR.DoorHalfWidth + half + 0.1), (CAR.FloorTop + CAR.DoorTop) / 2, wallZ)
			local panel = block(car, "DoorPanel", Vector3.new(CAR.DoorHalfWidth, CAR.DoorTop - CAR.FloorTop, 0.3), closed, COLORS.CarBody, Enum.Material.Metal)
			doorWindow(panel)
			table.insert(doorPanels, { Part = panel, Closed = closed, Open = open })
		end
	end

	-- Grab bars with hand straps over both sides of the aisle.
	for _, z in { 14.6, 20.9 } do
		local bar = noCollide(block(car, "GrabBar", Vector3.new(38, 0.22, 0.22), at(0, 11.3, z), COLORS.Metal, Enum.Material.Metal))
		bar.Shape = Enum.PartType.Cylinder
		for x = -18, 18, 2 do
			noCollide(block(car, "Strap", Vector3.new(0.08, 1, 0.08), at(x, 10.7, z), Color3.fromRGB(235, 235, 235)))
			noCollide(block(car, "StrapRing", Vector3.new(0.12, 0.55, 0.45), at(x, 10, z), COLORS.Strap))
		end
	end

	-- Ads above the windows inside.
	local texts = Strings.get(language, "Posters")
	for i, x in { -17, -3, 3, 17 } do
		local ad = noCollide(block(car, "Ad", Vector3.new(3.2, 1.4, 0.05), at(x, 10.4, CAR.OuterFar - CAR.Wall - 0.05), POSTER_COLORS[i]))
		surfaceText(ad, Enum.NormalId.Front, texts[i], { Background = POSTER_COLORS[i], PixelsPerStud = 60 })
	end

	for _, z in { 14.6, 20.9 } do
		Build.ceilingLight(car, "LightStrip", Vector3.new(36, 0.15, 0.8), at(0, CAR.RoofBottom - 0.2, z), Color3.fromRGB(240, 245, 255), 1.1, 14)
	end

	-- Where the group stands when the train stops: two rows in the aisle, enough for 10 players.
	local standPoints = {}
	for _, z in { 15.5, 19 } do
		for x = -16, 16, 4 do
			table.insert(standPoints, at(x, 4, z))
		end
	end

	return car, doorPanels, standPoints
end

-- The driver's cab at the front: blue face with a wide windshield and round headlights, a control
-- desk inside, and a driver you can see through the side windows.
local function buildCab(map: Folder, refs)
	local cab = Instance.new("Model")
	cab.Name = "DriverCab"
	cab.Parent = map

	local x0, x1 = 64, 84
	carShell(cab, x0, x1, {}, {}, true)
	local midZ = (CAR.OuterNear + CAR.OuterFar) / 2
	local width = CAR.OuterFar - CAR.OuterNear

	-- Blue front face, over the end wall.
	local faceX = x1 + 0.3
	block(cab, "FaceLow", Vector3.new(0.6, 5, width), at(faceX, 3.5, midZ), COLORS.CabBlue, Enum.Material.SmoothPlastic)
	block(cab, "FaceHigh", Vector3.new(0.6, 2.5, width), at(faceX, 11.25, midZ), COLORS.CabBlue, Enum.Material.SmoothPlastic)
	local windshield = block(cab, "Windshield", Vector3.new(0.2, 4, width - 1), at(faceX, 8, midZ), COLORS.Glass, Enum.Material.Glass)
	windshield.Transparency = 0.45
	for _, z in { midZ - 2.6, midZ + 2.6 } do
		block(cab, "WindshieldPost", Vector3.new(0.7, 4, 0.6), at(faceX, 8, z), COLORS.CabBlue)
	end
	noCollide(block(cab, "FaceStripe", Vector3.new(0.65, 0.4, width), at(faceX, 5.6, midZ), Color3.fromRGB(230, 232, 235)))
	local badge = noCollide(block(cab, "Badge", Vector3.new(0.65, 1.2, 1.6), at(faceX + 0.02, 3.6, midZ), Color3.fromRGB(235, 185, 20)))
	surfaceText(badge, Enum.NormalId.Right, "14", { TextColor = COLORS.Dark, Background = Color3.fromRGB(235, 185, 20) })

	-- Two pairs of round headlights.
	for _, z in { midZ - 5.2, midZ - 3.9, midZ + 3.9, midZ + 5.2 } do
		local lamp = noCollide(block(cab, "Headlight", Vector3.new(0.3, 1, 1), at(faceX + 0.35, 3.4, z), Color3.fromRGB(255, 250, 225), Enum.Material.Neon))
		lamp.Shape = Enum.PartType.Cylinder
	end
	for _, z in { midZ - 4.5, midZ + 4.5 } do
		local beam = Instance.new("SpotLight")
		beam.Face = Enum.NormalId.Right
		beam.Range = 40
		beam.Angle = 50
		beam.Brightness = 2
		beam.Color = Color3.fromRGB(255, 248, 225)
		local holder = noCollide(block(cab, "HeadlightBeam", Vector3.new(0.2, 0.2, 0.2), at(faceX + 0.5, 3.4, z), COLORS.CabBlue))
		holder.Transparency = 1
		beam.Parent = holder
	end

	-- Control desk and the driver's seat.
	local desk = block(cab, "ControlDesk", Vector3.new(2.5, 3.5, 9), at(x1 - 1.9, 2.75, midZ) * CFrame.Angles(0, 0, math.rad(-12)), Color3.fromRGB(35, 38, 42), Enum.Material.Metal)
	desk.Name = "ControlDesk"
	for i, color in { Color3.fromRGB(60, 220, 90), Color3.fromRGB(240, 70, 60), Color3.fromRGB(250, 200, 40), Color3.fromRGB(70, 160, 255) } do
		noCollide(block(cab, "Button", Vector3.new(0.3, 0.3, 0.6), at(x1 - 2.9, 4.65, midZ - 3 + i * 1.2), color, Enum.Material.Neon))
	end
	noCollide(block(cab, "Throttle", Vector3.new(0.25, 1.4, 0.25), at(x1 - 3.1, 5.1, midZ + 2.8) * CFrame.Angles(0, 0, math.rad(20)), Color3.fromRGB(20, 20, 22), Enum.Material.Metal))
	block(cab, "DriverSeat", Vector3.new(2, 2, 2), at(x1 - 6, 2, midZ), Color3.fromRGB(60, 70, 90), Enum.Material.Fabric)
	block(cab, "DriverSeatBack", Vector3.new(0.4, 3, 2), at(x1 - 7.2, 4.5, midZ), Color3.fromRGB(60, 70, 90), Enum.Material.Fabric)
	Build.ceilingLight(cab, "CabLight", Vector3.new(4, 0.15, 2), at(x1 - 8, CAR.RoofBottom - 0.2, midZ), Color3.fromRGB(235, 240, 255), 0.9, 12)

	-- The driver faces the way the train goes (+X).
	refs.Driver = Npc.create("Driver", "Sit", at(x1 - 6, 3, midZ) * CFrame.Angles(0, -math.pi / 2, 0), Color3.fromRGB(25, 45, 85), NpcOutfits.Driver)
	refs.Driver.Parent = cab
	refs.Cab = cab
end

-- Rubber gangways between cars.
local function gangways(map: Folder)
	for _, x in { -21, 21, 63 } do
		block(map, "Gangway", Vector3.new(2, 9, 5), at(x, 6, 17.75), Color3.fromRGB(30, 30, 32), Enum.Material.Rubber)
	end
end

-- ===== Platform furniture =====

-- A row of three metal seats. The middle seat is the PrimaryPart (anomalies turn the bench around
-- it, and seated passengers sit on it).
local function seatRow(station: Folder, refs, x: number): Model
	local bench = Instance.new("Model")
	bench.Name = "Bench"
	local middle = nil
	for i = -1, 1 do
		local seat = block(bench, "Seat", Vector3.new(1.8, 0.4, 1.7), at(x + i * 2, 2.8, -8.2), COLORS.SeatShell)
		gloomy(refs, seat, COLORS.GloomSeat)
		gloomy(refs, block(bench, "SeatBack", Vector3.new(1.8, 1.8, 0.3), at(x + i * 2, 3.95, -9.05), COLORS.SeatShell), COLORS.GloomSeat)
		if i == 0 then
			middle = seat
		end
	end
	block(bench, "Frame", Vector3.new(6.4, 0.3, 0.6), at(x, 2.45, -8.5), COLORS.Metal, Enum.Material.Metal)
	for _, dx in { -3, 3 } do
		block(bench, "Leg", Vector3.new(0.3, 1.3, 1.2), at(x + dx, 1.65, -8.4), COLORS.Metal, Enum.Material.Metal)
	end
	bench.PrimaryPart = middle
	bench.Parent = station
	return bench
end

local function buildStation(map: Folder, refs, language: string)
	local station = Instance.new("Folder")
	station.Name = "Station"
	station.Parent = map

	-- Two-tone pillars down the middle of the platform, spaced out to keep it open.
	refs.Pillars = {}
	for x = -80, 80, 40 do
		local pillar = Instance.new("Model")
		pillar.Name = "Pillar"
		block(pillar, "Core", Vector3.new(2, 15, 2), at(x, 8.5, 1), COLORS.Pillar, Enum.Material.SmoothPlastic)
		gloomy(refs, block(pillar, "Band", Vector3.new(2.3, 8, 2.3), at(x, 9, 1), COLORS.PillarBand, Enum.Material.SmoothPlastic), COLORS.GloomPillar)
		block(pillar, "Base", Vector3.new(2.6, 0.6, 2.6), at(x, 1.3, 1), Color3.fromRGB(150, 152, 156), Enum.Material.Metal)
		pillar:SetAttribute("X", x)
		pillar.Parent = station
		table.insert(refs.Pillars, pillar)
	end

	-- Wide ceiling light panels between the beams, plus a second row over the platform edge. In the
	-- dark half of the game some of them die ("DiesInHorror"), which leaves pools of darkness.
	local diesInHorror = { [-70] = true, [-30] = true, [50] = true, [90] = true }
	for x = -90, 90, 20 do
		local fixture = Build.ceilingLight(station, "Light", Vector3.new(8, 0.2, 2.5), at(x, 15.9, 0), COLORS.Light, 1.8, 20)
		fixture:SetAttribute("DiesInHorror", diesInHorror[x] == true)
		table.insert(refs.Lights, fixture)
	end
	for _, x in { -70, -30, 10, 50 } do
		local fixture = Build.ceilingLight(station, "Light", Vector3.new(8, 0.2, 1.5), at(x, 15.9, 7), COLORS.Light, 1.8, 20)
		fixture:SetAttribute("DiesInHorror", true)
		table.insert(refs.Lights, fixture)
	end

	-- Seat rows against the back wall, facing the track.
	local busyBenches = { [-70] = true, [-30] = true, [-10] = true, [30] = true }
	refs.Benches = {}
	for x = -70, 70, 20 do
		local bench = seatRow(station, refs, x)
		bench:SetAttribute("Free", not busyBenches[x])
		table.insert(refs.Benches, bench)
	end

	-- Station name and line badge.
	local nameSign = block(station, "StationSign", Vector3.new(16, 3, 0.3), at(0, 11, -9.85), Color3.fromRGB(20, 45, 95))
	refs.StationName = surfaceText(nameSign, Enum.NormalId.Back, Strings.get(language, "StationName"), { TextColor = Color3.fromRGB(240, 240, 240) })
	local badge = block(station, "LineBadge", Vector3.new(3, 3, 0.3), at(10, 11, -9.85), COLORS.Edge)
	refs.LineBadge = surfaceText(badge, Enum.NormalId.Back, "14", { TextColor = COLORS.Dark })

	-- Digital clock. The game loop ticks it unless its "Frozen" attribute is set.
	refs.Clock = block(station, "Clock", Vector3.new(3.4, 1.4, 0.3), at(-10, 11, -9.85), COLORS.Dark)
	refs.ClockLabel = surfaceText(refs.Clock, Enum.NormalId.Back, "23:57:00", {
		TextColor = Color3.fromRGB(255, 50, 40),
		Glow = true,
	})

	-- Hanging counter sign, readable when stepping out of the car.
	local counter = block(station, "CounterSign", Vector3.new(7, 2.6, 0.3), at(0, 13.5, 7), COLORS.Dark)
	block(station, "CounterHanger", Vector3.new(0.2, 1.7, 0.2), at(0, 15.15, 7), COLORS.Dark, Enum.Material.Metal)
	refs.CounterLabel = surfaceText(counter, Enum.NormalId.Back, "", { TextColor = COLORS.Edge, Glow = true })

	-- Advertisements on the back wall.
	refs.Posters = {}
	local texts = Strings.get(language, "Posters")
	for i, x in { -80, -40, -20, 20, 40, 60, 80 } do
		local color = POSTER_COLORS[i]
		block(station, "PosterFrame", Vector3.new(5.6, 7.6, 0.15), at(x, 7.5, -9.95), COLORS.Metal, Enum.Material.Metal)
		local poster = block(station, "Poster", Vector3.new(5, 7, 0.2), at(x, 7.5, -9.9), color)
		table.insert(refs.Posters, surfaceText(poster, Enum.NormalId.Back, texts[i], { Background = color }))
	end

	-- A vending machine.
	local vending = block(station, "VendingMachine", Vector3.new(4, 7, 2.5), at(-60, 4.5, -8.6), Color3.fromRGB(180, 30, 35), Enum.Material.Metal)
	local panel = block(station, "VendingPanel", Vector3.new(3, 4, 0.1), at(-60, 5.2, -7.3), Color3.fromRGB(200, 220, 255), Enum.Material.Neon)
	surfaceText(panel, Enum.NormalId.Back, Strings.get(language, "Vending"), {
		Background = Color3.fromRGB(190, 210, 245),
		TextColor = Color3.fromRGB(150, 25, 30),
		Glow = true,
	})
	local vendingLight = Instance.new("PointLight")
	vendingLight.Color = Color3.fromRGB(190, 210, 255)
	vendingLight.Range = 10
	vendingLight.Brightness = 0.7
	vendingLight.Parent = vending

	-- Trash bins: upright cylinders (a cylinder's axis is its X, so turn it to stand up).
	for _, x in { -44, 44 } do
		local bin = block(station, "TrashBin", Vector3.new(2.4, 1.6, 1.6), at(x, 2.2, -9) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(40, 70, 130), Enum.Material.Metal)
		gloomy(refs, bin, Color3.fromRGB(45, 50, 55))
		bin.Shape = Enum.PartType.Cylinder
	end

	-- Passengers. The game never says who they are.
	-- Always the same six people, each in the same spot.
	local flip = CFrame.Angles(0, math.pi, 0)
	local outfits = NpcOutfits.Passengers
	refs.Passengers = {
		Npc.create("Passenger", "Sit", at(-30, 3, -8.1) * flip, Color3.fromRGB(40, 55, 90), outfits[1]),
		Npc.create("Passenger", "Sit", at(30, 3, -8.1) * flip, Color3.fromRGB(110, 75, 50), outfits[2]),
		Npc.create("Passenger", "Sit", at(-70, 3, -8.1) * flip, Color3.fromRGB(60, 60, 60), outfits[3]),
		Npc.create("Passenger", "Stand", at(-5, 3, -3) * flip, Color3.fromRGB(95, 95, 100), outfits[4]),
		Npc.create("Passenger", "Stand", at(62, 3, 6) * flip, Color3.fromRGB(70, 40, 60), outfits[5]),
		Npc.create("Passenger", "Sit", at(-2, 2.9, 22.4), Color3.fromRGB(120, 40, 45), outfits[6]),
	}
	for _, passenger in refs.Passengers do
		passenger.Parent = station
	end

	-- Hints at the twist. They only show up once the dark half begins (see GameLoop), and nobody
	-- gets them the first time.
	local newspaper = block(station, "Newspaper", Vector3.new(1.6, 0.05, 1.3), at(-12, 3.03, -8.2), Color3.fromRGB(225, 222, 210))
	refs.NewspaperLabel = surfaceText(newspaper, Enum.NormalId.Top, Strings.get(language, "Newspaper", Strings.tomorrow(language)), {
		Background = Color3.fromRGB(225, 222, 210),
		TextColor = COLORS.Dark,
		PixelsPerStud = 80,
	})

	local flowers = Instance.new("Model")
	flowers.Name = "Flowers"
	for i, color in { Color3.fromRGB(180, 25, 35), Color3.fromRGB(235, 235, 230), Color3.fromRGB(180, 25, 35) } do
		local offset = (i - 2) * 0.35
		local base = at(2 + offset, 1.1, 2.8) * CFrame.Angles(0, math.rad(20 * (i - 2)), 0)
		block(flowers, "Stem", Vector3.new(0.12, 0.12, 1.6), base, Color3.fromRGB(45, 95, 45))
		local bloom = block(flowers, "Bloom", Vector3.new(0.45, 0.45, 0.45), base * CFrame.new(0, 0.1, -0.85), color)
		bloom.Shape = Enum.PartType.Ball
	end
	flowers.Parent = station

	local phone = block(station, "Phone", Vector3.new(0.7, 0.06, 1.2), at(34, 1.03, 4) * CFrame.Angles(0, math.rad(25), 0), COLORS.Dark)
	refs.PhoneLabel = surfaceText(phone, Enum.NormalId.Top, Strings.get(language, "MissedCalls", 12), {
		Background = Color3.fromRGB(10, 10, 14),
		TextColor = Color3.fromRGB(230, 230, 235),
		Glow = true,
		PixelsPerStud = 90,
	})
	local glow = Instance.new("PointLight")
	glow.Range = 5
	glow.Brightness = 0.8
	glow.Color = Color3.fromRGB(200, 220, 255)
	glow.Parent = phone

	refs.Hints = { newspaper, flowers, phone }
	refs.Station = station
end

-- Builds one station at stationOrigin into Workspace and returns the references the game loop and
-- anomalies use. refs.At(x, y, z) converts layout coordinates of this station to world space.
-- withSpawn adds a spawn point in the train, for game servers that have no lobby.
function MapBuilder.build(stationOrigin: CFrame, name: string, language: string, withSpawn: boolean?)
	origin = stationOrigin

	local existing = Workspace:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end

	local map = Instance.new("Folder")
	map.Name = name

	local refs: any = {
		Map = map,
		Origin = stationOrigin,
		Language = language,
		Lights = {},
		Gloomy = {},
		At = function(x: number, y: number, z: number): CFrame
			return stationOrigin * CFrame.new(x, y, z)
		end,
	}

	buildShell(map)
	refs.Doors = {
		Continue = buildExitDoor(map, "Continue", language),
		Back = buildExitDoor(map, "Back", language),
	}
	buildClosedCar(map, refs, -62, -22)
	buildClosedCar(map, refs, 22, 62)
	buildCab(map, refs)
	gangways(map)
	refs.Car, refs.DoorPanels, refs.StandPoints = buildCar(map, language)
	buildStation(map, refs, language)

	if withSpawn then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "TrainSpawn"
		spawn.Size = Vector3.new(16, 0.1, 3)
		spawn.CFrame = at(0, 1.05, 17.25)
		spawn.Anchored = true
		spawn.CanCollide = false
		spawn.Transparency = 1
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Parent = refs.Car
	end

	map.Parent = Workspace
	return refs
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Npc</string>
          <string name="Source"><![CDATA[-- NPCs. Each one appears straight away as a block mannequin, then (if Config.AvatarNpcs is on)
-- swaps to its fixed outfit from NpcOutfits once the avatar loads, so the same people show up in
-- every game and in the lobby. If the avatar does not load, the mannequin stays.
--
-- The returned Model is the passenger for good: anomalies can hide it or look inside it for
-- "Head", whichever body it ends up with.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Mannequin = require(script.Parent.Mannequin)

-- Roblox's default R15 sit animation.
local SIT_ANIMATION = "rbxassetid://2506281703"

local COLOR_FIELDS = { "HeadColor", "TorsoColor", "LeftArmColor", "RightArmColor", "LeftLegColor", "RightLegColor" }

local Npc = {}

-- A HumanoidDescription for an outfit from NpcOutfits. An outfit with LiveUserId wears that
-- account's current avatar, and falls back to the saved fields if it cannot be loaded.
local function describe(outfit): HumanoidDescription?
	if outfit.LiveUserId then
		local ok, live = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(outfit.LiveUserId)
		end)
		if ok and live then
			return live
		end
	end

	-- Each field on its own, so one missing item does not cost the whole outfit.
	local description = Instance.new("HumanoidDescription")
	for key, value in outfit do
		if key == "LiveUserId" then
			continue
		end
		local ok, err = pcall(function()
			(description :: any)[key] = if table.find(COLOR_FIELDS, key) then Color3.fromHex(value) else value
		end)
		if not ok then
			warn("[EndlessSubway] outfit field", key, "failed:", err)
		end
	end
	return description
end

local function waitUntilInWorld(model: Model): boolean
	local deadline = os.clock() + 30
	while not model:IsDescendantOf(Workspace) do
		if os.clock() > deadline then
			return false
		end
		task.wait(0.5)
	end
	return true
end

local function loadAvatar(container: Model, pose: "Stand" | "Sit", pivot: CFrame, outfit)
	local description = describe(outfit)
	if not description then
		return
	end

	local ok, avatar = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not avatar or not waitUntilInWorld(container) then
		return
	end

	local humanoid = avatar:FindFirstChildOfClass("Humanoid")
	local root = avatar:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		avatar:Destroy()
		return
	end

	avatar.Name = "Avatar"
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	for _, descendant in avatar:GetDescendants() do
		if descendant:IsA("BaseScript") then
			descendant:Destroy()
		end
	end

	container:ClearAllChildren()

	if pose == "Stand" then
		-- The mannequin pivot sits 2 studs above the floor.
		local floor = pivot * CFrame.new(0, -2, 0)
		root.Anchored = true
		avatar:PivotTo(floor * CFrame.new(0, humanoid.HipHeight + root.Size.Y / 2, 0))
		avatar.Parent = container
		return
	end

	-- Sitting: let a hidden Seat place the body, then play the sit pose.
	local seat = Instance.new("Seat")
	seat.Name = "NpcSeat"
	seat.Size = Vector3.new(2, 0.2, 2)
	seat.CFrame = pivot * CFrame.new(0, -0.1, 0)
	seat.Anchored = true
	seat.CanCollide = false
	seat.Transparency = 1
	seat.Parent = container

	avatar:PivotTo(pivot * CFrame.new(0, 3, 0))
	avatar.Parent = container
	seat:Sit(humanoid)

	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = humanoid
	local animation = Instance.new("Animation")
	animation.AnimationId = SIT_ANIMATION
	local played = pcall(function()
		local track = animator:LoadAnimation(animation)
		track.Looped = true
		track:Play(0)
	end)
	if not played then
		warn("[EndlessSubway] could not play the sit animation for a passenger")
	end
end

-- pose: "Stand" (pivot 2 studs above the floor) or "Sit" (pivot on the seat surface),
-- facing the pivot's LookVector. outfit: an entry of NpcOutfits (nil keeps the mannequin).
function Npc.create(name: string, pose: "Stand" | "Sit", pivot: CFrame, clothes: Color3, outfit: any?): Model
	local container = Mannequin.create(name, pose, pivot, clothes)
	if Config.AvatarNpcs and outfit then
		task.spawn(loadAvatar, container, pose, pivot, outfit)
	end
	return container
end

return Npc
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">NpcOutfits</string>
          <string name="Source"><![CDATA[-- Fixed looks for the NPCs: the same people in every game and in the lobby.
